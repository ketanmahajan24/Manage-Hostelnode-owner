<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reset Password | HostelNode</title>
 
    <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-3J9E7QW77B"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-3J9E7QW77B');
</script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}

body{
  font-family:'Inter',sans-serif;
  background: linear-gradient(135deg, #09B850, #0f172a);
  height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

/* animated bg */
body::before{
  content:"";
  position:absolute;
  width:200%;
  height:200%;
  background: radial-gradient(circle, rgba(255,255,255,0.05) 10%, transparent 10%);
  background-size:70px 70px;
  animation:move 30s linear infinite;
}

@keyframes move{
  0%{transform:translate(0,0);}
  50%{transform:translate(-100px,-120px);}
  100%{transform:translate(0,0);}
}

/* wrapper */
.login-wrapper{
  width:100%;
  max-width:420px;
  backdrop-filter:blur(20px);
  border-radius:22px;
  overflow:hidden;
  box-shadow:0 25px 70px rgba(0,0,0,0.35);
}

/* logo */
.logo{
  text-align:center;
  margin:25px 0;
}
.logo img{
  height:90px;
}

/* card */
.card-login{
  background:rgba(255,255,255,0.95);
  padding:40px 30px;
  border-radius:22px;
}

/* title */
.login-title{
  text-align:center;
  font-size:26px;
  font-weight:700;
  color:#09B850;
}
.login-sub{
  text-align:center;
  font-size:14px;
  color:#64748B;
  margin-bottom:25px;
}

/* inputs */
.form-control{
  width:100%;
  padding:12px;
  border-radius:12px;
  border:1px solid #CBD5E1;
  margin-top:6px;
}

.form-control:focus{
  border-color:#09B850;
  box-shadow:0 0 0 3px rgba(9,184,80,0.2);
  outline:none;
}

/* password */
.password-container{
  position:relative;
}
.eye-icon{
  position:absolute;
  right:12px;
  top:38px;
  cursor:pointer;
  color:#94A3B8;
}

/* strength bar */
.strength{
  height:6px;
  border-radius:10px;
  margin-top:6px;
  background:#e2e8f0;
  overflow:hidden;
}
.strength span{
  display:block;
  height:100%;
  width:0%;
  transition:.3s;
}

/* button */
.btn-login{
  width:100%;
  margin-top:18px;
  padding:12px;
  border:none;
  border-radius:12px;
  font-weight:600;
  color:white;
  background:linear-gradient(135deg,#09B850,#22C55E);
}

/* alert */
.custom-alert{
  display:flex;
  align-items:center;
  gap:10px;
  padding:12px;
  margin-bottom:12px;
  border-radius:10px;
  background:#fee2e2;
  color:#dc2626;
  font-size:14px;
}

.success-alert{
  background:#dcfce7;
  color:#16a34a;
}

/* link */
.signup-link{
  text-align:center;
  margin-top:12px;
}
.signup-link a{
  color:#09B850;
  text-decoration:none;
}
</style>
</head>

<body>

<div class="login-wrapper">

  <div class="logo">
    <img src="/images/hostelnode-logo-cutout.png">
  </div>

  <div class="card-login">

    <% if (typeof error !== 'undefined') { %>
      <div class="custom-alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (typeof message !== 'undefined') { %>
      <div class="custom-alert success-alert">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= message %></span>
      </div>
    <% } %>

    <div class="login-title">Reset Password 🔐</div>
    <div class="login-sub">Create a new secure password</div>

    <form method="POST" action="/user/reset-password/<%= token %>" onsubmit="return validatePasswords()">

      <!-- New Password -->
      <div class="password-container">
        <label>New Password</label>
        <input type="password" id="password" name="password" class="form-control" required>
        <i class="fa-solid fa-eye eye-icon" onclick="togglePass('password', this)"></i>

        <div class="strength">
          <span id="strengthBar"></span>
        </div>
      </div>

      <!-- Confirm Password -->
      <div class="password-container" style="margin-top:12px;">
        <label>Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
        <i class="fa-solid fa-eye eye-icon" onclick="togglePass('confirmPassword', this)"></i>
      </div>

      <div id="matchError" style="color:red; font-size:13px; margin-top:6px;"></div>

      <button class="btn-login">Update Password</button>

    </form>

    <div class="signup-link">
      Back to <a href="/login">Login</a>
    </div>

  </div>

</div>

<script>
const password = document.getElementById("password");
const bar = document.getElementById("strengthBar");

/* toggle */
function togglePass(id, icon){
  const input = document.getElementById(id);
  input.type = input.type === "password" ? "text" : "password";
  icon.classList.toggle("fa-eye-slash");
}

/* strength */
password.addEventListener("input", () => {
  let val = password.value;
  let strength = 0;

  if (val.length > 5) strength++;
  if (/[A-Z]/.test(val)) strength++;
  if (/[0-9]/.test(val)) strength++;
  if (/[^A-Za-z0-9]/.test(val)) strength++;

  const width = ["0%","25%","50%","75%","100%"];
  const colors = ["#ef4444","#f97316","#eab308","#22c55e","#16a34a"];

  bar.style.width = width[strength];
  bar.style.background = colors[strength];
});

/* match validation */
function validatePasswords(){
  const pass = document.getElementById("password").value;
  const confirm = document.getElementById("confirmPassword").value;
  const error = document.getElementById("matchError");

  if(pass !== confirm){
    error.innerText = "Passwords do not match ❌";
    return false;
  }

  return true;
}
</script>

</body>
</html>