<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HostelNode | Owner Portal</title>

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>
/* ============================================================
   SHARED / ROOT
============================================================ */
:root {
  --g:       #09B850;
  --g-dark:  #078040;
  --g-light: #e8f9ef;
  --ink:     #0f1117;
  --muted:   #64748b;
  --border:  #e2e8f0;
  --white:   #ffffff;
  --font-d:  'Syne', sans-serif;
  --font-b:  'DM Sans', sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body { height: 100%; }

body {
  font-family: var(--font-b);
  min-height: 100vh;
  background: linear-gradient(135deg, #0a1f12 0%, #09B850 50%, #0a1f12 100%);
  position: relative;
  overflow-x: hidden;
}
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.04) 1.5px, transparent 1.5px);
  background-size: 32px 32px;
  pointer-events: none;
  z-index: 0;
}
body::after {
  content: '';
  position: fixed;
  width: 500px; height: 500px; border-radius: 50%;
  background: radial-gradient(circle, rgba(9,184,80,0.25) 0%, transparent 70%);
  top: -120px; left: -120px; pointer-events: none;
  z-index: 0;
}

.stage {
  position: fixed; inset: 0;
  overflow: hidden;
}

/* generic slide layer behaviour */
.layer {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.55s cubic-bezier(.22,.68,0,1), opacity 0.4s ease;
  will-change: transform, opacity;
}

/* ── STATE: welcome (default) ── */
body[data-state="welcome"] .layer-welcome { transform: translateX(0); opacity: 1; pointer-events: auto; z-index: 3; }
body[data-state="welcome"] .layer-login   { transform: translateX(100%); opacity: 0; pointer-events: none; z-index: 1; }
body[data-state="welcome"] .layer-signup  { transform: translateX(100%); opacity: 0; pointer-events: none; z-index: 1; }

/* ── STATE: login ── */
body[data-state="login"] .layer-welcome { transform: translateX(-100%); opacity: 0; pointer-events: none; z-index: 1; }
body[data-state="login"] .layer-login   { transform: translateX(0); opacity: 1; pointer-events: auto; z-index: 3; }
body[data-state="login"] .layer-signup  { transform: translateX(100%); opacity: 0; pointer-events: none; z-index: 1; }

/* ── STATE: signup ── */
body[data-state="signup"] .layer-welcome { transform: translateX(-100%); opacity: 0; pointer-events: none; z-index: 1; }
body[data-state="signup"] .layer-signup  { transform: translateX(0); opacity: 1; pointer-events: auto; z-index: 3; }
body[data-state="signup"] .layer-login   { transform: translateX(100%); opacity: 0; pointer-events: none; z-index: 1; }

.back-btn {
  position: absolute; top: 22px; left: 22px; z-index: 10;
  width: 40px; height: 40px; border-radius: 50%;
  background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25);
  color: #fff; display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: 0.9rem; transition: all 0.2s; backdrop-filter: blur(6px);
}
.back-btn:hover { background: rgba(255,255,255,0.28); transform: translateX(-2px); }
.layer-signup .back-btn { color: var(--ink); background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.08); }
.layer-signup .back-btn:hover { background: rgba(0,0,0,0.12); }

/* ============================================================
   WELCOME LAYER
============================================================ */
.welcome-card {
  position: relative; z-index: 1;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 48px 42px;
  width: 100%; max-width: 460px; margin: 20px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.1);
  text-align: center;
  animation: cardIn 0.6s cubic-bezier(.22,.68,0,1.2) both;
}
@keyframes cardIn {
  from { opacity:0; transform:translateY(28px) scale(0.97); }
  to   { opacity:1; transform:none; }
}
.w-brand { display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 22px; }
.w-brand img { height: 48px; }
.w-brand span { font-family: var(--font-d); font-size: 1.3rem; font-weight: 800; color: var(--ink); }

.w-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--g-light); border: 1px solid #a8e6bf;
  padding: 5px 14px; border-radius: 999px;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--g-dark); margin-bottom: 16px;
}

.w-heading {
  font-family: var(--font-d); font-size: 1.7rem; font-weight: 800;
  color: var(--ink); letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 12px;
}
.w-heading em { font-style: normal; color: var(--g); }

.w-about {
  font-size: 0.87rem; color: var(--muted); line-height: 1.65;
  max-width: 380px; margin: 0 auto 30px;
}

.w-actions { display: flex; flex-direction: column; gap: 12px; }
.w-btn {
  width: 100%; padding: 16px 20px;
  border-radius: 14px; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  font-family: var(--font-d); font-size: 0.98rem; font-weight: 700;
  transition: all 0.2s;
}
.w-btn-primary {
  background: linear-gradient(135deg, var(--g), #22c55e);
  color: #fff; box-shadow: 0 6px 20px rgba(9,184,80,0.32);
}
.w-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(9,184,80,0.4); }
.w-btn-secondary {
  background: #fff7ed; color: #92400e; border: 1.5px solid #fde68a;
}
.w-btn-secondary:hover { background: #fef3c7; transform: translateY(-2px); }

.w-foot { margin-top: 22px; font-size: 0.72rem; color: #94a3b8; }

/* ============================================================
   LOGIN LAYER
============================================================ */
.layer-login .login-card {
  position: relative; z-index: 1;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 44px 40px;
  width: 100%; max-width: 440px; margin: 20px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.1);
}

.layer-login .brand { display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 24px; }
.layer-login .brand img { height: 44px; }
.layer-login .brand span { font-family: var(--font-d); font-size: 1.2rem; font-weight: 800; color: var(--ink); }

.layer-login .owner-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: #fef3c7; border: 1px solid #fde68a;
  padding: 5px 14px; border-radius: 999px;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase; color: #92400e; margin-bottom: 14px;
}
.layer-login .owner-badge i { color: #f59e0b; }

.layer-login .card-title { font-family: var(--font-d); font-size: 1.55rem; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 4px; }
.layer-login .card-sub   { font-size: 0.83rem; color: var(--muted); margin-bottom: 26px; line-height: 1.5; }

.layer-login .role-tabs {
  display: flex; background: #f1f5f9; border-radius: 12px;
  padding: 4px; gap: 4px; margin-bottom: 22px;
}
.layer-login .role-tab-input { display: none; }
.layer-login .role-tab-label {
  flex: 1; text-align: center; padding: 9px 8px;
  border-radius: 9px; font-size: 0.78rem; font-weight: 600;
  color: var(--muted); cursor: pointer; transition: all .2s;
  font-family: var(--font-b);
}
.layer-login .role-tab-label:hover { color: var(--ink); }
.layer-login .role-tab-input:checked + .role-tab-label {
  background: white; color: var(--g);
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.layer-login .input-group { margin-bottom: 14px; }
.layer-login .input-label { font-size: 0.78rem; font-weight: 600; color: var(--muted); display: block; margin-bottom: 5px; }

.layer-login .hn-input {
  width: 100%; padding: 12px 14px;
  border: 1.5px solid var(--border); border-radius: 12px;
  font-family: var(--font-b); font-size: 0.88rem; color: var(--ink);
  background: #f8fafc; outline: none; transition: all 0.2s;
}
.layer-login .hn-input:hover { border-color: #94a3b8; }
.layer-login .hn-input:focus { border-color: var(--g); box-shadow: 0 0 0 3px rgba(9,184,80,0.12); background: #fff; }
.layer-login .hn-input::placeholder { color: #94a3b8; }

.layer-login .pass-wrap { position: relative; }
.layer-login .pass-wrap .hn-input { padding-right: 44px; }
.layer-login .pass-eye {
  position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
  color: #94a3b8; cursor: pointer; font-size: 0.9rem; transition: color .18s;
}
.layer-login .pass-eye:hover { color: var(--g); }

.layer-login .forgot-link {
  display: block; text-align: right; margin-top: 6px;
  font-size: 0.75rem; color: var(--muted); text-decoration: none; font-weight: 600;
}
.layer-login .forgot-link:hover { color: var(--g); }

.layer-login .btn-main {
  width: 100%; padding: 14px;
  border: none; border-radius: 12px;
  background: linear-gradient(135deg, var(--g), #22c55e);
  color: #fff; font-family: var(--font-d); font-size: 0.95rem; font-weight: 700;
  cursor: pointer; transition: all 0.2s; margin-top: 8px;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(9,184,80,0.3);
}
.layer-login .btn-main:hover { transform: translateY(-1px); box-shadow: 0 8px 28px rgba(9,184,80,0.38); }
.layer-login .btn-main:active { transform: scale(0.98); }

.layer-login .alert {
  padding: 10px 14px; border-radius: 10px; margin-bottom: 16px;
  font-size: 0.8rem; font-weight: 500;
  display: flex; align-items: center; gap: 7px;
  animation: shake 0.35s ease;
}
.layer-login .alert.error   { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; }
.layer-login .alert.success { background: var(--g-light); border: 1px solid #a8e6bf; color: #065f46; }
@keyframes shake {
  0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)}
}

.layer-login .links-row { text-align: center; margin-top: 18px; font-size: 0.82rem; color: var(--muted); }
.layer-login .links-row a, .layer-login .links-row span.fake-link { color: var(--g); font-weight: 600; text-decoration: none; cursor: pointer; }
.layer-login .links-row a:hover, .layer-login .links-row span.fake-link:hover { text-decoration: underline; }

.layer-login .student-note {
  margin-top: 16px; padding: 11px 14px;
  background: #f8fafc; border: 1px solid var(--border);
  border-radius: 10px; text-align: center;
  font-size: 0.77rem; color: var(--muted);
}
.layer-login .student-note a { color: var(--ink); font-weight: 600; text-decoration: none; }
.layer-login .student-note a:hover { color: var(--g); }

/* ============================================================
   SIGNUP LAYER
============================================================ */
.layer-signup { background: var(--white); }

.layer-signup .signup-inner { width: 100%; height: 100%; display: flex; }

.layer-signup .left-panel {
  display: none;
  width: 44%;
  background: linear-gradient(145deg, #f59e0b 0%, #92400e 60%, #0a0f0a 100%);
  position: relative; overflow: hidden;
  padding: 60px 48px;
  flex-direction: column; justify-content: space-between;
}
@media (min-width: 900px) { .layer-signup .left-panel { display: flex; } }

.layer-signup .left-panel::before {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
  background-size: 30px 30px; pointer-events: none;
}
.layer-signup .left-panel::after {
  content: '';
  position: absolute; width: 300px; height: 300px; border-radius: 50%;
  background: rgba(255,255,255,0.05);
  bottom: -80px; right: -80px;
}

.layer-signup .lp-brand { display: flex; align-items: center; gap: 12px; position: relative; z-index: 1; }
.layer-signup .lp-brand img { height: 44px; filter: brightness(0) invert(1); }
.layer-signup .lp-brand span { font-family: var(--font-d); font-size: 1.4rem; font-weight: 800; color: #fff; }

.layer-signup .lp-content { position: relative; z-index: 1; }
.layer-signup .lp-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25);
  padding: 5px 14px; border-radius: 999px;
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em;
  text-transform: uppercase; color: rgba(255,255,255,0.85); margin-bottom: 20px;
}
.layer-signup .lp-tag .dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: pulse 2s ease infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.3;transform:scale(1.6)} }

.layer-signup .lp-heading {
  font-family: var(--font-d);
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 800; color: #fff; line-height: 1.1;
  letter-spacing: -0.02em; margin-bottom: 18px;
}
.layer-signup .lp-heading em { font-style: normal; opacity: 0.6; }
.layer-signup .lp-sub { font-size: 0.92rem; color: rgba(255,255,255,0.65); line-height: 1.75; max-width: 340px; }

.layer-signup .lp-perks { display: flex; flex-direction: column; gap: 12px; margin-top: 32px; }
.layer-signup .lp-perk {
  display: flex; align-items: center; gap: 12px;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px; padding: 12px 16px;
}
.layer-signup .lp-perk-icon {
  width: 36px; height: 36px; border-radius: 9px;
  background: rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.9rem; color: #fff; flex-shrink: 0;
}
.layer-signup .lp-perk-text { font-size: 0.82rem; color: rgba(255,255,255,0.8); font-weight: 500; line-height: 1.4; }
.layer-signup .lp-perk-text strong { color: #fff; display: block; }
.layer-signup .lp-bottom { position: relative; z-index: 1; font-size: 0.72rem; color: rgba(255,255,255,0.3); }

.layer-signup .right-panel {
  flex: 1; display: flex; align-items: center; justify-content: center;
  padding: 32px 24px; background: var(--white); overflow-y: auto;
}

.layer-signup .signup-box { width: 100%; max-width: 460px; padding: 8px 0 40px; }

.layer-signup .mobile-brand {
  display: flex; align-items: center; gap: 10px;
  justify-content: center; margin-bottom: 24px;
}
.layer-signup .mobile-brand img { height: 40px; }
.layer-signup .mobile-brand span { font-family: var(--font-d); font-size: 1.2rem; font-weight: 800; color: var(--ink); }
@media (min-width: 900px) { .layer-signup .mobile-brand { display: none; } }

.layer-signup .sb-title { font-family: var(--font-d); font-size: 1.6rem; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 4px; }
.layer-signup .sb-sub   { font-size: 0.84rem; color: var(--muted); margin-bottom: 28px; }

.layer-signup .input-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
.layer-signup .input-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.layer-signup .input-label { font-size: 0.78rem; font-weight: 600; color: var(--muted); }

.layer-signup .hn-input {
  width: 100%; padding: 12px 14px;
  border: 1.5px solid var(--border); border-radius: 12px;
  font-family: var(--font-b); font-size: 0.88rem; color: var(--ink);
  background: #f8fafc; outline: none;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}
.layer-signup .hn-input:hover  { border-color: #94a3b8; }
.layer-signup .hn-input:focus  { border-color: var(--g); box-shadow: 0 0 0 3px rgba(9,184,80,0.12); background: #fff; }
.layer-signup .hn-input::placeholder { color: #94a3b8; }
.layer-signup .hn-input.error   { border-color: #ef4444 !important; box-shadow: 0 0 0 3px rgba(239,68,68,0.1) !important; }
.layer-signup .hn-input.success { border-color: var(--g) !important; box-shadow: 0 0 0 3px rgba(9,184,80,0.08) !important; }

.layer-signup .field-error {
  font-size: 0.72rem; color: #ef4444; font-weight: 500;
  display: flex; align-items: center; gap: 4px;
  animation: errIn 0.2s ease;
  min-height: 0; overflow: hidden;
}
.layer-signup .field-error.hidden { display: none; }
@keyframes errIn { from { opacity:0; transform:translateY(-4px); } to { opacity:1; transform:none; } }

.layer-signup .pw-strength { margin-top: 6px; }
.layer-signup .pw-bars { display: flex; gap: 4px; margin-bottom: 4px; }
.layer-signup .pw-bar {
  flex: 1; height: 3px; border-radius: 99px;
  background: var(--border); transition: background 0.3s;
}
.layer-signup .pw-bar.weak   { background: #ef4444; }
.layer-signup .pw-bar.fair   { background: #f59e0b; }
.layer-signup .pw-bar.good   { background: #3b82f6; }
.layer-signup .pw-bar.strong { background: var(--g); }
.layer-signup .pw-label { font-size: 0.7rem; font-weight: 600; color: var(--muted); }

.layer-signup .pass-wrap { position: relative; }
.layer-signup .pass-wrap .hn-input { padding-right: 44px; }
.layer-signup .pass-eye {
  position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
  color: #94a3b8; cursor: pointer; font-size: 0.9rem; transition: color .18s;
}
.layer-signup .pass-eye:hover { color: var(--g); }

.layer-signup .photo-zone {
  border: 2px dashed var(--border); border-radius: 12px;
  padding: 16px; text-align: center; cursor: pointer;
  transition: all 0.2s; background: #f8fafc; position: relative;
  display: flex; align-items: center; gap: 14px;
}
.layer-signup .photo-zone:hover { border-color: var(--g); background: var(--g-light); }
.layer-signup .photo-zone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.layer-signup .photo-zone-icon {
  width: 44px; height: 44px; border-radius: 50%; background: var(--border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; overflow: hidden;
}
.layer-signup .photo-zone-icon img { width: 100%; height: 100%; object-fit: cover; display: none; }
.layer-signup .photo-zone-icon i  { font-size: 1.1rem; color: #94a3b8; }
.layer-signup .photo-zone-text .title { font-size: 0.84rem; font-weight: 600; color: var(--ink); }
.layer-signup .photo-zone-text .sub   { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }
.layer-signup .photo-zone.has-file { border-color: var(--g); background: var(--g-light); }
.layer-signup .photo-zone.has-file .photo-zone-icon { background: var(--g-light); }
.layer-signup .photo-zone.has-file .photo-zone-icon i { color: var(--g); }

.layer-signup .form-divider {
  font-size: 0.7rem; font-weight: 700; color: var(--muted);
  text-transform: uppercase; letter-spacing: 0.08em;
  margin: 20px 0 14px; display: flex; align-items: center; gap: 8px;
}
.layer-signup .form-divider::before, .layer-signup .form-divider::after {
  content: ''; flex: 1; height: 1px; background: var(--border);
}

.layer-signup .phone-row { display: flex; gap: 10px; }
.layer-signup .phone-row .hn-input { flex: 1; }
.layer-signup .btn-otp {
  height: 46px; padding: 0 16px; white-space: nowrap;
  border: none; border-radius: 12px;
  background: var(--g); color: #fff;
  font-family: var(--font-d); font-size: 0.8rem; font-weight: 700;
  cursor: pointer; transition: all 0.2s; flex-shrink: 0;
}
.layer-signup .btn-otp:hover    { background: var(--g-dark); }
.layer-signup .btn-otp:disabled { background: #94a3b8; cursor: not-allowed; }

.layer-signup .otp-row { display: flex; gap: 10px; margin-top: 10px; }
.layer-signup .otp-input {
  width: 52px; height: 52px; text-align: center;
  font-family: var(--font-d); font-size: 1.3rem; font-weight: 700;
  border: 2px solid var(--border); border-radius: 12px;
  outline: none; transition: border-color 0.2s, box-shadow 0.2s;
  background: #f8fafc; color: var(--ink);
}
.layer-signup .otp-input:focus { border-color: var(--g); box-shadow: 0 0 0 3px rgba(9,184,80,0.12); background: #fff; }
.layer-signup .otp-input.filled { border-color: var(--g); background: var(--g-light); }

.layer-signup .verify-status {
  display: flex; align-items: center; gap: 7px;
  font-size: 0.78rem; font-weight: 600; margin-top: 8px;
}
.layer-signup .verify-status.ok  { color: var(--g); }
.layer-signup .verify-status.err { color: #ef4444; }

.layer-signup .resend-row { font-size: 0.76rem; color: var(--muted); margin-top: 6px; }
.layer-signup .resend-link { color: var(--g); font-weight: 600; cursor: pointer; }
.layer-signup .resend-link:hover { text-decoration: underline; }

.layer-signup .alert-box {
  padding: 11px 14px; border-radius: 10px;
  font-size: 0.8rem; font-weight: 500; display: none; margin-bottom: 14px;
}
.layer-signup .alert-box.error   { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; display: block; }
.layer-signup .alert-box.success { background: var(--g-light); border: 1px solid #a8e6bf; color: #065f46; display: block; }

.layer-signup .btn-main {
  width: 100%; padding: 14px;
  border: none; border-radius: 12px;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff; font-family: var(--font-d); font-size: 0.95rem; font-weight: 700;
  cursor: pointer; transition: all 0.2s; margin-top: 8px;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 14px rgba(245,158,11,0.3);
}
.layer-signup .btn-main:hover    { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(245,158,11,0.38); }
.layer-signup .btn-main:active   { transform: scale(0.98); }
.layer-signup .btn-main:disabled { background: #94a3b8; box-shadow: none; cursor: not-allowed; transform: none; }

.layer-signup .hint-text { font-size: 0.74rem; color: var(--muted); margin-top: 14px; text-align: center; line-height: 1.6; }
.layer-signup .hint-text i { color: var(--g); }

.layer-signup .login-prompt { text-align: center; margin-top: 20px; font-size: 0.83rem; color: var(--muted); }
.layer-signup .login-prompt a, .layer-signup .login-prompt span.fake-link { color: var(--g); font-weight: 700; text-decoration: none; cursor: pointer; }
.layer-signup .login-prompt a:hover, .layer-signup .login-prompt span.fake-link:hover { text-decoration: underline; }

@media (max-width: 480px) {
  .welcome-card, .layer-login .login-card { padding: 28px 20px; }
  .layer-signup .right-panel { padding: 24px 16px; }
  .layer-signup .input-row { grid-template-columns: 1fr; }
  .layer-signup .otp-input { width: 44px; height: 44px; font-size: 1.1rem; }
}
</style>
</head>
<body data-state="welcome">

<div class="stage">

  <!-- ============================================================
       LAYER 1 — WELCOME
  ============================================================ -->
  <div class="layer layer-welcome">
    <div class="welcome-card">
      <div class="w-brand">
        <img src="/images/hostelnode-logo-cutout.png" alt="HostelNode">
        <span>HostelNode</span>
      </div>
      <div class="w-tag"><i class="fa-solid fa-crown"></i> Owner / Manager Portal</div>
      <div class="w-heading">Welcome to HostelNode —<br><em>grow your hostel business.</em></div>
      <div class="w-about">
        Manage rooms, members, and payments from one dashboard, and get discovered
        by thousands of students searching for a place to stay every month.
      </div>
      <div class="w-actions">
        <button type="button" class="w-btn w-btn-primary" id="btnGoLogin">
          <i class="fa-solid fa-right-to-bracket"></i> Login to my account
        </button>
        <button type="button" class="w-btn w-btn-secondary" id="btnGoSignup">
          <i class="fa-solid fa-user-plus"></i> Create a new account
        </button>
      </div>
      <div class="w-foot">© 2026 HostelNode · Built in India 🇮🇳</div>
    </div>
  </div>

  <!-- ============================================================
       LAYER 2 — LOGIN
  ============================================================ -->
  <div class="layer layer-login">
    <div class="back-btn" id="btnBackFromLogin"><i class="fa-solid fa-arrow-left"></i></div>

    <div class="login-card">

      <div class="brand">
        <img src="/images/hostelnode-logo-cutout.png" alt="HostelNode">
        <span>HostelNode</span>
      </div>

      <div class="owner-badge"><i class="fa-solid fa-crown"></i> Owner / Manager Portal</div>

      <div class="card-title">Welcome back 👋</div>
      <div class="card-sub">Sign in to manage your hostel properties.</div>

      <!-- Server error -->
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert error">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
      </div>
      <% } %>

      <!-- JS alert -->
      <div class="alert" id="loginAlertBox" style="display:none"></div>

      <form method="POST" action="/user/login">

        <!-- Role selector -->
        <div class="role-tabs">
          <input type="radio" name="user[role]" id="rOwner" class="role-tab-input" value="Owner" checked>
          <label for="rOwner" class="role-tab-label">
            <i class="fa-solid fa-crown"></i> Owner
          </label>

          <input type="radio" name="user[role]" id="rManager" class="role-tab-input" value="Manager">
          <label for="rManager" class="role-tab-label">
            <i class="fa-solid fa-user-gear"></i> Manager
          </label>
        </div>

        <!-- Email -->
        <div class="input-group">
          <label class="input-label">Email address</label>
          <input type="email" name="user[email]" class="hn-input"
                 placeholder="owner@example.com" maxlength="50" required>
        </div>

        <!-- Password -->
        <div class="input-group">
          <label class="input-label">Password</label>
          <div class="pass-wrap">
            <input type="password" id="loginPassInput" name="user[password]"
                   class="hn-input" placeholder="Your password" maxlength="30" required>
            <i class="fa-solid fa-eye pass-eye" id="loginPassToggle"></i>
          </div>
          <a href="/user/forgot-password" class="forgot-link">Forgot password?</a>
        </div>

        <button type="submit" class="btn-main">
          <i class="fa-solid fa-right-to-bracket"></i> Login
        </button>

      </form>

      <div class="links-row" style="margin-top:16px">
        Don't have an account? <span class="fake-link" id="linkGoSignup">Sign up →</span>
      </div>

      <div class="student-note">
        Looking for a hostel? <a href="/student/login">Student Login →</a>
      </div>

    </div>
  </div>

  <!-- ============================================================
       LAYER 3 — SIGNUP
  ============================================================ -->
  <div class="layer layer-signup">
    <div class="back-btn" id="btnBackFromSignup"><i class="fa-solid fa-arrow-left"></i></div>

    <div class="signup-inner">
      <!-- LEFT PANEL -->
      <div class="left-panel">
        <div class="lp-brand">
          <img src="/images/hostelnode-logo-cutout.png" alt="HostelNode">
          <span>HostelNode</span>
        </div>
        <div class="lp-content">
          <div class="lp-tag"><div class="dot"></div> Hostel Owners</div>
          <div class="lp-heading">Manage your<br>hostel smarter<br><em>starting today.</em></div>
          <div class="lp-sub">Join 5,000+ hostel owners who use HostelNode to manage rooms, members, payments, and reach students — all in one place.</div>
          <div class="lp-perks">
            <div class="lp-perk">
              <div class="lp-perk-icon"><i class="fa-solid fa-building"></i></div>
              <div class="lp-perk-text"><strong>Multi-property support</strong>Manage multiple hostels from one dashboard.</div>
            </div>
            <div class="lp-perk">
              <div class="lp-perk-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
              <div class="lp-perk-text"><strong>Payment tracking</strong>Track fees, dues, and advance payments instantly.</div>
            </div>
            <div class="lp-perk">
              <div class="lp-perk-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
              <div class="lp-perk-text"><strong>Get discovered</strong>List your hostel and reach 50,000+ students monthly.</div>
            </div>
            <div class="lp-perk">
              <div class="lp-perk-icon"><i class="fa-solid fa-shield-halved"></i></div>
              <div class="lp-perk-text"><strong>Verified badge</strong>Build trust with our verification system.</div>
            </div>
          </div>
        </div>
        <div class="lp-bottom">© 2026 HostelNode · Built in India 🇮🇳</div>
      </div>

      <!-- RIGHT PANEL -->
      <div class="right-panel">
        <div class="signup-box">

          <div class="mobile-brand">
            <img src="/images/hostelnode-logo-cutout.png" alt="HostelNode">
            <span>HostelNode</span>
          </div>

          <div class="sb-title">Create Account</div>
          <div class="sb-sub">Quick signup — takes under a minute</div>

          <div class="alert-box" id="alertBox"></div>

          <form id="ownerForm" method="POST" enctype="multipart/form-data" action="/user/signup">

            <!-- Name + Email -->
            <div class="input-row">
              <div class="input-group">
                <label class="input-label">Full Name <span style="color:#ef4444">*</span></label>
                <input type="text" id="fname" name="name" class="hn-input" placeholder="Ramesh Patel" maxlength="60">
                <span class="field-error hidden" id="err-name"><i class="fa-solid fa-circle-exclamation"></i> <span></span></span>
              </div>
              <div class="input-group">
                <label class="input-label">Email <span style="color:#ef4444">*</span></label>
                <input type="email" id="femail" name="email" class="hn-input" placeholder="you@example.com">
                <span class="field-error hidden" id="err-email"><i class="fa-solid fa-circle-exclamation"></i> <span></span></span>
              </div>
            </div>

            <!-- Password -->
            <div class="input-group">
              <label class="input-label">Password <span style="color:#ef4444">*</span></label>
              <div class="pass-wrap">
                <input type="password" id="fpassword" name="password" class="hn-input"
                       placeholder="Min 6 chars + 1 number" maxlength="30">
                <i class="fa-solid fa-eye pass-eye" id="passEye"></i>
              </div>
              <div class="pw-strength" id="pwStrength" style="display:none">
                <div class="pw-bars">
                  <div class="pw-bar" id="bar1"></div>
                  <div class="pw-bar" id="bar2"></div>
                  <div class="pw-bar" id="bar3"></div>
                  <div class="pw-bar" id="bar4"></div>
                </div>
                <div class="pw-label" id="pwLabel">Weak</div>
              </div>
              <span class="field-error hidden" id="err-password"><i class="fa-solid fa-circle-exclamation"></i> <span></span></span>
            </div>

            <!-- Photo -->
            <div class="input-group">
              <label class="input-label">Profile Photo <span style="color:#94a3b8;font-size:0.7rem">Optional</span></label>
              <div class="photo-zone" id="photoZone">
                <input type="file" name="profileImage" id="photoInput" accept="image/jpeg,image/png,image/webp" onchange="handlePhoto(this)">
                <div class="photo-zone-icon">
                  <img id="photoPreview" alt="">
                  <i class="fa-solid fa-user" id="photoIcon"></i>
                </div>
                <div class="photo-zone-text">
                  <div class="title" id="photoTitle">Upload your photo</div>
                  <div class="sub">JPG, PNG, WEBP · Max 10MB</div>
                </div>
              </div>
            </div>

            <!-- Phone -->
            <div class="form-divider"><i class="fa-solid fa-mobile-screen"></i> Verify Phone</div>

            <div class="input-group">
              <label class="input-label">Mobile Number <span style="color:#ef4444">*</span></label>
              <div class="phone-row">
                <input type="tel" id="fphone" name="phone" class="hn-input"
                  placeholder="10-digit number" maxlength="10"
                  inputmode="numeric" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                <button type="button" class="btn-otp" id="btnSendOtp" onclick="sendOtp()">
                  Send OTP
                </button>
              </div>
              <span class="field-error hidden" id="err-phone"><i class="fa-solid fa-circle-exclamation"></i> <span></span></span>
              <div class="resend-row" id="resendRow" style="display:none">
                Didn't receive? <span class="resend-link" id="resendLink" onclick="resendOtp()">Resend</span>
                <span id="resendTimer"></span>
              </div>
            </div>

            <!-- OTP -->
            <div id="otpSection" style="display:none">
              <div class="input-label" style="margin-bottom:8px">Enter 4-digit OTP</div>
              <div class="otp-row">
                <input type="text" maxlength="1" class="otp-input" id="otp1" inputmode="numeric">
                <input type="text" maxlength="1" class="otp-input" id="otp2" inputmode="numeric">
                <input type="text" maxlength="1" class="otp-input" id="otp3" inputmode="numeric">
                <input type="text" maxlength="1" class="otp-input" id="otp4" inputmode="numeric">
              </div>
              <div class="verify-status" id="verifyStatus" style="display:none"></div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-main" id="btnSubmit">
              <i class="fa-solid fa-crown"></i> Create Owner Account
            </button>

            <div class="hint-text">
              <i class="fa-solid fa-circle-info"></i>
              Business details, hostel info & location can be added later from your profile.
            </div>

          </form>

          <div class="login-prompt">
            Already have an account? <span class="fake-link" id="linkGoLogin">Login →</span>
          </div>

        </div>
      </div>
    </div>
  </div>

</div><!-- /.stage -->

<script>
/* ============================================================
   STATE MACHINE — welcome / login / signup
============================================================ */
function showState(state) {
  document.body.setAttribute('data-state', state);
  try { history.pushState(null, '', '/' + (state === 'welcome' ? '' : state)); } catch (e) {}
}

document.getElementById('btnGoLogin').addEventListener('click', () => showState('login'));
document.getElementById('btnGoSignup').addEventListener('click', () => showState('signup'));
document.getElementById('btnBackFromLogin').addEventListener('click', () => showState('welcome'));
document.getElementById('btnBackFromSignup').addEventListener('click', () => showState('welcome'));
document.getElementById('linkGoSignup').addEventListener('click', () => showState('signup'));
document.getElementById('linkGoLogin').addEventListener('click', () => showState('login'));

/* keep browser back/forward in sync */
window.addEventListener('popstate', () => {
  const path = location.pathname.replace(/\//g, '');
  showState(path === 'login' || path === 'signup' ? path : 'welcome');
});

/* ============================================================
   LOGIN — password toggle
============================================================ */
document.getElementById('loginPassToggle').addEventListener('click', function () {
  const inp = document.getElementById('loginPassInput');
  inp.type = inp.type === 'password' ? 'text' : 'password';
  this.classList.toggle('fa-eye-slash');
});

/* ============================================================
   SIGNUP — full original logic (validation, OTP, photo, submit)
============================================================ */
let phoneVerified = false;
let timerInterval = null;

function showAlert(msg, type = 'error') {
  const box = document.getElementById('alertBox');
  box.textContent = msg;
  box.className = `alert-box ${type}`;
  box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  if (type === 'error') setTimeout(() => { box.className = 'alert-box'; }, 5000);
}
function clearAlert() { document.getElementById('alertBox').className = 'alert-box'; }

function fieldError(id, msg) {
  const err = document.getElementById('err-' + id);
  const inp = document.getElementById('f' + id);
  if (err) { err.querySelector('span').textContent = msg; err.classList.remove('hidden'); }
  if (inp) { inp.classList.add('error'); inp.classList.remove('success'); }
}
function fieldOk(id) {
  const err = document.getElementById('err-' + id);
  const inp = document.getElementById('f' + id);
  if (err) err.classList.add('hidden');
  if (inp) { inp.classList.remove('error'); inp.classList.add('success'); }
}
function fieldReset(id) {
  const err = document.getElementById('err-' + id);
  const inp = document.getElementById('f' + id);
  if (err) err.classList.add('hidden');
  if (inp) inp.classList.remove('error', 'success');
}

function validateName() {
  const v = document.getElementById('fname').value.trim();
  if (!v)           { fieldError('name', 'Full name is required'); return false; }
  if (v.length < 3) { fieldError('name', 'Name must be at least 3 characters'); return false; }
  if (v.length > 60){ fieldError('name', 'Name is too long (max 60 characters)'); return false; }
  fieldOk('name'); return true;
}
function validateEmail() {
  const v = document.getElementById('femail').value.trim();
  if (!v) { fieldError('email', 'Email address is required'); return false; }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) { fieldError('email', 'Enter a valid email address'); return false; }
  fieldOk('email'); return true;
}
function validatePassword(showErr = true) {
  const v = document.getElementById('fpassword').value;
  if (!v)          { if (showErr) fieldError('password', 'Password is required'); return false; }
  if (v.length < 6){ if (showErr) fieldError('password', 'Password must be at least 6 characters'); return false; }
  if (!/\d/.test(v)){ if (showErr) fieldError('password', 'Password must contain at least 1 number'); return false; }
  fieldOk('password'); return true;
}
function validatePhone() {
  const v = document.getElementById('fphone').value.trim();
  if (!v)                        { fieldError('phone', 'Mobile number is required'); return false; }
  if (!/^[6-9]\d{9}$/.test(v))  { fieldError('phone', 'Enter a valid 10-digit Indian mobile number'); return false; }
  fieldOk('phone'); return true;
}

document.getElementById('fname').addEventListener('blur', validateName);
document.getElementById('fname').addEventListener('input', () => {
  if (document.getElementById('fname').value.trim().length >= 3) fieldOk('name');
  else fieldReset('name');
});

document.getElementById('femail').addEventListener('blur', validateEmail);
document.getElementById('femail').addEventListener('input', () => fieldReset('email'));

document.getElementById('fpassword').addEventListener('input', () => {
  updateStrength();
  const v = document.getElementById('fpassword').value;
  if (!v) { fieldReset('password'); return; }
  if (validatePassword(false)) fieldOk('password'); else fieldReset('password');
});
document.getElementById('fpassword').addEventListener('blur', () => validatePassword(true));

document.getElementById('fphone').addEventListener('blur', validatePhone);
document.getElementById('fphone').addEventListener('input', () => fieldReset('phone'));

function updateStrength() {
  const v    = document.getElementById('fpassword').value;
  const wrap = document.getElementById('pwStrength');
  const bars = ['bar1','bar2','bar3','bar4'].map(id => document.getElementById(id));
  const lbl  = document.getElementById('pwLabel');

  if (!v) { wrap.style.display = 'none'; bars.forEach(b => b.className = 'pw-bar'); return; }
  wrap.style.display = 'block';

  let score = 0;
  if (v.length >= 6)  score++;
  if (v.length >= 10) score++;
  if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
  if (/\d/.test(v) && /[^a-zA-Z0-9]/.test(v)) score++;

  const cls    = ['weak','fair','good','strong'];
  const labels = ['Weak — add more characters','Fair — add uppercase letters','Good — add symbols to strengthen','Strong password!'];
  const colors = ['#ef4444','#f59e0b','#3b82f6','var(--g)'];

  bars.forEach((b, i) => { b.className = 'pw-bar' + (i < score ? ' ' + cls[score - 1] : ''); });
  lbl.textContent = labels[score - 1] || 'Weak';
  lbl.style.color = colors[score - 1] || '#ef4444';
}

document.getElementById('passEye').addEventListener('click', function () {
  const inp = document.getElementById('fpassword');
  inp.type = inp.type === 'password' ? 'text' : 'password';
  this.classList.toggle('fa-eye-slash');
});

function handlePhoto(input) {
  if (!input.files[0]) return;
  const file = input.files[0];
  if (!['image/jpeg','image/png','image/webp'].includes(file.type)) {
    showAlert('Only JPG, PNG, or WEBP images are allowed');
    input.value = ''; return;
  }
  if (file.size > 10 * 1024 * 1024) {
    showAlert('Image too large — maximum size is 10MB');
    input.value = ''; return;
  }
  document.getElementById('photoZone').classList.add('has-file');
  document.getElementById('photoTitle').textContent = file.name;
  const reader = new FileReader();
  reader.onload = e => {
    const preview = document.getElementById('photoPreview');
    preview.src = e.target.result;
    preview.style.display = 'block';
    document.getElementById('photoIcon').style.display = 'none';
  };
  reader.readAsDataURL(file);
}

async function sendOtp() {
  if (!validatePhone()) return;

  const phone = document.getElementById('fphone').value.trim();
  const btn   = document.getElementById('btnSendOtp');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

  try {
    const res  = await fetch('/user/send-otp', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone })
    });
    const data = await res.json();

    if (data.success) {
      document.getElementById('otpSection').style.display = 'block';
      document.getElementById('resendRow').style.display  = 'block';
      document.getElementById('otp1').focus();
      startResendTimer(60);
      showAlert('OTP sent to your WhatsApp!', 'success');
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Sent';
    } else {
      showAlert(data.error || 'Failed to send OTP. Please try again.');
      btn.disabled = false; btn.innerHTML = 'Send OTP';
    }
  } catch {
    showAlert('Network error — please check your connection and try again.');
    btn.disabled = false; btn.innerHTML = 'Send OTP';
  }
}

async function resendOtp() {
  phoneVerified = false;
  ['otp1','otp2','otp3','otp4'].forEach(id => {
    const el = document.getElementById(id); el.value = ''; el.classList.remove('filled');
  });
  document.getElementById('verifyStatus').style.display = 'none';
  document.getElementById('btnSendOtp').disabled = false;
  clearAlert();
  await sendOtp();
}

function startResendTimer(sec) {
  clearInterval(timerInterval);
  const link = document.getElementById('resendLink');
  const timer = document.getElementById('resendTimer');
  link.style.pointerEvents = 'none'; link.style.opacity = '0.4';
  let t = sec;
  timerInterval = setInterval(() => {
    timer.textContent = ` (${t}s)`; t--;
    if (t < 0) {
      clearInterval(timerInterval); timer.textContent = '';
      link.style.pointerEvents = ''; link.style.opacity = '1';
    }
  }, 1000);
}

const otpIds = ['otp1','otp2','otp3','otp4'];
otpIds.forEach((id, idx) => {
  const el = document.getElementById(id);

  el.addEventListener('input', () => {
    el.value = el.value.replace(/[^0-9]/g, '');
    if (el.value) { el.classList.add('filled'); if (idx < 3) document.getElementById(otpIds[idx+1]).focus(); }
    else el.classList.remove('filled');
    const all = otpIds.map(i => document.getElementById(i).value).join('');
    if (all.length === 4) verifyOtp(all);
  });

  el.addEventListener('paste', (e) => {
    e.preventDefault();
    const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'').slice(0,4);
    pasted.split('').forEach((ch, i) => {
      const box = document.getElementById(otpIds[i]);
      if (box) { box.value = ch; box.classList.add('filled'); }
    });
    document.getElementById(otpIds[Math.min(pasted.length, 3)])?.focus();
    if (pasted.length === 4) verifyOtp(pasted);
  });

  el.addEventListener('keydown', e => {
    if (e.key === 'Backspace' && !el.value && idx > 0)
      document.getElementById(otpIds[idx - 1]).focus();
  });
});

async function verifyOtp(otp) {
  const phone = document.getElementById('fphone').value.trim();
  const vs    = document.getElementById('verifyStatus');
  vs.style.display = 'flex';
  vs.className = 'verify-status';
  vs.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Verifying…';

  try {
    const res  = await fetch('/user/verify-otp', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone, otp })
    });
    const data = await res.json();

    if (data.success) {
      phoneVerified = true;
      vs.className  = 'verify-status ok';
      vs.innerHTML  = '<i class="fa-solid fa-circle-check"></i> Phone verified!';
      document.getElementById('fphone').classList.add('success');
      document.getElementById('fphone').classList.remove('error');
      fieldReset('phone');
    } else {
      phoneVerified = false;
      vs.className  = 'verify-status err';
      vs.innerHTML  = `<i class="fa-solid fa-circle-xmark"></i> ${data.error || 'Incorrect OTP. Please try again.'}`;
      otpIds.forEach(i => {
        const b = document.getElementById(i);
        b.value = ''; b.classList.remove('filled');
        b.classList.add('error');
        setTimeout(() => b.classList.remove('error'), 700);
      });
      document.getElementById('otp1').focus();
    }
  } catch {
    phoneVerified = false;
    vs.className  = 'verify-status err';
    vs.innerHTML  = '<i class="fa-solid fa-circle-xmark"></i> Network error — could not verify. Try again.';
  }
}

document.getElementById('ownerForm').addEventListener('submit', async function (e) {
  e.preventDefault();
  clearAlert();

  const okName  = validateName();
  const okEmail = validateEmail();
  const okPass  = validatePassword(true);
  const okPhone = validatePhone();

  if (!okName || !okEmail || !okPass || !okPhone) {
    showAlert('Please fix the highlighted errors before continuing.');
    document.querySelector('.layer-signup .hn-input.error')?.scrollIntoView({ behavior:'smooth', block:'center' });
    return;
  }

  if (!phoneVerified) {
    showAlert('Please verify your phone number with OTP first.');
    document.getElementById('fphone').scrollIntoView({ behavior:'smooth', block:'center' });
    return;
  }

  const btn = document.getElementById('btnSubmit');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating account…';

  try {
    const res = await fetch(this.action, { method:'POST', body: new FormData(this) });

    if (res.redirected || res.ok) {
      const html = await res.text();
      document.open(); document.write(html); document.close();
      return;
    }

    let msg = 'Signup failed. Please try again.';
    try {
      const data = await res.json();
      if (data.error) msg = data.error;
    } catch {}

    if (/email already registered/i.test(msg))  fieldError('email', 'This email is already in use — try logging in');
    else if (/invalid email/i.test(msg))         fieldError('email', 'Invalid email format');
    else if (/phone already registered/i.test(msg)) fieldError('phone', 'This number is already registered');
    else if (/invalid phone/i.test(msg))         fieldError('phone', 'Invalid phone number');
    else if (/phone not verified/i.test(msg))    showAlert('Phone verification expired — please re-verify.');
    else if (/password/i.test(msg))              fieldError('password', msg);
    else if (/name/i.test(msg))                  fieldError('name', msg);
    else                                         showAlert(msg);

    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-crown"></i> Create Owner Account';

  } catch {
    showAlert('Network error — please check your connection and try again.');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-crown"></i> Create Owner Account';
  }
});
</script>
</body>
</html>
