    <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>
*{margin:0;padding:0;box-sizing:border-box;}

body{
  font-family:'Inter',sans-serif;
  background: linear-gradient(135deg, #09B850, #0f172a);
  height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

/* background animation */
body::before{
  content:"";
  position:absolute;
  width:200%;
  height:200%;
  background: radial-gradient(circle, rgba(255,255,255,0.05) 10%, transparent 10%);
  background-size:70px 70px;
  animation:move 30s linear infinite;
}
@keyframes move{
  0%{transform:translate(0,0);}
  50%{transform:translate(-100px,-120px);}
  100%{transform:translate(0,0);}
}

.login-wrapper{
  width:100%;
  max-width:420px;
  backdrop-filter:blur(20px);
  border-radius:22px;
  box-shadow:0 25px 70px rgba(0,0,0,0.35);
}

.logo{text-align:center;margin:25px 0;}
.logo img{height:90px;}

.card-login{
  background:rgba(255,255,255,0.95);
  padding:40px 30px;
  border-radius:22px;
}

.title{
  text-align:center;
  font-size:24px;
  font-weight:700;
  color:#09B850;
}

.sub{
  text-align:center;
  font-size:14px;
  color:#64748B;
  margin-bottom:25px;
}

.form-control{
  width:100%;
  padding:12px;
  border-radius:12px;
  border:1px solid #CBD5E1;
  margin-top:6px;
}
.form-control:focus{
  border-color:#09B850;
  box-shadow:0 0 0 3px rgba(9,184,80,0.2);
  outline:none;
}

.btn{
  width:100%;
  margin-top:18px;
  padding:12px;
  border:none;
  border-radius:12px;
  font-weight:600;
  color:white;
  background:linear-gradient(135deg,#09B850,#22C55E);
}

.custom-alert{
  padding:12px;
  margin-bottom:15px;
  border-radius:12px;
  background:rgba(255,0,0,0.08);
  color:#dc2626;
}

.link{
  text-align:center;
  margin-top:15px;
}
.link a{
  color:#09B850;
  text-decoration:none;
}
</style>
</head>

<body>

<div class="login-wrapper">

  <div class="logo">
    <img src="/images/hostelnode-logo-cutout.png">
  </div>

  <div class="card-login">

    <% if (typeof error !== 'undefined') { %>
      <div class="custom-alert"><%= error %></div>
    <% } %>

    <% if (typeof message !== 'undefined') { %>
      <div style="text-align: center; color:green;"> <h2><%= message %></h2><hr style="margin: 8px ;"></div>
    <% } %>

    <div class="title">Forgot Password</div>
    <div class="sub">Enter your email to reset password</div>

    <form method="POST" action="/user/forgot-password">
      <label>Email</label>
      <input type="email" name="email" class="form-control" required>

      <button class="btn">Send Reset Link</button>
    </form>

    <div class="link">
      <a href="/login">Back to Login</a>
    </div>

  </div>

</div>

</body>
</html>