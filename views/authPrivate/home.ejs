.login-modal-card .forgot-link:hover { color: #047857; }

.login-modal-card .btn-main { position: relative; overflow: hidden; width: 100%; padding: 15px; border: none; border-radius: 13px; background: linear-gradient(135deg, var(--g), #22c55e); color: #fff; font-family: var(--font-d); font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: transform 0.25s cubic-bezier(.34,1.56,.64,1), box-shadow 0.25s; margin-top: 8px; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 8px 24px var(--g-glow); }
.login-modal-card .btn-main::after { content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; background: linear-gradient(120deg, transparent, rgba(255,255,255,0.4), transparent); transform: skewX(-20deg); transition: left 0.6s ease; }
.login-modal-card .btn-main:hover::after { left: 130%; }
.login-modal-card .btn-main:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(9,184,80,0.48); }
.login-modal-card .btn-main:active { transform: scale(0.98); }

.login-modal-card .alert { padding: 11px 15px; border-radius: 12px; margin-bottom: 16px; font-size: 0.8rem; font-weight: 500; display: none; align-items: center; gap: 7px; }
.login-modal-card .alert.error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #dc2626; display: flex; animation: modalShake 0.4s ease; }
@keyframes modalShake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-6px)} 75%{transform:translateX(6px)} }

.login-modal-card .links-row { text-align: center; margin-top: 18px; font-size: 0.82rem; color: #7a7a7a; }
