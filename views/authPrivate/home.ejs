<style>
:root {
  --g: #09B850;
  --g-dark: #078040;
  --g-light: #e8f9ef;
  --g-glow: rgba(9,184,80,0.35);
  --amber: #f59e0b;
  --amber-dark: #92400e;
  --text-dark: #0f1117;
  --text-light: #64748b;
  --bg-light: #f8fafb;
  --white: #ffffff;
  --border: #e2e8f0;
  --font-d: 'Space Grotesk', sans-serif;
  --font-b: 'Inter', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-b);
  background: var(--white);
  color: var(--text-dark);
  overflow-x: hidden;
}

/* ANIMATIONS */
@keyframes fadeInUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideInLeft { from { opacity: 0; transform: translateX(-60px); } to { opacity: 1; transform: translateX(0); } }
@keyframes slideInRight { from { opacity: 0; transform: translateX(60px); } to { opacity: 1; transform: translateX(0); } }
@keyframes zoomIn { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
@keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-18px); } }
@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(9,184,80,0.4); } 70% { box-shadow: 0 0 0 14px rgba(9,184,80,0); } }
@keyframes spin360 { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }
@keyframes countUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

.reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.8s cubic-bezier(.16,.84,.24,1), transform 0.8s cubic-bezier(.16,.84,.24,1); }
.reveal.in-view { opacity: 1; transform: none; }

/* NAVBAR */
nav.navbar {
  position: sticky; top: 0; z-index: 50; padding: 16px 0;
  background: rgba(255,255,255,0.9); backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(0,0,0,0.06);
  transition: all 0.3s;
}
nav.navbar .nav-inner {
  max-width: 1200px; margin: 0 auto; padding: 0 24px;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-brand { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 1.25rem; color: var(--text-dark); font-family: var(--font-d); }
.nav-brand-icon { width: 38px; height: 38px; border-radius: 11px; background: var(--white); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.05rem; box-shadow: 0 6px 18px var(--g-glow); }
.nav-links { display: none; gap: 30px; align-items: center; }
@media (min-width: 850px) { .nav-links { display: flex; } }
.nav-links a { text-decoration: none; color: var(--text-light); font-weight: 600; font-size: 0.88rem; transition: color 0.3s; position: relative; }
.nav-links a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--g); transition: width 0.3s; }
.nav-links a:hover { color: var(--text-dark); }
.nav-links a:hover::after { width: 100%; }
.nav-actions { display: flex; gap: 10px; }
.btn-nav { padding: 10px 22px; border-radius: 10px; border: none; font-weight: 700; font-family: var(--font-d); cursor: pointer; font-size: 0.83rem; transition: all 0.3s; text-decoration: none; display: inline-flex; align-items: center; }
.btn-nav-primary { background: linear-gradient(135deg, var(--g), #22c55e); color: white; box-shadow: 0 6px 18px var(--g-glow); }
.btn-nav-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(9,184,80,0.5); }
.btn-nav-secondary { background: var(--bg-light); color: var(--text-dark); border: 1.5px solid rgba(0,0,0,0.1); }
.btn-nav-secondary:hover { background: rgba(0,0,0,0.04); }

/* LIVE DEMO SECTION */
.live-demo-section { padding: 56px 24px 72px; background: radial-gradient(ellipse 800px 400px at 15% 0%, rgba(9,184,80,0.10), transparent 65%), radial-gradient(ellipse 600px 400px at 100% 100%, rgba(245,158,11,0.05), transparent 60%), var(--text-dark); overflow: hidden; color: white; }
.live-demo-inner { max-width: 1200px; margin: 0 auto; position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 54px; align-items: center; }
@media (max-width: 900px){ .live-demo-inner{ grid-template-columns: 1fr; } }

.ld-eyebrow{ display:inline-flex; align-items:center; gap:8px; background: rgba(9,184,80,0.14); border:1px solid rgba(9,184,80,0.35); color:#7CF0A6; font-size:0.72rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; padding:7px 16px; border-radius:999px; margin-bottom:20px; }
.ld-eyebrow .dot{ width:6px; height:6px; border-radius:50%; background:#7CF0A6; animation:pulse 1.8s infinite; }

.live-demo-text h2{ font-family: var(--font-d); font-weight:800; letter-spacing:-0.025em; line-height:1.15; font-size: clamp(1.7rem, 3.2vw, 2.5rem); margin-bottom:14px; }
.live-demo-text h2 span{ color:#3FE07C; }
.live-demo-text > p{ font-size:1rem; color:rgba(255,255,255,0.65); line-height:1.7; max-width:480px; margin-bottom:32px; }

.story-steps{ display:flex; flex-direction:column; gap:4px; }
.story-step{ display:flex; align-items:flex-start; gap:14px; padding:13px 14px; border-radius:12px; cursor:default; border:1px solid transparent; opacity:0.4; transform: translateX(0); transition: opacity 0.5s ease, background 0.5s ease, border-color 0.5s ease, transform 0.5s ease; }
.story-step .num{ min-width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--font-d); font-weight:800; font-size:0.72rem; background: rgba(255,255,255,0.08); color:rgba(255,255,255,0.55); transition: all 0.5s ease; flex-shrink:0; margin-top:1px; }
.story-step b{ display:block; font-size:0.9rem; font-weight:700; margin-bottom:2px; }
.story-step span{ font-size:0.78rem; color:rgba(255,255,255,0.5); line-height:1.5; }
.story-step.active{ opacity:1; background:rgba(255,255,255,0.06); border-color:rgba(9,184,80,0.3); transform: translateX(4px); }
.story-step.active .num{ background: linear-gradient(135deg, var(--g), #22c55e); color:white; box-shadow:0 4px 14px var(--g-glow); }

/* Phone shell */
.ld-phone-wrap{ display:flex; justify-content:center; perspective:1200px; }
.ld-phone{ width:290px; height:598px; background:#05060a; border-radius:40px; padding:11px; box-shadow: 0 50px 100px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.06); position:relative; animation: float 6.5s ease-in-out infinite; }
.ld-phone::before{ content:''; position:absolute; top:11px; left:50%; transform:translateX(-50%); width:96px; height:20px; background:#05060a; border-radius:0 0 14px 14px; z-index:30; }
.ld-screen{ width:100%; height:100%; background:var(--bg-light); border-radius:30px; overflow:hidden; position:relative; }
.ld-topbar{ padding:14px 20px 6px; display:flex; justify-content:space-between; align-items:center; font-size:0.65rem; font-weight:700; color:var(--text-dark); background:white; position:relative; z-index:5; }
.ld-appbar{ padding:2px 18px 12px; display:flex; align-items:center; justify-content:space-between; background:white; position:relative; z-index:5; }
.ld-appbar .brand{ font-family:var(--font-d); font-weight:800; font-size:0.98rem; color:var(--text-dark); display:flex; align-items:center; gap:6px; }
.ld-appbar .brand img{ width:24px; height:24px; object-fit:contain; }
.ld-appbar .brand i{ color:var(--g); font-size:0.85rem; }

.ld-stage{ position:relative; width:100%; height:calc(100% - 74px); overflow:hidden; }

.story-scene{ position:absolute; inset:0; padding:16px; opacity:0; transform: scale(1.08); transition: opacity .7s ease, transform 1s cubic-bezier(.16,.84,.24,1); pointer-events:none; }
.story-scene.active{ opacity:1; transform: scale(1); pointer-events:auto; z-index:3; }
.story-scene .kb{ animation: kenBurns 4.2s ease-in-out infinite alternate; }
@keyframes kenBurns{ from{ transform:scale(1); } to{ transform:scale(1.035); } }

/* Search scene */
.ld-search-bar{ display:flex; align-items:center; gap:9px; background:white; border:1.5px solid var(--border); padding:12px 14px; border-radius:12px; font-size:0.8rem; font-weight:600; color:var(--text-dark); box-shadow:0 4px 14px rgba(0,0,0,0.04); margin-bottom:14px; }
.ld-search-bar i{ color:var(--g); }
.ld-radius-row{ display:flex; gap:6px; margin-bottom:18px; }
.ld-radius-pill{ flex:1; text-align:center; padding:7px 4px; border-radius:20px; font-size:0.66rem; font-weight:700; border:1px solid var(--g); color:var(--g-dark); background:var(--g-light); }
.ld-radius-pill.active{ background:var(--g); color:white; }
.ld-find-btn{ width:100%; padding:15px; border-radius:14px; border:none; background:linear-gradient(135deg, var(--g), #22c55e); color:white; font-family:var(--font-d); font-weight:700; font-size:0.86rem; display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 10px 26px var(--g-glow); position:relative; }

.ld-finger{ position:absolute; width:32px; height:32px; background:rgba(15,17,23,0.88); border-radius:50% 50% 50% 4px; transform:rotate(-45deg); box-shadow:0 6px 16px rgba(0,0,0,0.3); z-index:10; }
.scene-search .ld-finger{ bottom:-40px; right:60px; animation: fingerTap1 3.2s ease-in-out infinite; }
@keyframes fingerTap1{ 0%,10%{opacity:0; transform:translate(30px,20px) rotate(-45deg);} 30%,70%{opacity:1; transform:translate(0,0) rotate(-45deg) scale(0.92);} 90%,100%{opacity:0;} }

/* Results scene */
.ld-result-hdr{ font-size:0.72rem; font-weight:700; color:var(--text-light); margin-bottom:10px; }
.ld-result-hdr b{ color:var(--text-dark); }
.ld-result-card{ display:flex; gap:10px; padding:10px; background:white; border:1px solid var(--border); border-radius:12px; margin-bottom:8px; box-shadow:0 3px 10px rgba(0,0,0,0.03); }
.ld-result-thumb{ width:44px; height:44px; border-radius:8px; flex-shrink:0; background:linear-gradient(135deg,#bbf7d0,#6ee7a8); display:flex; align-items:center; justify-content:center; color:var(--g-dark); font-size:0.9rem; }
.ld-result-info{ flex:1; min-width:0; }
.ld-result-info .rname{ font-size:0.7rem; font-weight:700; margin-bottom:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ld-result-info .rmeta{ font-size:0.62rem; color:var(--text-light); margin-bottom:2px; }
.ld-result-info .rprice{ font-size:0.68rem; font-weight:700; color:var(--g-dark); }
.ld-result-card.selected{ border-color:var(--g); box-shadow:0 0 0 2px rgba(9,184,80,0.25); }

/* Property detail scene */
.ld-gallery{ display:grid; grid-template-columns:1.4fr 1fr; gap:6px; margin-bottom:12px; height:118px; }
.ld-gallery-main{ border-radius:12px; background:linear-gradient(135deg,#a7f3d0,#6ee7a8); }
.ld-gallery-side{ display:grid; grid-template-rows:1fr 1fr; gap:6px; }
.ld-gallery-side div{ border-radius:10px; background:linear-gradient(135deg,#d1fae5,#a7f3d0); }
.ld-price-card{ background:white; border:1px solid var(--border); border-radius:14px; padding:12px 14px; box-shadow:0 8px 20px rgba(0,0,0,0.05); }
.ld-price-card .lbl{ font-size:0.6rem; color:var(--text-light); text-transform:uppercase; letter-spacing:0.04em; font-weight:700; }
.ld-price-card .amt{ font-family:var(--font-d); font-size:1.15rem; font-weight:800; color:var(--text-dark); margin:2px 0 6px; }
.ld-stars{ font-size:0.68rem; color:var(--amber); margin-bottom:10px; }
.ld-stars span{ color:var(--text-light); font-weight:600; }
.ld-contact-btn{ width:100%; padding:12px; border-radius:11px; border:none; background:linear-gradient(135deg, var(--g), #22c55e); color:white; font-family:var(--font-d); font-weight:700; font-size:0.78rem; display:flex; align-items:center; justify-content:center; gap:7px; animation:pulse 1.8s infinite; }

/* Contact modal scene */
.ld-modal{ background:white; border-radius:16px; padding:16px; box-shadow:0 20px 50px rgba(0,0,0,0.15); margin-top:22px; }
.ld-modal-icon{ width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg,var(--g),#22c55e); display:flex; align-items:center; justify-content:center; color:white; margin:0 auto 10px; font-size:1rem; }
.ld-modal h4{ text-align:center; font-family:var(--font-d); font-size:0.85rem; margin-bottom:12px; }
.ld-modal-opt{ display:flex; align-items:center; gap:10px; padding:9px 10px; border:1px solid var(--border); border-radius:10px; margin-bottom:7px; font-size:0.68rem; font-weight:700; position:relative; }
.ld-modal-opt i{ width:26px; height:26px; border-radius:8px; background:var(--g-light); color:var(--g-dark); display:flex; align-items:center; justify-content:center; font-size:0.7rem; }
.ld-modal-opt.hi{ border-color:var(--g); box-shadow:0 0 0 2px rgba(9,184,80,0.15); }
.ld-modal-opt.hi i{ background:var(--g); color:white; }
.scene-contact .ld-finger{ top:118px; right:26px; animation: fingerTap2 3.2s ease-in-out infinite; }
@keyframes fingerTap2{ 0%,15%{opacity:0; transform:translateY(20px) rotate(-45deg);} 35%,75%{opacity:1; transform:translateY(0) rotate(-45deg) scale(0.92);} 92%,100%{opacity:0;} }

/* Success scene */
.ld-success{ text-align:center; margin-top:60px; }
.ld-check{ width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,var(--g),#22c55e); display:flex; align-items:center; justify-content:center; color:white; font-size:1.6rem; margin:0 auto 16px; box-shadow:0 12px 28px var(--g-glow); animation: checkPop 3.2s ease-in-out infinite; }
@keyframes checkPop{ 0%,15%{ transform:scale(0.4); opacity:0; } 30%{ transform:scale(1.12); opacity:1; } 40%{ transform:scale(1); } 90%,100%{ transform:scale(1); opacity:1; } }
.ld-success h4{ font-family:var(--font-d); font-size:0.95rem; margin-bottom:6px; }
.ld-success p{ font-size:0.76rem; color:var(--text-light); line-height:1.5; max-width:210px; margin:0 auto; }
.ld-success .tag{ display:inline-flex; align-items:center; gap:6px; margin-top:14px; padding:6px 14px; background:var(--g-light); color:var(--g-dark); border-radius:20px; font-size:0.66rem; font-weight:700; }

/* Owner notification scene */
.ld-notif-card{ background:#12141b; border-radius:16px; padding:16px; color:white; margin-top:14px; box-shadow:0 24px 50px rgba(0,0,0,0.35); border:1px solid rgba(255,255,255,0.08); }
.ld-notif-card .nhead{ display:flex; align-items:center; gap:8px; margin-bottom:10px; }
.ld-notif-card .nhead .ic{ width:26px; height:26px; border-radius:50%; background:#25D366; display:flex; align-items:center; justify-content:center; font-size:0.7rem; }
.ld-notif-card .nhead b{ font-size:0.76rem; }
.ld-notif-row{ display:flex; gap:8px; font-size:0.68rem; padding:5px 0; color:rgba(255,255,255,0.85); border-bottom:1px solid rgba(255,255,255,0.06); }
.ld-notif-row i{ width:14px; color:#3FE07C; }
.ld-notif-row b{ color:rgba(255,255,255,0.5); font-weight:600; min-width:64px; display:inline-block; }
.ld-notif-cta{ margin-top:10px; text-align:center; font-size:0.66rem; font-weight:700; color:#3FE07C; }

/* Progress dots */
.ld-dots{ display:flex; justify-content:center; gap:7px; margin-top:22px; position:relative; z-index:2; }
.ld-dots i{ width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,0.18); transition: all .5s ease; }
.ld-dots i.active{ background:#3FE07C; width:22px; border-radius:5px; }

/* HERO SECTION */
.hero-owner { padding: 100px 24px 60px; background: radial-gradient(ellipse at top right, rgba(9,184,80,0.08), transparent 60%), var(--white); position: relative; overflow: hidden; text-align: center; }
.hero-owner::before { content: ''; position: absolute; top: -20%; left: -10%; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, rgba(9,184,80,0.08) 0%, transparent 70%); animation: float 9s ease-in-out infinite; }
.hero-owner::after { content: ''; position: absolute; bottom: -20%; right: -10%; width: 460px; height: 460px; border-radius: 50%; background: radial-gradient(circle, rgba(245,158,11,0.06) 0%, transparent 70%); animation: float 11s ease-in-out infinite reverse; }

.hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(9,184,80,0.1); border: 1px solid rgba(9,184,80,0.28); padding: 8px 20px; border-radius: 999px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; color: var(--g-dark); margin-bottom: 26px; position: relative; z-index: 2; }
.hero-badge .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--g); animation: pulse 1.8s ease infinite; }

.hero-owner h1 { font-family: var(--font-d); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; font-size: clamp(2.2rem, 5.5vw, 3.9rem); max-width: 850px; margin: 0 auto 22px; position: relative; z-index: 2; }
.hero-owner h1 .grad { background: linear-gradient(100deg, var(--g-dark), var(--g) 55%, #22c55e); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero-owner p.sub { font-size: 1.08rem; color: var(--text-light); line-height: 1.75; max-width: 600px; margin: 0 auto 36px; position: relative; z-index: 2; }
.hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-bottom: 22px; position: relative; z-index: 2; }
.btn-hero-primary { position: relative; overflow: hidden; padding: 17px 34px; border-radius: 14px; border: none; background: linear-gradient(135deg, var(--g), #22c55e); color: white; font-family: var(--font-d); font-weight: 700; font-size: 1rem; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 14px 34px var(--g-glow); transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); text-decoration: none; }
.btn-hero-primary::after { content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; background: linear-gradient(120deg, transparent, rgba(255,255,255,0.4), transparent); transform: skewX(-20deg); transition: left 0.6s ease; }
.btn-hero-primary:hover::after { left: 130%; }
.btn-hero-primary:hover { transform: translateY(-4px); box-shadow: 0 20px 44px rgba(9,184,80,0.5); }
.btn-hero-secondary { padding: 17px 34px; border-radius: 14px; border: 2px solid rgba(0,0,0,0.12); background: white; color: var(--text-dark); font-family: var(--font-d); font-weight: 700; font-size: 1rem; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; transition: all 0.3s; text-decoration: none; }
.btn-hero-secondary:hover { background: var(--bg-light); transform: translateY(-4px); border-color: rgba(0,0,0,0.2); }
.hero-note { font-size: 0.82rem; color: var(--text-light); position: relative; z-index: 2; }
.hero-note i { color: var(--g); margin-right: 5px; }

/* Stats strip */
.stats-strip { max-width: 950px; margin: 60px auto 0; position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 28px; background: white; border-radius: 20px; border: 1px solid var(--border); box-shadow: 0 20px 50px rgba(0,0,0,0.06); }
.stat-box { text-align: center; }
.stat-box b { display: block; font-family: var(--font-d); font-size: 1.9rem; font-weight: 800; color: var(--g-dark); animation: countUp 0.8s ease-out; }
.stat-box span { font-size: 0.74rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.04em; }
@media (max-width: 700px) { .stats-strip { grid-template-columns: repeat(2, 1fr); } }

/* DISCOVER SECTION */
.discover-section { padding: 100px 24px; background: var(--bg-light); }
.discover-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.discover-text h2 { font-family: var(--font-d); font-size: clamp(1.8rem, 3.4vw, 2.5rem); font-weight: 800; margin-bottom: 18px; line-height: 1.2; }
.discover-text p { font-size: 1.02rem; color: var(--text-light); line-height: 1.75; margin-bottom: 18px; }
.discover-steps { display: flex; flex-direction: column; gap: 14px; margin-top: 26px; }
.discover-step { display: flex; align-items: flex-start; gap: 14px; padding: 16px; background: white; border-radius: 14px; border: 1px solid var(--border); transition: all 0.3s; }
.discover-step:hover { transform: translateX(6px); border-color: var(--g); box-shadow: 0 10px 24px rgba(9,184,80,0.1); }
.discover-step-num { min-width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, var(--g), #22c55e); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-d); font-weight: 800; font-size: 0.95rem; }
.discover-step-text b { display: block; font-size: 0.95rem; margin-bottom: 3px; }
.discover-step-text span { font-size: 0.85rem; color: var(--text-light); }

/* Phone mockup */
.phone-demo-wrap { display: flex; justify-content: center; position: relative; }
.mobile-mockup { width: 300px; height: 610px; background: var(--text-dark); border-radius: 42px; padding: 12px; box-shadow: 0 40px 80px rgba(0,0,0,0.25); animation: float 6s ease-in-out infinite; }
.mobile-screen { width: 100%; height: 100%; background: white; border-radius: 30px; overflow: hidden; position: relative; display: flex; flex-direction: column; }
.mobile-topbar { padding: 14px 18px 8px; display: flex; justify-content: space-between; align-items: center; font-size: 0.68rem; font-weight: 700; color: var(--text-dark); }
.mobile-app-header { padding: 4px 18px 14px; display: flex; align-items: center; justify-content: space-between; }
.mobile-app-header .brand-mini { font-family: var(--font-d); font-weight: 800; font-size: 1rem; }
.mobile-body { flex: 1; padding: 0 16px 16px; overflow: hidden; position: relative; }

.find-btn { width: 100%; padding: 14px; border-radius: 14px; border: none; background: linear-gradient(135deg, var(--g), #22c55e); color: white; font-family: var(--font-d); font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; gap: 8px; margin: 8px 0 16px; animation: pulse 2s infinite; cursor: pointer; }
.finger-cursor { position: absolute; width: 34px; height: 34px; background: rgba(15,17,23,0.85); border-radius: 50% 50% 50% 4px; transform: rotate(-45deg); top: 128px; left: 130px; box-shadow: 0 6px 16px rgba(0,0,0,0.3); animation: fingerTap 3s ease-in-out infinite; z-index: 10; }
@keyframes fingerTap { 0%, 15% { top: 60px; left: 200px; opacity: 0; } 25% { opacity: 1; top: 128px; left: 130px; } 35% { transform: rotate(-45deg) scale(0.85); } 45% { transform: rotate(-45deg) scale(1); } 80% { top: 128px; left: 130px; opacity: 1; } 100% { top: 128px; left: 130px; opacity: 0; } }

.radius-row { display: flex; gap: 6px; margin-bottom: 14px; }
.radius-pill { flex: 1; text-align: center; padding: 7px 4px; border-radius: 20px; font-size: 0.68rem; font-weight: 700; border: 1px solid var(--g); color: var(--g-dark); background: var(--g-light); }
.radius-pill.active { background: var(--g); color: white; }

.result-card { display: flex; gap: 10px; padding: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; opacity: 0; animation: resultPop 3s ease-in-out infinite; }
.result-card:nth-child(1) { animation-delay: 1.9s; }
.result-card:nth-child(2) { animation-delay: 2.1s; }
.result-card:nth-child(3) { animation-delay: 2.3s; }
@keyframes resultPop { 0%, 55% { opacity: 0; transform: translateY(10px); } 65%, 100% { opacity: 1; transform: translateY(0); } }
.result-thumb { width: 46px; height: 46px; border-radius: 8px; background: linear-gradient(135deg, #d1fae5, #a7f3d0); flex-shrink: 0; }
.result-info { flex: 1; }
.result-info .rname { font-size: 0.72rem; font-weight: 700; margin-bottom: 2px; }
.result-info .rmeta { font-size: 0.64rem; color: var(--text-light); }
.result-info .rprice { font-size: 0.7rem; font-weight: 700; color: var(--g-dark); }

.notif-toast { position: absolute; top: -14px; right: -18px; background: white; border-radius: 14px; padding: 10px 14px; box-shadow: 0 14px 34px rgba(0,0,0,0.18); display: flex; align-items: center; gap: 8px; font-size: 0.74rem; font-weight: 700; animation: toastFloat 4s ease-in-out infinite; border-left: 4px solid var(--g); z-index: 20; }
@keyframes toastFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
.notif-toast .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--g); }

@media (max-width: 820px) { .discover-content { grid-template-columns: 1fr; } }

/* PROPERTY 360 SECTION */
.property-360-section { padding: 100px 24px; background: white; }
.property-360-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.property-360-visual { perspective: 1400px; }
.rotation-container { width: 100%; aspect-ratio: 1; border-radius: 24px; overflow: hidden; position: relative; box-shadow: 0 30px 70px rgba(0,0,0,0.15); border: 1px solid var(--border); }
.property-image { width: 100%; height: 100%; object-fit: cover; animation: spin360 22s linear infinite; }
.rotation-indicator { position: absolute; bottom: 18px; right: 18px; background: rgba(15,17,23,0.85); color: white; padding: 9px 16px; border-radius: 20px; font-size: 0.76rem; font-weight: 700; display: flex; align-items: center; gap: 6px; }
.rotation-indicator i { animation: spinIcon 2s linear infinite; }
@keyframes spinIcon { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.property-360-text h2 { font-family: var(--font-d); font-size: clamp(1.8rem, 3.4vw, 2.5rem); font-weight: 800; margin-bottom: 18px; }
.property-360-text p { font-size: 1.02rem; color: var(--text-light); line-height: 1.75; margin-bottom: 14px; }
.property-360-text .highlight { color: var(--text-dark); font-weight: 700; }
@media (max-width: 820px) { .property-360-content { grid-template-columns: 1fr; } .property-360-visual { order: -1; } }

/* FEATURES SECTION */
.feature-section { padding: 100px 24px; background: var(--bg-light); }
.section-head { text-align: center; max-width: 620px; margin: 0 auto 60px; }
.section-tag { display: inline-flex; align-items: center; gap: 7px; background: white; border: 1px solid var(--border); padding: 6px 16px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-light); margin-bottom: 16px; }
.section-head h2 { font-family: var(--font-d); font-size: clamp(1.8rem, 3.4vw, 2.5rem); font-weight: 800; margin-bottom: 12px; }
.section-head p { font-size: 1rem; color: var(--text-light); line-height: 1.65; }

.feature-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
.feature-card { padding: 32px 26px; background: white; border-radius: 20px; border: 1px solid var(--border); transition: all 0.35s cubic-bezier(0.16, 0.84, 0.24, 1); }
.feature-card:hover { transform: translateY(-8px); border-color: var(--g); box-shadow: 0 24px 50px rgba(9,184,80,0.14); }
.feature-icon { width: 54px; height: 54px; border-radius: 14px; background: linear-gradient(135deg, var(--g), #22c55e); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem; margin-bottom: 18px; transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1); }
.feature-card:hover .feature-icon { transform: scale(1.12) rotate(-6deg); }
.feature-card h3 { font-family: var(--font-d); font-size: 1.12rem; font-weight: 700; margin-bottom: 8px; }
.feature-card p { font-size: 0.9rem; color: var(--text-light); line-height: 1.6; }

/* DASHBOARD SECTION */
.dashboard-section { padding: 100px 24px; background: linear-gradient(135deg, var(--g) 0%, var(--g-dark) 100%); color: white; overflow: hidden; }
.dashboard-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.dashboard-text h2 { font-family: var(--font-d); font-size: clamp(1.8rem, 3.4vw, 2.5rem); font-weight: 800; margin-bottom: 18px; }
.dashboard-text p { font-size: 1.02rem; line-height: 1.75; margin-bottom: 24px; opacity: 0.95; }
.dashboard-benefits { display: flex; flex-direction: column; gap: 12px; }
.benefit-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: rgba(255,255,255,0.12); border-radius: 12px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.18); transition: all 0.3s; }
.benefit-item:hover { background: rgba(255,255,255,0.2); transform: translateX(6px); }
.benefit-icon { font-size: 1.3rem; min-width: 28px; }
.benefit-text { font-size: 0.92rem; font-weight: 600; }

.dashboard-mockup { background: white; border-radius: 22px; overflow: hidden; box-shadow: 0 40px 90px rgba(0,0,0,0.3); animation: float 7s ease-in-out infinite; }
.dashboard-header { background: var(--text-dark); color: white; padding: 18px 22px; font-weight: 700; font-family: var(--font-d); display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem; }
.dashboard-header .live-pill { display: flex; align-items: center; gap: 6px; font-size: 0.7rem; font-weight: 600; background: rgba(9,184,80,0.2); padding: 4px 10px; border-radius: 20px; color: #6ee7a8; }
.dashboard-header .live-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #6ee7a8; animation: pulse 1.6s infinite; }

.dashboard-stats-row { display: flex; gap: 10px; padding: 18px 22px 4px; }
.dstat { flex: 1; background: var(--bg-light); border-radius: 12px; padding: 12px 14px; }
.dstat b { display: block; font-family: var(--font-d); font-size: 1.2rem; color: var(--text-dark); }
.dstat span { font-size: 0.66rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.03em; }

.dashboard-body { padding: 16px 22px 24px; color: var(--text-dark); }
.notification-item { padding: 14px 16px; background: var(--bg-light); border-left: 4px solid var(--g); border-radius: 10px; margin-bottom: 10px; transition: all 0.3s; cursor: pointer; }
.notification-item:hover { transform: translateX(6px); box-shadow: 0 10px 20px rgba(9,184,80,0.15); }
.notification-time { font-size: 0.68rem; color: var(--text-light); margin-bottom: 4px; font-weight: 600; }
.notification-text { font-size: 0.87rem; font-weight: 700; margin-bottom: 5px; }
.notification-status { display: inline-block; padding: 3px 11px; background: rgba(9,184,80,0.15); color: var(--g-dark); border-radius: 20px; font-size: 0.65rem; font-weight: 700; }

@media (max-width: 820px) { .dashboard-content { grid-template-columns: 1fr; } }

/* HOW IT WORKS TIMELINE */
.flow-section { padding: 100px 24px; background: white; }
.flow-timeline { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 36px; position: relative; }
.flow-timeline::before { content: ''; position: absolute; top: 44px; left: 8%; right: 8%; height: 2px; background: linear-gradient(90deg, var(--g), rgba(9,184,80,0.15), var(--g)); display: none; }
@media (min-width: 950px) { .flow-timeline::before { display: block; } }
.flow-step { text-align: center; position: relative; }
.flow-step-number { width: 76px; height: 76px; border-radius: 50%; background: linear-gradient(135deg, var(--g), #22c55e); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-d); font-size: 1.7rem; font-weight: 800; margin: 0 auto 20px; box-shadow: 0 12px 32px var(--g-glow); position: relative; z-index: 2; }
.flow-step h3 { font-family: var(--font-d); font-size: 1.06rem; font-weight: 700; margin-bottom: 10px; }
.flow-step p { font-size: 0.88rem; color: var(--text-light); line-height: 1.6; }

/* TRUST STRIP */
.trust-strip { padding: 60px 24px; background: var(--bg-light); }
.trust-content { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; }
.trust-item i { font-size: 1.6rem; color: var(--g); margin-bottom: 10px; }
.trust-item b { display: block; font-family: var(--font-d); font-size: 0.95rem; }
.trust-item span { font-size: 0.78rem; color: var(--text-light); }
@media (max-width: 700px) { .trust-content { grid-template-columns: repeat(2, 1fr); } }

/* FINAL CTA */
.cta-final { padding: 90px 24px; background: linear-gradient(135deg, var(--g), var(--g-dark)); color: white; text-align: center; position: relative; overflow: hidden; }
.cta-final::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.12), transparent 60%); }
.cta-final-content { max-width: 700px; margin: 0 auto; position: relative; z-index: 2; }
.cta-final h2 { font-family: var(--font-d); font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 800; margin-bottom: 16px; }
.cta-final p { font-size: 1.05rem; margin-bottom: 34px; opacity: 0.95; }
.btn-cta-primary { padding: 17px 40px; border-radius: 14px; border: none; background: white; color: var(--g-dark); font-family: var(--font-d); font-weight: 700; font-size: 1rem; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 14px 34px rgba(0,0,0,0.2); transition: all 0.3s; }
.btn-cta-primary:hover { transform: translateY(-4px); box-shadow: 0 20px 44px rgba(0,0,0,0.3); }

/* LOGIN MODAL */
.login-modal-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(255,255,255,0.7); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 20px; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
.login-modal-overlay.open { opacity: 1; pointer-events: auto; }

.login-modal-card { position: relative; background: rgba(255,255,255,0.95); backdrop-filter: blur(24px) saturate(140%); border: 1px solid rgba(0,0,0,0.1); border-radius: 24px; padding: 42px 40px; width: 100%; max-width: 430px; box-shadow: 0 30px 90px rgba(0,0,0,0.15); transform: translateY(24px) scale(0.96); opacity: 0; transition: transform 0.4s cubic-bezier(.16,.84,.24,1), opacity 0.35s ease; }
.login-modal-overlay.open .login-modal-card { transform: translateY(0) scale(1); opacity: 1; }

.modal-close-btn { position: absolute; top: 18px; right: 18px; width: 34px; height: 34px; border-radius: 50%; background: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.1); color: #7a7a7a; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
.modal-close-btn:hover { background: rgba(0,0,0,0.12); color: #1a1a1a; transform: rotate(90deg); }

.login-modal-card .brand { display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 22px; }
.login-modal-card .brand-icon { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, var(--g), #22c55e); display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 18px var(--g-glow); font-size: 1rem; color: #fff; }
.login-modal-card .brand span { font-family: var(--font-d); font-size: 1.15rem; font-weight: 800; color: #1a1a1a; }

.login-modal-card .owner-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.35); padding: 6px 15px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #b45309; margin-bottom: 16px; }
.login-modal-card .card-title { font-family: var(--font-d); font-size: 1.5rem; font-weight: 800; color: #1a1a1a; letter-spacing: -0.02em; margin-bottom: 5px; }
.login-modal-card .card-sub { font-size: 0.84rem; color: #7a7a7a; margin-bottom: 24px; line-height: 1.5; }

.login-modal-card .role-tabs { display: flex; background: rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.08); border-radius: 13px; padding: 4px; gap: 4px; margin-bottom: 20px; }
.login-modal-card .role-tab-input { display: none; }
.login-modal-card .role-tab-label { flex: 1; text-align: center; padding: 10px 8px; border-radius: 10px; font-size: 0.78rem; font-weight: 600; color: #7a7a7a; cursor: pointer; transition: all .25s; font-family: var(--font-b); }
.login-modal-card .role-tab-label:hover { color: #1a1a1a; }
.login-modal-card .role-tab-input:checked + .role-tab-label { background: linear-gradient(135deg, var(--g), #22c55e); color: #fff; box-shadow: 0 4px 14px var(--g-glow); }

.login-modal-card .input-group { margin-bottom: 15px; }
.login-modal-card .input-label { font-size: 0.78rem; font-weight: 600; color: #7a7a7a; display: block; margin-bottom: 6px; }
.login-modal-card .hn-input { width: 100%; padding: 13px 15px; border: 1.5px solid rgba(0,0,0,0.1); border-radius: 13px; font-family: var(--font-b); font-size: 0.88rem; color: #1a1a1a; background: rgba(255,255,255,0.8); outline: none; transition: all 0.25s; }
.login-modal-card .hn-input:hover { border-color: rgba(0,0,0,0.2); }
.login-modal-card .hn-input:focus { border-color: var(--g); box-shadow: 0 0 0 4px rgba(9,184,80,0.12); background: rgba(255,255,255,0.95); }
.login-modal-card .hn-input::placeholder { color: rgba(0,0,0,0.3); }

.login-modal-card .pass-wrap { position: relative; }
.login-modal-card .pass-wrap .hn-input { padding-right: 46px; }
.login-modal-card .pass-eye { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: #a0a0a0; cursor: pointer; font-size: 0.9rem; transition: color .2s; }
.login-modal-card .pass-eye:hover { color: var(--g); }

