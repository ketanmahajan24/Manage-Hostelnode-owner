<script async defer>
/* Navbar scroll effects */
const nav = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  nav.style.boxShadow = window.scrollY > 20 ? '0 4px 20px rgba(0,0,0,0.06)' : 'none';
}, { passive: true });

/* Scroll reveal animation */
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => { 
    if (e.isIntersecting) { 
      e.target.classList.add('in-view'); 
      io.unobserve(e.target); 
    } 
  });
}, { threshold: 0.15 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

/* Live demo auto-advance */
(function(){
  const scenes = document.querySelectorAll('#ldStage .story-scene');
  const steps  = document.querySelectorAll('#storySteps .story-step');
  const dots   = document.querySelectorAll('#ldDots i');
  if (!scenes.length) return;

  let i = 0;
  const SCENE_MS = 3400;

  function show(n){
    scenes.forEach(s => s.classList.remove('active'));
    steps.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    scenes[n].classList.add('active');
    if (steps[n]) steps[n].classList.add('active');
    if (dots[n])  dots[n].classList.add('active');
  }

  show(0);
  let timer = setInterval(() => {
    i = (i + 1) % scenes.length;
    show(i);
  }, SCENE_MS);

  const demoSection = document.querySelector('.live-demo-section');
  if (demoSection && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          if (!timer) timer = setInterval(() => { i = (i + 1) % scenes.length; show(i); }, SCENE_MS);
        } else {
          clearInterval(timer);
          timer = null;
        }
      });
    }, { threshold: 0.2 }).observe(demoSection);
  }
})();

/* Login Modal Handler */
const loginOverlay   = document.getElementById('loginModalOverlay');
const modalAlert     = document.getElementById('modalAlert');
const modalAlertText = document.getElementById('modalAlertText');

function openLoginModal(errorMsg) {
  if (errorMsg) {
    modalAlertText.textContent = errorMsg;
    modalAlert.style.display = 'flex';
  } else {
    modalAlert.style.display = 'none';
  }
  loginOverlay.classList.add('open');
  loginOverlay.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  setTimeout(() => document.querySelector('#modal-email').focus(), 350);
}

function closeLoginModal() {
  loginOverlay.classList.remove('open');
  loginOverlay.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

['navLoginBtn1', 'navLoginBtn2'].forEach(id => {
  const btn = document.getElementById(id);
  if (btn) btn.addEventListener('click', () => openLoginModal());
});

document.getElementById('modalCloseBtn').addEventListener('click', closeLoginModal);
loginOverlay.addEventListener('click', (e) => { if (e.target === loginOverlay) closeLoginModal(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && loginOverlay.classList.contains('open')) closeLoginModal(); });

document.getElementById('modalPassToggle').addEventListener('click', function () {
  const inp = document.getElementById('modalPassInput');
  inp.type = inp.type === 'password' ? 'text' : 'password';
  this.classList.toggle('fa-eye-slash');
  this.setAttribute('aria-label', inp.type === 'password' ? 'Show password' : 'Hide password');
});

/* Handle login errors from URL */
(function () {
  const params = new URLSearchParams(window.location.search);
  const err = params.get('loginError');
  if (err) {
    openLoginModal(err);
    params.delete('loginError');
    const clean = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    history.replaceState(null, '', clean);
  }
})();
</script>

