<% layout("/layouts/boilerplate") -%>

<style>

/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 25px;
}

/* 🌟 Title */
.revenue-heading {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
    margin-bottom: 15px;
}

/* 🌟 Search */
.search-box {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
}

.search-box input {
    flex: 1;
    border-radius: 10px;
    border: 1px solid #CBD5E1;
    padding: 10px;
}

.search-box input:focus {
    border-color: #09B850;
    box-shadow: 0 0 0 3px rgba(9,184,80,0.15);
    outline: none;
}

.search-btn {
    background: linear-gradient(135deg, #09B850, #22C55E);
    border: none;
    color: white;
    padding: 10px 18px;
    border-radius: 10px;
}

/* 🌟 Table Wrapper */
.table-wrapper {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);

    overflow-x: auto;
    animation: fadeUp 0.5s ease;
}

/* 🌟 Scrollbar */
.table-wrapper::-webkit-scrollbar {
    height: 6px;
}
.table-wrapper::-webkit-scrollbar-thumb {
    background: #09b84f3a;
    border-radius: 10px;
}

/* 🌟 Table */
table {
    width: 100%;
    min-width: 1200px;
    border-collapse: collapse;
}

/* 🌟 Header */
th {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: white;
    padding: 14px;
    font-size: 13px;
    text-align: left;
}

/* 🌟 Sticky header */
thead th {
    position: sticky;
    top: 0;
    z-index: 2;
}

/* 🌟 Rows */
td {
    padding: 14px;
    font-size: 14px;
    border-bottom: 1px solid #F1F5F9;
}

/* 🌟 Sticky first column */
td:first-child, th:first-child {
    position: sticky;
    left: 0;
    background: #fff;
    z-index: 1;
}

/* 🌟 Hover */
tbody tr:hover {
    background: #F8FAFC;
}

/* 🌟 Name */
.member-name {
    font-weight: 600;
}

/* 🌟 Status */
.badge-active {
    background: #09B85015;
    color: #09B850;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
}

.badge-inactive {
    background: #EF444415;
    color: #EF4444;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
}

/* 🌟 Buttons */
.action-btn {
    border: none;
    background: transparent;
    cursor: pointer;
}

.icon-edit { color: #09B850; }
.icon-delete { color: #EF4444; }

/* 🌟 Animation */
@keyframes fadeUp {
    from {opacity:0; transform:translateY(20px);}
    to {opacity:1; transform:translateY(0);}
}

/* 🌟 Responsive */
@media(max-width:900px){
    th, td {
        padding: 10px;
        font-size: 12px;
    }
}

</style>

<div class="main-body-page">

    <h3 class="revenue-heading">All Members</h3>

    <!-- 🔍 Search -->
    <form action="/user/member/search" method="POST" class="search-box">
        <input name="name" type="text" placeholder="Enter Name or Mobile..." required>
        <button class="search-btn">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </form>

    <!-- Table -->
    <div class="table-wrapper">
        <table>

            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Name</th>
                    <th>Father</th>
                    <th>Mobile</th>
                    <th>Aadhar</th>
                    <th>Address</th>
                    <th>Profession</th>
                    <th>Joining</th>
                    <th>Room</th>
                    <th>Fees</th>
                    <th>Status</th>
                    <th>Left</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                <% allMembers.forEach((Member, index) => { %>

                <tr>
                    <td><%= index + 1 %></td>

                    <td class="member-name"><%= Member.name %></td>
                    <td><%= Member.fatherName %></td>
                    <td><%= Member.mobileNo %></td>
                    <td><%= Member.aadharNo %></td>
                    <td><%= Member.address %></td>
                    <td><%= Member.profession %></td>
                    <td><%= Member.joiningDate.toLocaleDateString("en-GB") %></td>
                    <td><%= Member.assignedRoom %></td>

                    <td>
                        <% if (Member.payments.length > 0){ %> 
                            ₹<%= Member.payments[0].roomFees %>
                        <% } else { %> 
                            N/A
                        <% } %>
                    </td>

                    <td>
                        <% if(Member.status === "Active"){ %>
                            <span class="badge-active">Active</span>
                        <% } else { %>
                            <span class="badge-inactive">Inactive</span>
                        <% } %>
                    </td>

                    <td>
                        <%= Member.leftDate 
                        ? Member.leftDate.toLocaleDateString("en-GB") 
                        : "-" %>
                    </td>

                    <!-- Edit -->
                    <td>
                        <a href="/user/member-edit/<%=Member._id%>/edit">
                            <button class="action-btn">
                                <i class="fa-solid fa-pen-to-square icon-edit"></i>
                            </button>
                        </a>
                    </td>

                    <!-- Delete -->
                    <td>
                        <form method="POST" action="/user/member/<%=Member._id%>?_method=DELETE">
                            <button class="action-btn">
                                <i class="fa-solid fa-trash icon-delete"></i>
                            </button>
                        </form>
                    </td>

                </tr>

                <% }); %>
            </tbody>

        </table>
    </div>

</div>