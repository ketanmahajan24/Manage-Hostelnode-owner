<% layout("/layouts/boilerplate") -%>

<style>
/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 25px;
}

/* 🌟 Header */
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.page-title {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
}

/* 🌟 Table Wrapper */
.table-wrapper {
    background: #FFFFFF ;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
    animation: fadeUp 0.5s ease;
}

/* 🌟 Table */
table {
    width: 100%;
    border-collapse: collapse;
}

/* 🌟 Header */
thead {
    background: #f3f9f1;
}

th {
    background-color: #09B850;
    text-align: left;
    padding: 14px 16px;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    border-bottom: 1px solid #E2E8F0;
}

/* 🌟 Rows */
td {
    padding: 14px 16px;
    font-size: 14px;
    color: #0F172A;
    border-bottom: 1px solid #F1F5F9;
}

/* 🌟 Row Hover */
tbody tr {
    transition: 0.25s;
    animation: fadeInUp 0.4s ease both;
}

tbody tr:hover {
    background: #F8FAFC;
}

/* 🌟 Name Highlight */
.member-name {
    font-weight: 600;
}

/* 🌟 Badge */
.badge-active {
    background: #09B85015;
    color: #09B850;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
}

/* 🌟 Action Button */
.btn-action {
    border: none;
    padding: 6px 12px;
    border-radius: 8px;
    background: #EF4444;
    color: #fff;
    font-size: 12px;
    transition: 0.3s;
}

.btn-action:hover {
    background: #DC2626;
    transform: translateY(-1px);
}

/* 🌟 Animations */
@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 🌟 Responsive */
@media(max-width: 900px){
    table {
        font-size: 12px;
    }
    th, td {
        padding: 10px;
    }
}
/* 🌟 Table Wrapper */
.table-wrapper {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);

    overflow-x: auto;   /* ✅ horizontal scroll */
    overflow-y: hidden; /* optional */

    animation: fadeUp 0.5s ease;
}

/* 🌟 Table */
table {
    width: 100%;
    min-width: 900px;  /* ✅ forces scroll on small screens */
    border-collapse: collapse;
}
</style>

<div class="main-body-page">

    <!-- Header -->
    <div class="page-header">
        <div class="page-title">
            <i class="fa-solid fa-users" style="color:#09B850;"></i>
            Active Members
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
        <table>

            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Father</th>
                    <th>Mobile</th>
                    <th>Room</th>
                    <th>Profession</th>
                    <th>Joining</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% allMembers.filter(member => member.status === "Active").forEach((Member, index) => { %>

                <tr>
                    <td><%= index + 1 %></td>

                    <td class="member-name">
                        <%= Member.name %>
                    </td>

                    <td><%= Member.fatherName %></td>
                    <td><%= Member.mobileNo %></td>
                    <td><%= Member.assignedRoom %></td>
                    <td><%= Member.profession %></td>
                    <td><%= Member.joiningDate.toLocaleDateString("en-GB") %></td>

                    <td>
                        <span class="badge-active">Active</span>
                    </td>

                    <td>
                        <a href="/user/activeMember/<%=Member._id %>">
                            <button class="btn-action">
                                <i class="fa-solid fa-user-slash"></i>
                            </button>
                        </a>
                    </td>
                </tr>

                <% }); %>
            </tbody>

        </table>
    </div>

</div>