<% layout("/layouts/boilerplate") -%>

<style>
/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 20px;
    border-radius: 10px;
    animation: fadeIn 0.5s ease;
}

/* 🌟 Heading */
.new-form-heading {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
}

/* 🌟 Back Button */
.btn-back {
    color: #09B850;
    border: 1px solid #09B850;
    border-radius: 30px;
    padding: 6px 14px;
    transition: 0.3s;
}
.btn-back:hover {
    background: #09B850;
    color: #fff;
    transform: translateY(-2px);
}

/* 🌟 Card */
.student-box {
    background: #FFFFFF;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    animation: slideUp 0.5s ease;
}

/* 🌟 Inputs */
.form-control,
.form-select {
    border-radius: 10px;
    border: 1px solid #CBD5E1;
    padding: 10px;
    transition: 0.25s;
    background: #FFFFFF;
    color: #0F172A;
}

/* hover */
.form-control:hover,
.form-select:hover {
    border-color: #22C55E;
}

/* focus */
.form-control:focus,
.form-select:focus {
    border-color: #09B850;
    box-shadow: 0 0 0 3px rgba(9,184,80,0.15);
}

/* 🌟 Labels */
.form-label {
    color: #475569;
    font-weight: 500;
}

/* 🌟 Button */
.btn-submit {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: #fff;
    border-radius: 30px;
    padding: 12px;
    border: none;
    font-weight: 600;
    transition: 0.3s;
}

/* hover */
.btn-submit:hover {
    background: linear-gradient(135deg, #059669, #16A34A);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(9,184,80,0.25);
}

/* 🌟 HR */
hr {
    border-color: #E2E8F0;
}

/* 🌟 Animations */
@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 🌟 Stagger animation */
.col-md-4, .col-md-6 {
    animation: fadeInUp 0.4s ease both;
}

.col-md-4:nth-child(1) { animation-delay: 0.05s; }
.col-md-4:nth-child(2) { animation-delay: 0.1s; }
.col-md-4:nth-child(3) { animation-delay: 0.15s; }
.col-md-4:nth-child(4) { animation-delay: 0.2s; }
.col-md-6:nth-child(5) { animation-delay: 0.25s; }

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>

<br><br>

<div class="main-body-page">
    
    <div class="d-flex gap-2 cols m-1">
        <div class="col-7">
            <p class="new-form-heading">Add New Member</p>
        </div>

        <div class="col-6">
            <a href="./" class="col-8 btn btn-back">
                <i class="fa-solid fa-chevron-left"></i> Back
            </a>
        </div>
    </div>

<hr>

    <div class="container student-box">
        <form method="POST" action="/user/newMember" class="row g-4 needs-validation">
            
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <input type="text" name="member[name]" class="form-control" required>
            </div>
            
            <div class="col-md-4">
                <label class="form-label">Father's Name</label>
                <input type="text" name="member[fatherName]" class="form-control" required>
            </div>
            
            <div class="col-md-4">
                <label class="form-label">Mobile No.</label>
                <input type="number" name="member[mobileNo]" class="form-control" required>
            </div>
            
            <div class="col-md-4">
                <label class="form-label">Aadhar No.</label>
                <input type="number" name="member[aadharNo]" class="form-control" required>
            </div>
            
            <div class="col-md-6">
                <label class="form-label">Address</label>
                <input type="text" name="member[address]" class="form-control" required>
            </div>
            
            <div class="col-md-4">
                <label class="form-label">Joining Date</label>
                <input type="date" name="member[joiningDate]" class="form-control" id="joinDate" required>
            </div>

            <div class="col-md-4">
                <label class="form-label">Assigned Room</label>
                <select name="member[assignedRoom_id]" class="form-select" required>
                    <option value="">Select Room To Assign</option>
                    <% rooms.forEach(room => { %>
                    <option value="<%= room._id %>">
                        <%= room.room_number %> / ₹<%= room.room_fees %>
                    </option>
                    <% }) %>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Profession</label>
                <select name="member[profession]" class="form-select" required>
                    <option value="">Select Profession</option>
                    <option value="Student">Student</option>
                    <option value="Employee">Employee</option>
                    <option value="Business">Business</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            
            <div class="col-12 d-flex justify-content-center">
                <button type="submit" class="col-6 btn btn-submit">
                    <i class="fa-solid fa-user-plus me-2"></i> Add Member
                </button>
            </div>
        </form>
    </div>
</div>

<script>
let today = new Date();
let day = String(today.getDate()).padStart(2, '0');
let month = String(today.getMonth() + 1).padStart(2, '0'); 
let year = today.getFullYear();
document.getElementById("joinDate").value = `${year}-${month}-${day}`;
</script>