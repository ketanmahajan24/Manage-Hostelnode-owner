<% layout("/layouts/boilerplate") -%>

<style>

/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 25px;
}

/* 🌟 Top Controls */
.top-controls {
    background: #FFFFFF;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    animation: fadeDown 0.4s ease;
}

/* 🌟 Add Floor Button */
.btn-add-floor {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: white;
    border-radius: 12px;
    padding: 12px;
    border: none;
    font-weight: 500;
    text-align: center;
    transition: all 0.3s ease;
}

.btn-add-floor:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 10px 25px rgba(9,184,80,0.25);
}

/* 🌟 Grid */
.card-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 22px;
}

/* 🌟 Card */
.card-3 {
    background: #FFFFFF;
    border-radius: 18px;
    padding: 18px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

/* 🔥 Glow effect */
.card-3::before {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    background: radial-gradient(circle, rgba(9,184,80,0.08) 0%, transparent 70%);
    opacity: 0;
    transition: 0.4s;
}

.card-3:hover::before {
    opacity: 1;
}

/* Hover */
.card-3:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
}

/* 🌟 Floor Title */
.floor-title {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: white;
    border-radius: 10px;
    padding: 8px;
    font-size: 15px;
    text-align: center;
    font-weight: 600;
    letter-spacing: 0.3px;
}

/* 🌟 Stats */
.floor-stat {
    background: #F1F5F9;
    border-radius: 10px;
    padding: 10px;
    margin-top: 10px;
    transition: 0.3s;
}

/* subtle hover inside card */
.floor-stat:hover {
    background: #E2E8F0;
}

/* 🌟 Numbers */
.stat-number {
    font-size: 20px;
    font-weight: bold;
    color: #0F172A;
}

/* 🌟 Labels */
.stat-label {
    font-size: 12px;
    color: #64748B;
}

/* 🌟 Icons */
.fa-square-check {
    color: #09B850;
}

/* 🌟 Animation (stagger) */
.card-3 {
    animation: fadeUp 0.5s ease both;
}

.card-3:nth-child(1) { animation-delay: 0.05s; }
.card-3:nth-child(2) { animation-delay: 0.1s; }
.card-3:nth-child(3) { animation-delay: 0.15s; }
.card-3:nth-child(4) { animation-delay: 0.2s; }

/* 🌟 Animations */
@keyframes fadeUp {
    from {opacity: 0; transform: translateY(25px);}
    to {opacity: 1; transform: translateY(0);}
}

@keyframes fadeDown {
    from {opacity: 0; transform: translateY(-20px);}
    to {opacity: 1; transform: translateY(0);}
}

/* 🌟 Responsive */
@media(max-width:768px){
    .top-controls {
        flex-direction: column;
        gap: 10px;
    }

    .btn-add-floor {
        width: 100%;
    }
}

</style>


<div class="main-body-page">

    <br><br>

    <!-- Top Controls -->
    <div class="top-controls d-flex justify-content-center">
        <a href="/user/newfloor" class="btn-add-floor col-10">
            <i class="fa-solid fa-plus"></i> Add Floor
        </a>
    </div>

    <br>

    <!-- Cards -->
    <div class="card-container"> 

        <% for (let Floor of allFloors){%>   

        <div class="card card-3">

            <!-- Title -->
            <div class="floor-title">
                Floor - <%=Floor.floor_name%>
            </div>

            <!-- Rooms -->
            <div class="floor-stat">
                <div class="stat-number">
                    <%=Floor.occupied_rooms%> 
                    <i class="fa-solid fa-square-check"></i>
                </div>
                <div class="stat-label">
                    Rooms : <b><%=Floor.total_rooms%></b>
                </div>
            </div>

            <!-- Beds -->
            <div class="floor-stat">
                <div class="stat-number">
                    <%=Floor.occupied_beds%> 
                    <i class="fa-solid fa-square-check"></i>
                </div>
                <div class="stat-label">
                    Beds : <b><%=Floor.total_beds%></b>
                </div>
            </div>

            <!-- Members -->
            <div class="floor-stat">
                <div class="stat-number">
                    <%=Floor.active_number%> 
                    <i class="fa-solid fa-square-check"></i>
                </div>
                <div class="stat-label">
                    Active Members
                </div>
            </div>

        </div>

        <%}%>        

    </div>

</div>