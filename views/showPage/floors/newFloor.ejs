<% layout("/layouts/boilerplate") -%>

<style>
/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 20px;
    border-radius: 10px;
    animation: fadeIn 0.5s ease;
}

/* 🌟 Heading */
.new-form-heading {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
}

/* 🌟 Back Button */
.btn-back {
    color: #09B850;
    border: 1px solid #09B850;
    border-radius: 30px;
    padding: 6px 14px;
    transition: 0.3s;
}
.btn-back:hover {
    background: #09B850;
    color: #fff;
    transform: translateY(-2px);
}

/* 🌟 Card */
.student-box {
    background: #FFFFFF;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    animation: slideUp 0.5s ease;
}

/* 🌟 Inputs */
.form-select {
    border-radius: 10px;
    border: 1px solid #CBD5E1;
    padding: 10px;
    transition: 0.25s;
    background: #FFFFFF;
    color: #0F172A;
}

/* hover */
.form-select:hover {
    border-color: #22C55E;
}

/* focus */
.form-select:focus {
    border-color: #09B850;
    box-shadow: 0 0 0 3px rgba(9,184,80,0.15);
}

/* 🌟 Labels */
.form-label {
    color: #475569;
    font-weight: 500;
}

/* 🌟 Button */
.btn-submit {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: #fff;
    border-radius: 30px;
    padding: 12px;
    border: none;
    font-weight: 600;
    transition: 0.3s;
}

.btn-submit:hover {
    background: linear-gradient(135deg, #059669, #16A34A);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(9,184,80,0.25);
}

/* 🌟 HR */
hr {
    border-color: #E2E8F0;
}

/* 🌟 Animations */
@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 🌟 Select Animation */
.col-12 {
    animation: fadeInUp 0.4s ease both;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>

<br>

<div class="main-body-page">

    <div class="d-flex gap-2 cols m-1">
        <div class="col-7">
            <p class="new-form-heading">Add New Floor</p>
        </div>

        <div class="col-6">
            <a href="./" class="col-8 btn btn-back">
                <i class="fa-solid fa-chevron-left"></i> Back
            </a>
        </div>
    </div>

<hr>

    <div class="container student-box">

        <form method="POST" action="/user/newfloor" class="row g-4 needs-validation">

            <!-- FLOOR SELECT -->
            <div class="col-12">
                <label class="form-label">Floor Name</label>

                <select name="floor[floor_name]" class="form-select" required>
                    <option value="">Select Floor</option>
                    <option value="G">Ground Floor</option>
                    <option value="1">1st Floor</option>
                    <option value="2">2nd Floor</option>
                    <option value="3">3rd Floor</option>
                    <option value="4">4th Floor</option>
                    <option value="5">5th Floor</option>
                    <option value="6">6th Floor</option>
                    <option value="7">7th Floor</option>
                    <option value="8">8th Floor</option>
                    <option value="9">9th Floor</option>
                    <option value="10">10th Floor</option>
                </select>
            </div>

            <!-- BUTTON -->
            <div class="col-12 d-flex justify-content-center">
                <button type="submit" class="col-6 btn btn-submit">
                    <i class="fa-solid fa-layer-group me-2"></i> Add Floor
                </button>
            </div>

        </form>
    </div>
</div>