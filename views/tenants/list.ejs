<% layout("/layouts/boilerplate") -%>
<%# Property Operations Phase 3 — Tenants: Living / Moving out / Moved out, with search and filters. %>
<%- include("../account/_style.ejs") %>
<%- include("_style.ejs") %>
<%
  const PHONE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>';
  const CHAT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5z"/></svg>';
  const qs = function (o) { const p = Object.assign({ tab: tab, q: q, floor: floorId, dues: onlyDues ? "1" : "", kyc: onlyNoKyc ? "none" : "" }, o); return "/user/members?" + Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + "=" + encodeURIComponent(p[k]); }).join("&"); };
  const filtered = !!(q || floorId || onlyDues || onlyNoKyc);
%>
<style>
  .hn3-sum { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
  .hn3-sum .hn2a-card { padding: 16px 18px; margin: 0; display: block; color: inherit; }
  .hn3-sum b { display: block; font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
  .hn3-sum span { font-size: 13px; font-weight: 600; color: var(--hn-soft); }
  .hn3-sum .is-due { background: #fff6f5; border-color: #f6c3be; }
  .hn3-sum .is-due b { color: var(--hn-coral); }
  .hn3-sum .is-clear b { color: var(--hn-green); }
  .hn3-bar { display: flex; gap: 10px; align-items: center; margin: 14px 0; flex-wrap: wrap; }
  .hn3-search { flex: 1; min-width: 220px; max-width: 380px; position: relative; }
  .hn3-search input { padding-left: 38px !important; }
  .hn3-search svg { position: absolute; left: 13px; top: 14px; width: 16px; height: 16px; color: var(--hn-soft); }
  .hn3-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; padding: 0 13px; height: 38px; border-radius: 99px; background: #fff; border: 1px solid #cfdcd5; color: var(--hn-body); cursor: pointer; }
  .hn3-chip input { width: 15px; height: 15px; accent-color: var(--hn-green-bright); margin: 0; }
  .hn3-chip.is-on { border-color: var(--hn-green); background: var(--hn-green-tint); color: var(--hn-green); }
  select.hn3-chip { appearance: auto; padding-right: 8px; }
  .hn3-clear { font-size: 13px; font-weight: 700; color: var(--hn-green); }
  .hn3-list { padding: 0; overflow: hidden; }
  .hn3-r { display: grid; grid-template-columns: minmax(220px, 2.3fr) 0.9fr 1fr 1.3fr 0.9fr auto; align-items: center; gap: 12px; padding: 13px 18px; border-bottom: 1px solid #eef4f1; font-size: 14px; font-weight: 600; color: var(--hn-ink); }
  .hn3-r:last-child { border-bottom: 0; }
  .hn3-r.is-h { font-size: 12px; color: var(--hn-soft); background: #f5faf7; padding: 11px 18px; }
  .hn3-r small { display: block; font-size: 12.5px; color: var(--hn-soft); font-weight: 500; margin-top: 2px; }
  .hn3-r .is-bad small, .hn3-r .is-bad { color: var(--hn-coral); }
  .hn3-r .is-ok { color: var(--hn-green); }
  .hn3-r .is-soft { color: var(--hn-soft); }
  .hn3-who { display: flex; gap: 12px; align-items: center; min-width: 0; }
  .hn3-who a.n { color: var(--hn-ink); font-weight: 700; }
  .hn3-who a.n:hover { color: var(--hn-green); }
  .hn3-acts { display: flex; gap: 6px; justify-content: flex-end; }
  .hn3-r .hn3-pill { justify-self: start; }
  .hn3-lbl { display: none; }
  .hn3-empty { text-align: center; padding: 44px 20px; }
  .hn3-empty b { display: block; font-size: 17px; margin-bottom: 6px; }
  .hn3-empty p { color: var(--hn-soft); font-size: 14px; font-weight: 500; margin: 0 0 16px; }
  .hn3-fab { display: none; }
  @media (max-width: 1023px) {
    .hn3-sum { grid-template-columns: repeat(2, 1fr); }
    .hn3-list { background: transparent; border: 0; box-shadow: none; }
    .hn3-r.is-h { display: none; }
    .hn3-r { grid-template-columns: 1fr auto; gap: 8px 12px; background: #fff; border: 1px solid var(--hn-line); border-radius: 16px; margin-bottom: 10px; padding: 14px; }
    .hn3-r:last-child { border-bottom: 1px solid var(--hn-line); }
    .hn3-r .c-room, .hn3-r .c-rent { display: none; }
    .hn3-r .c-who { grid-column: 1 / 2; }
    .hn3-r .c-kyc { grid-column: 2; grid-row: 1; align-self: start; }
    .hn3-r .c-month { grid-column: 1 / -1; }
    .hn3-r .c-acts { grid-column: 1 / -1; }
    .hn3-acts { display: grid; grid-template-columns: 1fr 1fr 1fr; }
    .hn3-acts .hn3-ic, .hn3-acts .hn2a-btn { width: 100%; height: 40px; }
    .hn3-lbl { display: inline; }
    .hn3-ic .hn3-lbl { margin-left: 6px; font-size: 13px; font-weight: 700; }
    .hn3-fab { display: flex; position: sticky; bottom: 12px; margin-top: 12px; }
    .hn3-fab .hn2a-btn { width: 100%; min-height: 48px; }
    .hn3-headbtn { display: none !important; }
  }
  .hn3-r small.hn3-sub-room { display: none; }
  @media (max-width: 1023px) { .hn3-r small.hn3-sub-room { display: block; } }
</style>

<div class="hn2a hn3">
  <div class="hn2a-inner">
    <div class="hn3-head">
      <div>
        <h1 class="hn2a-title">Tenants</h1>
        <div class="hn2a-sub"><%= hostelName %> · <%= summary.living %> living<% if (summary.notice) { %> · <%= summary.notice %> moving out<% } %></div>
      </div>
      <% if (hasBeds) { %><a class="hn2a-btn hn3-headbtn" href="/user/newmember">+ Add tenant</a><% } %>
    </div>
    <% if (flash.msg) { %><div class="hn2a-notice is-ok" role="status"><%= flash.msg %></div><% } %>
    <% if (flash.err) { %><div class="hn2a-notice is-bad" role="alert"><%= flash.err %></div><% } %>

    <% if (!hasBeds && !summary.living && !summary.out) { %>
      <div class="hn2a-card hn3-empty">
        <b>Add your rooms first</b>
        <p>Tenants are admitted into a bed. Add your floors and rooms, then add tenants.</p>
        <a class="hn2a-btn" href="/user/newroom">+ Add rooms</a>
      </div>
    <% } else { %>

    <div class="hn3-sum">
      <div class="hn2a-card"><b><%= summary.living %></b><span>Living now</span></div>
      <a class="hn2a-card <%= summary.dueTotal ? 'is-due' : 'is-clear' %>" href="<%= qs({ tab: 'living', dues: '1' }) %>">
        <b><%= summary.dueTotal ? T.inr(summary.dueTotal) : "₹0" %></b>
        <span><%= summary.dueTotal ? ("Due from " + summary.dueCount + (summary.dueCount === 1 ? " tenant" : " tenants")) : "Nothing due right now" %></span>
      </a>
      <a class="hn2a-card" href="<%= qs({ tab: 'notice', dues: '', kyc: '' }) %>"><b><%= summary.notice %></b><span>Moving out soon</span></a>
      <a class="hn2a-card" href="<%= qs({ tab: 'living', kyc: 'none' }) %>"><b><%= summary.noKyc %></b><span>KYC not done</span></a>
    </div>

    <nav class="hn3-tabs" aria-label="Tenants">
      <a href="<%= qs({ tab: 'living' }) %>" <%- tab === 'living' ? 'aria-current="page"' : '' %>>Living<em><%= summary.living %></em></a>
      <a href="<%= qs({ tab: 'notice' }) %>" <%- tab === 'notice' ? 'aria-current="page"' : '' %>>Moving out<em><%= summary.notice %></em></a>
      <a href="<%= qs({ tab: 'out' }) %>" <%- tab === 'out' ? 'aria-current="page"' : '' %>>Moved out<em><%= summary.out %></em></a>
    </nav>

    <form class="hn3-bar" method="GET" action="/user/members" role="search" data-autosubmit>
      <input type="hidden" name="tab" value="<%= tab %>">
      <label class="hn3-search"><span class="visually-hidden" style="position:absolute;left:-9999px">Search tenants</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input class="hn2a-input" type="search" name="q" value="<%= q %>" placeholder="Search name, mobile or room" maxlength="60" style="height:40px">
      </label>
      <% if (floors.length > 1) { %>
        <select class="hn3-chip" name="floor" aria-label="Floor">
          <option value="">All floors</option>
          <% floors.forEach(function (f) { %><option value="<%= f.id %>" <%= floorId === f.id ? "selected" : "" %>><%= f.name %></option><% }) %>
        </select>
      <% } %>
      <label class="hn3-chip <%= onlyDues ? 'is-on' : '' %>"><input type="checkbox" name="dues" value="1" <%= onlyDues ? "checked" : "" %>> Has dues</label>
      <label class="hn3-chip <%= onlyNoKyc ? 'is-on' : '' %>"><input type="checkbox" name="kyc" value="none" <%= onlyNoKyc ? "checked" : "" %>> KYC not done</label>
      <button type="submit" class="hn2a-btn is-ghost is-sm" data-nojs>Search</button>
      <% if (filtered) { %><a class="hn3-clear" href="/user/members?tab=<%= tab %>">Clear</a><% } %>
    </form>

    <% if (!rows.length) { %>
      <div class="hn2a-card hn3-empty">
        <% if (filtered) { %>
          <b>No tenants match</b><p>Try another name, mobile or room, or clear the filters.</p><a class="hn2a-btn is-ghost" href="/user/members?tab=<%= tab %>">Clear filters</a>
        <% } else if (tab === "notice") { %>
          <b>Nobody is moving out</b><p>When a tenant gives notice, set their leaving date on their page. They show here until they move out.</p>
        <% } else if (tab === "out") { %>
          <b>No one has moved out yet</b><p>Tenants you move out are kept here with their settlement slip.</p>
        <% } else { %>
          <b>Add your first tenant</b><p>Pick a free bed, enter their details and rent. It takes about a minute.</p><a class="hn2a-btn" href="/user/newmember">+ Add tenant</a>
        <% } %>
      </div>
    <% } else { %>
    <div class="hn2a-card hn3-list" role="table" aria-label="Tenants">
      <div class="hn3-r is-h" role="row"><span role="columnheader">Tenant</span><span role="columnheader">Room · bed</span><span role="columnheader">Rent</span><span role="columnheader"><%= tab === "out" ? "Money" : "This month" %></span><span role="columnheader">KYC</span><span role="columnheader"><span style="position:absolute;left:-9999px">Actions</span></span></div>
      <% rows.forEach(function (r) { %>
      <div class="hn3-r" role="row">
        <div class="hn3-who c-who" role="cell">
          <span class="hn3-ini c-<%= r.tone %>" aria-hidden="true"><%= r.initials %></span>
          <div style="min-width:0">
            <a class="n" href="/user/tenants/<%= r.id %>"><%= r.name %></a>
            <% if (r.leavingPassed) { %> <span class="hn3-pill t-bad" title="The leaving date has passed. Move them out, or change the date.">Was leaving <%= r.leaving %></span><% } else if (r.leaving) { %> <span class="hn3-pill t-warn">Leaving <%= r.leaving %></span><% } %>
            <% if (r.fromLead && tab !== "out") { %> <span class="hn3-pill t-violet">From lead</span><% } %>
            <small><%= r.mobileMasked %> · <%= tab === "out" ? ("moved out " + r.left) : ("since " + r.since) %></small>
            <small class="hn3-sub-room">Room <%= r.room %><%= r.bed ? " · bed " + r.bed : "" %> · <%= T.inr(r.rent) %><%= r.dueDay ? " on " + T.ordinal(r.dueDay) : "" %></small>
          </div>
        </div>
        <div class="c-room" role="cell"><%= r.room %><%= r.bed ? " · " + r.bed : "" %><% if (r.floor) { %><small><%= r.floor %></small><% } %></div>
        <div class="c-rent" role="cell"><%= T.inr(r.rent) %><% if (r.dueDay && tab !== "out") { %><small>due on <%= T.ordinal(r.dueDay) %></small><% } %></div>
        <div class="c-month is-<%= r.money.state.tone %>" role="cell"><%= tab === "out" && r.money.due === 0 ? "Settled ✓" : r.money.state.text %><% if (r.money.state.sub) { %><small><%= r.money.state.sub %></small><% } %></div>
        <div class="c-kyc" role="cell"><span class="hn3-pill <%= r.kyc ? 't-ok' : 't-warn' %>"><%= r.kyc ? "Verified" : "Not done" %></span></div>
        <div class="hn3-acts c-acts" role="cell">
          <a class="hn3-ic" href="tel:+91<%= r.mobile %>" aria-label="Call <%= r.name %>"><%- PHONE %><span class="hn3-lbl">Call</span></a>
          <a class="hn3-ic" href="https://wa.me/91<%= r.mobile %>" target="_blank" rel="noopener" aria-label="WhatsApp <%= r.name %>"><%- CHAT %><span class="hn3-lbl">WhatsApp</span></a>
          <a class="hn2a-btn is-ghost is-sm" href="/user/tenants/<%= r.id %>">Open</a>
        </div>
      </div>
      <% }) %>
    </div>
    <% if (tab === "out" && rows.length >= 300) { %><div class="hn2a-help">Showing the 300 most recent. Search to find someone older.</div><% } %>
    <% } %>
    <% if (hasBeds) { %><div class="hn3-fab"><a class="hn2a-btn" href="/user/newmember">+ Add tenant</a></div><% } %>
    <% } %>
  </div>
</div>
<script>
(function () {
  var f = document.querySelector('[data-autosubmit]'); if (!f) return;
  var b = f.querySelector('[data-nojs]'); if (b) b.style.display = 'none';
  f.querySelectorAll('select, input[type=checkbox]').forEach(function (x) { x.addEventListener('change', function () { f.submit(); }); });
})();
</script>
