<%# Redesign Phase 4 — shared styles for the account pages (Settings, Billing, KYC, Notifications). %>
<style>
  .hn2a, .hn2a * { box-sizing: border-box; font-family: 'DM Sans', sans-serif; }
  .hn2a { background: #f7f8fa; min-height: calc(100vh - var(--nav-h, 64px)); padding: 28px 32px 40px; color: #12151a; }
  .hn2a a, .hn2a a:hover { text-decoration: none; }
  .hn2a-inner { max-width: 760px; }
  .hn2a .hn2a-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; margin: 0; color: #12151a; letter-spacing: -0.01em; }
  .hn2a-sub { font-size: 13px; color: #667085; margin: 4px 0 20px; font-weight: 500; }
  .hn2a-notice { margin-bottom: 16px; padding: 10px 14px; border-radius: 10px; font-size: 13px; font-weight: 600; }
  .hn2a-notice.is-ok { background: #e8f9f0; border: 1px solid #bfeed3; color: #0a7d4c; }
  .hn2a-notice.is-bad { background: #fef3f2; border: 1px solid #fecdca; color: #b42318; }
  .hn2a-card { background: #fff; border: 1px solid #eef1f4; border-radius: 14px; padding: 20px; box-shadow: 0 1px 2px rgba(15,17,23,0.03); margin-bottom: 16px; }
  .hn2a-card-title { font-size: 15px; font-weight: 800; color: #12151a; margin: 0 0 4px; }
  .hn2a-card-sub { font-size: 12.5px; color: #667085; font-weight: 500; margin-bottom: 16px; }
  .hn2a-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .hn2a-field { margin-bottom: 14px; }
  .hn2a-label { display: block; font-size: 12.5px; font-weight: 700; color: #344054; margin-bottom: 6px; }
  .hn2a-input, .hn2a-select {
    width: 100%; max-width: 380px; height: 40px; border: 1px solid #d0d5dd; border-radius: 9px; padding: 0 12px;
    font-size: 13.5px; color: #12151a; background: #fff;
  }
  .hn2a-input:focus, .hn2a-select:focus { outline: none; border-color: #0EA968; box-shadow: 0 0 0 3px rgba(14,169,104,0.18); }
  .hn2a-file { font-size: 13px; }
  .hn2a-help { font-size: 12px; color: #98a2b3; font-weight: 500; margin-top: 5px; }
  .hn2a-btn, .hn2a-btn:hover, .hn2a-btn:focus {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 9px 16px; border-radius: 10px;
    background: #0EA968; color: #fff; font-size: 13px; font-weight: 700; border: 0; cursor: pointer; box-shadow: 0 1px 2px rgba(14,169,104,0.28);
  }
  .hn2a-btn:hover { background: #0c9a5f; }
  .hn2a-btn.is-ghost, .hn2a-btn.is-ghost:hover { background: #fff; color: #344054; border: 1px solid #d0d5dd; box-shadow: none; }
  .hn2a-btn.is-ghost:hover { background: #f6f8fa; }
  .hn2a-pill { display: inline-block; font-size: 10.5px; font-weight: 800; letter-spacing: 0.03em; padding: 3px 9px; border-radius: 99px; white-space: nowrap; }
  .hn2a-pill.is-ok   { color: #0a7d4c; background: #e8f9f0; border: 1px solid #bfeed3; }
  .hn2a-pill.is-warn { color: #92660c; background: #fff8ec; border: 1px solid #fbe6b8; }
  .hn2a-pill.is-bad  { color: #b42318; background: #fef3f2; border: 1px solid #fecdca; }
  .hn2a-kv { display: grid; grid-template-columns: 160px 1fr; gap: 8px 16px; font-size: 13px; }
  .hn2a-kv dt { color: #667085; font-weight: 600; }
  .hn2a-kv dd { margin: 0; color: #12151a; font-weight: 600; overflow-wrap: anywhere; }
  .hn2a-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .hn2a-table th { text-align: left; font-size: 11px; font-weight: 800; color: #98a2b3; text-transform: uppercase; letter-spacing: .04em; padding: 10px 12px; background: #fafbfc; border-bottom: 1px solid #eef1f4; }
  .hn2a-table td { padding: 12px; border-bottom: 1px solid #f2f4f7; color: #344054; font-weight: 600; }
  .hn2a-table tr:last-child td { border-bottom: 0; }
  .hn2a-empty { text-align: center; padding: 36px 16px; color: #98a2b3; font-size: 13px; font-weight: 600; }
  .hn2a-switch { display: flex; align-items: center; gap: 10px; font-size: 13.5px; font-weight: 600; color: #344054; cursor: pointer; }
  .hn2a-switch input { width: 18px; height: 18px; accent-color: #0EA968; }
  @media (max-width: 767px) {
    .hn2a { padding: 20px 14px 32px; }
    .hn2a-kv { grid-template-columns: 1fr; gap: 2px; }
    .hn2a-kv dd { margin-bottom: 8px; }
    .hn2a-table th:nth-child(2), .hn2a-table td:nth-child(2) { display: none; }
  }
</style>
