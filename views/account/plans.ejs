<% layout("/layouts/boilerplate") -%>
<%# Subscriptions Phase 2 — the plans an owner can choose from. Read-only: payment arrives in Phase 3. %>
<%- include("_style.ejs") %>
<% const inr = n => "₹" + new Intl.NumberFormat("en-IN", { maximumFractionDigits: 0 }).format(Number(n) || 0); %>
<style>
  .hn2p .hn2a-inner { max-width: 1040px; }
  .hn2p-now { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .hn2p-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; align-items: stretch; }
  .hn2p-card { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid #eef1f4; border-radius: 16px; padding: 22px 20px 20px; box-shadow: 0 1px 2px rgba(15,17,23,0.03); }
  .hn2p-card.is-current { border-color: #0EA968; box-shadow: 0 0 0 3px rgba(14,169,104,0.12); }
  .hn2p-badge { position: absolute; top: -10px; left: 18px; background: #12151a; color: #fff; font-size: 10.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 3px 10px; border-radius: 99px; }
  .hn2p-name { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 800; color: #12151a; margin: 0; }
  .hn2p-desc { font-size: 12.5px; color: #667085; font-weight: 500; margin-top: 3px; min-height: 18px; }
  .hn2p-price { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin: 16px 0 2px; }
  .hn2p-price b { font-family: 'Syne', sans-serif; font-size: 30px; font-weight: 800; color: #12151a; letter-spacing: -0.02em; line-height: 1; }
  .hn2p-price s { font-size: 14px; color: #98a2b3; font-weight: 600; }
  .hn2p-per { font-size: 12.5px; color: #667085; font-weight: 600; }
  .hn2p-offer { font-size: 11.5px; color: #92660c; font-weight: 700; margin-top: 6px; }
  .hn2p-list { list-style: none; margin: 16px 0 0; padding: 16px 0 0; border-top: 1px solid #f2f4f7; display: grid; gap: 9px; flex: 1; align-content: start; }
  .hn2p-list li { display: flex; gap: 9px; align-items: flex-start; font-size: 13px; color: #344054; font-weight: 600; line-height: 1.4; }
  .hn2p-list li.is-off { color: #98a2b3; font-weight: 500; }
  .hn2p-tick { flex-shrink: 0; width: 16px; height: 16px; margin-top: 1px; border-radius: 50%; background: #e8f9f0; color: #0a7d4c; font-size: 10px; font-weight: 900; display: inline-flex; align-items: center; justify-content: center; }
  .hn2p-list li.is-off .hn2p-tick { background: #f2f4f7; color: #98a2b3; }
  .hn2p-cta { margin-top: 18px; }
  .hn2p-cta .hn2a-btn { width: 100%; }
  .hn2p-current { display: block; text-align: center; font-size: 12.5px; font-weight: 800; color: #0a7d4c; background: #e8f9f0; border: 1px solid #bfeed3; border-radius: 10px; padding: 10px; }
  .hn2p-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<div class="hn2a hn2p">
  <div class="hn2a-inner">
    <h1 class="hn2a-title">Plans</h1>
    <div class="hn2a-sub">Choose the plan that fits your PG. Your tenants never pay to use HostelNode.</div>

    <div class="hn2a-card">
      <div class="hn2p-now">
        <div>
          <div class="hn2a-card-title">Your plan: <%= plan.name %></div>
          <div class="hn2a-card-sub" style="margin:0"><%= plan.line %></div>
        </div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span class="hn2a-pill <%= plan.tone %>"><%= plan.status %></span>
          <a class="hn2a-btn is-ghost" href="/user/account/billing">Billing</a>
        </div>
      </div>
    </div>

    <% if (typeof gone !== "undefined" && gone) { %><div class="hn2a-notice is-bad" role="alert"><%= gone %></div><% } %>

    <% if (!plan.plans.length) { %>
      <div class="hn2a-card"><div class="hn2a-empty">Plans will appear here soon.</div></div>
    <% } else { %>
      <div class="hn2p-grid">
        <% plan.plans.forEach(function (p) { %>
          <div class="hn2p-card <%= p.isCurrent ? 'is-current' : '' %>">
            <% if (p.badge) { %><span class="hn2p-badge"><%= p.badge %></span><% } %>
            <h2 class="hn2p-name"><%= p.name %></h2>
            <div class="hn2p-desc"><%= p.description %></div>
            <div class="hn2p-price">
              <b><%= p.price ? inr(p.price) : "Free" %></b>
              <% if (p.strikePrice) { %><s><span class="hn2p-sr">was </span><%= inr(p.strikePrice) %></s><% } %>
            </div>
            <div class="hn2p-per"><%= p.per %></div>
            <% if (p.offerEnds) { %><div class="hn2p-offer">Offer ends <%= p.offerEnds %></div><% } %>

            <ul class="hn2p-list">
              <% p.limitLines.forEach(function (t) { %><li><span class="hn2p-tick" aria-hidden="true">✓</span><span><%= t %></span></li><% }) %>
              <% p.features.forEach(function (f) { %>
                <li class="<%= f.on ? '' : 'is-off' %>"><span class="hn2p-tick" aria-hidden="true"><%= f.on ? "✓" : "–" %></span><span><%= f.label %><% if (!f.on) { %><span class="hn2p-sr"> (not included)</span><% } %></span></li>
              <% }) %>
              <% p.points.forEach(function (t) { %><li><span class="hn2p-tick" aria-hidden="true">✓</span><span><%= t %></span></li><% }) %>
            </ul>

            <div class="hn2p-cta">
              <% if (p.payHref) { %>
                <%# Phase 3: pay online. The current plan can be renewed at any time. %>
                <% if (p.isCurrent) { %><span class="hn2p-current" style="margin-bottom:8px">Your current plan</span><% } %>
                <a class="hn2a-btn <%= p.isCurrent && !p.canRenew ? 'is-ghost' : '' %>" href="<%= p.payHref %>"><%= p.isCurrent ? "Renew this plan" : "Choose " + p.name %></a>
              <% } else if (p.isCurrent && p.canRenew) { %>
                <a class="hn2a-btn" href="<%= p.request.href %>" <% if (p.request.external) { %>target="_blank" rel="noopener"<% } %>>Renew this plan</a>
              <% } else if (p.isCurrent) { %>
                <span class="hn2p-current">Your current plan</span>
              <% } else { %>
                <a class="hn2a-btn" href="<%= p.request.href %>" <% if (p.request.external) { %>target="_blank" rel="noopener"<% } %>><%= p.request.label %></a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
      <% const hnPayOnline = typeof payOnline !== "undefined" && payOnline; %>
      <div class="hn2a-help" style="margin-top:16px"><%= hnPayOnline ? "Pay securely with UPI, cards or netbanking through Razorpay. Plans are one-time payments and do not renew by themselves." : "Online payment is coming soon. For now, request a plan and we will activate it for you." %> Questions? Email <a href="mailto:<%= supportEmail %>" style="color:#0a7d4c;font-weight:700"><%= supportEmail %></a>.</div>
    <% } %>
  </div>
</div>
