</div>

<%- include("../includes/navbar-user.ejs") %>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-badge">
      <div class="dot"></div>
      Now live across India
    </div>

    <% if (student) { %>
      <h1>Welcome back,<br><span class="accent"><%= student.firstName %></span> 👋</h1>
      <p class="hero-sub">
        <% if (student.city) { %>
          Showing hostels near <strong><%= student.city %></strong> ·
        <% } %>
        Search 2,400+ verified hostels and PGs. Compare prices and book a visit in seconds.
      </p>
    <% } else { %>
      <h1>Find your perfect<br><span class="accent">hostel or PG</span> near<br>your college</h1>
      <p class="hero-sub">Search 2,400+ verified hostels and PGs near your college. Compare prices, amenities, and book a visit in seconds.</p>
    <% } %>
  <!-- ── NEARBY BUTTON (location asked ONLY on click) ── -->
      <div style="text-align:center; margin-top:14px;">
        <button type="button" id="nearbyBtn" class="nearby-btn" onclick="findNearby()">
          <i class="fa-solid fa-location-crosshairs"></i>
          Find PG / Hostel Near Me
        </button>
      </div>
    <!-- Search Card -->
    <div class="search-card" id="search-card">
      <div class="search-tabs">
        <button class="search-tab active" onclick="switchTab(this)">All</button>
        <button class="search-tab" onclick="switchTab(this)">Hostel</button>
        <button class="search-tab" onclick="switchTab(this)">PG</button>
        <button class="search-tab" onclick="switchTab(this)">Flat share</button>
      </div>

      <form action="/findHostels/results" method="GET" id="heroSearchForm">
        <div class="search-row">
          <div class="search-field" style="flex:2; min-width:200px; position:relative;">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="college" id="collegeInput"
              placeholder="College name or area (e.g. IIT Bombay, Pune)…"
              autocomplete="off"
              value="<%= student ? (student.collegeName || student.city || '') : '' %>">
            <div id="acSuggestions" style="
              display:none; position:absolute; top:100%; left:0; right:0;
              background:#fff; border:1px solid #e0e8e2; border-radius:12px;
              box-shadow:0 8px 24px rgba(0,0,0,.10); z-index:999; overflow:hidden;
              margin-top:6px; max-height:280px; overflow-y:auto;
            "></div>
          </div>
          <div class="search-field">
            <i class="fa-solid fa-indian-rupee-sign"></i>
            <select name="budget">
              <option value="">Any budget</option>
              <option value="3000">Under ₹3,000</option>
              <option value="5000">Under ₹5,000</option>
              <option value="8000">Under ₹8,000</option>
              <option value="12000">Under ₹12,000</option>
            </select>
          </div>
          <div class="search-field">
            <i class="fa-solid fa-venus-mars"></i>
            <select name="gender">
              <option value="">Any type</option>
              <option value="boys">Boys</option>
              <option value="girls">Girls</option>
              <option value="coed">Co-ed</option>
            </select>
          </div>
          <input type="hidden" name="type" id="propTypeInput" value="">
          <button type="submit" class="btn-search">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </div>
      </form>

    

      <div class="search-quick">
        <span class="search-quick-label">Popular:</span>
        <button type="button" class="quick-chip" onclick="fillSearch('IIT Bombay')">IIT Bombay</button>
        <button type="button" class="quick-chip" onclick="fillSearch('Delhi University')">Delhi University</button>
        <button type="button" class="quick-chip" onclick="fillSearch('Christ University Bangalore')">Christ Univ.</button>
        <button type="button" class="quick-chip" onclick="fillSearch('Pune University')">Pune Univ.</button>
        <button type="button" class="quick-chip" onclick="fillSearch('VIT Vellore')">VIT Vellore</button>
      </div>
      <div class="city-chips">
  <a href="/city/mumbai">Mumbai</a>
  <a href="/city/pune">Pune</a>
  <a href="/city/bangalore">Bangalore</a>
  <a href="/city/indore">Indore</a>
  <a href="/city/hyderabad">Hyderabad</a>
  <a href="/city/delhi">Delhi</a>
</div>
    </div>

    <!-- ── NEARBY RESULTS PANEL — appears below search card on click ── -->
    <div class="nearby-panel" id="nearbyPanel">

      <div class="nearby-panel-header">
        <div class="nearby-panel-title">
          <i class="fa-solid fa-location-crosshairs"></i>
          Hostels near you
          <span class="nearby-count-badge" id="nearbyCount">0</span>
        </div>
        <button class="nearby-close-btn" onclick="closeNearby()">
          <i class="fa-solid fa-xmark"></i> Close
        </button>
      </div>

      <div class="nearby-radius-bar">
        <span class="nearby-radius-label">Search radius:</span>
        <button class="radius-btn active" data-r="2"  onclick="changeRadius(2)">2 km</button>
        <button class="radius-btn"        data-r="5"  onclick="changeRadius(5)">5 km</button>
        <button class="radius-btn"        data-r="10" onclick="changeRadius(10)">10 km</button>
        <button class="radius-btn"        data-r="15" onclick="changeRadius(15)">15 km</button>
      </div>

      <div class="nearby-body">
        <div class="nearby-loading" id="nearbyLoading" style="display:none;">
          <i class="fa-solid fa-spinner fa-spin"></i>
          Finding hostels near you…
        </div>
        <div class="nearby-empty" id="nearbyEmpty">
          <i class="fa-solid fa-magnifying-glass"></i>
          <strong>No hostels found nearby</strong>
          Try increasing the radius or search by college name above.
        </div>
        <div class="nearby-grid" id="nearbyGrid"></div>
      </div>
    </div>

  </div><!-- /hero-inner -->

  <!-- Stats strip -->
  <div class="stats-strip">
    <div class="stat-item">
      <div class="stat-num">2<span>,400+</span></div>
      <div class="stat-label">Verified listings</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">180<span>+</span></div>
      <div class="stat-label">Cities covered</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">₹2k<span>–12k</span></div>
      <div class="stat-label">Price range / month</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">4.8<span>★</span></div>
      <div class="stat-label">Average rating</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">0<span> fee</span></div>
      <div class="stat-label">Zero broker fees</div>
    </div>
  </div>
</section>


<!-- ===== LISTINGS ===== -->
<section class="section listings-section">
  <div class="listings-layout">

    <aside class="sidebar">
      <div class="sidebar-title">
        Filters
        <span class="sidebar-clear" onclick="clearFilters()">Clear all</span>
      </div>
      <div class="filter-group">
        <div class="filter-group-label">Room type</div>
        <div class="filter-options">
          <div class="filter-option"><input type="checkbox" id="f-single" checked><label for="f-single">Single room</label></div>
          <div class="filter-option"><input type="checkbox" id="f-double"><label for="f-double">Double sharing</label></div>
          <div class="filter-option"><input type="checkbox" id="f-triple"><label for="f-triple">Triple sharing</label></div>
          <div class="filter-option"><input type="checkbox" id="f-dorm"><label for="f-dorm">Dormitory</label></div>
        </div>
      </div>
      <div class="filter-divider"></div>
      <div class="filter-group">
        <div class="filter-group-label">Gender</div>
        <div class="filter-options">
          <div class="filter-option"><input type="checkbox" id="f-boys"><label for="f-boys">Boys</label></div>
          <div class="filter-option"><input type="checkbox" id="f-girls"><label for="f-girls">Girls</label></div>
          <div class="filter-option"><input type="checkbox" id="f-co"><label for="f-co">Co-ed</label></div>
        </div>
      </div>
      <div class="filter-divider"></div>
      <div class="filter-group">
        <div class="filter-group-label">Amenities</div>
        <div class="filter-options">
          <div class="filter-option"><input type="checkbox" id="f-wifi"><label for="f-wifi">WiFi included</label></div>
          <div class="filter-option"><input type="checkbox" id="f-meals"><label for="f-meals">Meals included</label></div>
          <div class="filter-option"><input type="checkbox" id="f-ac"><label for="f-ac">AC rooms</label></div>
          <div class="filter-option"><input type="checkbox" id="f-laundry"><label for="f-laundry">Laundry</label></div>
          <div class="filter-option"><input type="checkbox" id="f-security"><label for="f-security">24/7 Security</label></div>
        </div>
      </div>
      <div class="filter-divider"></div>
      <div class="filter-group">
        <div class="filter-group-label">Max budget / month</div>
        <div class="price-range-wrap">
          <input type="range" min="1000" max="15000" step="500" value="8000"
            id="priceRange" oninput="updatePrice(this.value)">
          <div class="price-range-vals">
            <span>₹1,000</span>
            <strong id="priceVal">₹8,000</strong>
          </div>
        </div>
      </div>
      <button class="btn-apply-filter" onclick="applyFilters()">
        <i class="fa-solid fa-sliders"></i> Apply filters
      </button>
    </aside>

    <div class="main-listings">
      <div class="listings-header">
        <div>
          <h2 class="section-title" style="font-size:1.55rem">
            Featured hostels <span style="color:var(--green)">near top colleges</span>
          </h2>
          <p class="results-count">
            <strong id="resultsCount"><%= listings ? listings.length : 0 %></strong> hostels found
          </p>
        </div>
        <div class="filter-bar">
          <button class="filter-btn active" onclick="setSort(this,'distance')">
            <i class="fa-solid fa-location-dot"></i> Nearest
          </button>
          <button class="filter-btn" onclick="setSort(this,'price')">
            <i class="fa-solid fa-arrow-up-wide-short"></i> Price
          </button>
          <button class="filter-btn" onclick="setSort(this,'rating')">
            <i class="fa-solid fa-star"></i> Top rated
          </button>
        </div>
      </div>

      <div class="cards-grid" id="hostelGrid">
        <% if (listings && listings.length > 0) { %>
          <% listings.forEach(function(l) { %>
            <div class="hostel-card" data-id="<%= l._id %>" onclick="viewHostel('<%= l.slug %>')">
              <div class="card-img-wrap">
                <div class="card-slider">
                  <% if (l.images && l.images.length > 0) { %>
                    <% l.images.forEach(function(img, i) { %>
                      <img src="/listing-images/<%= img %>" class="slide <%= i === 0 ? 'active' : '' %>">
                    <% }) %>
                  <% } else { %>
                    <img src="/images/placeholder.jpg" class="slide active">
                  <% } %>
                </div>
                <button class="slide-btn prev" onclick="slideImage(event,this,-1)">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="slide-btn next" onclick="slideImage(event,this,1)">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>
                <div class="slide-dots">
                  <% if (l.images) { %>
                    <% l.images.forEach(function(_, i) { %>
                      <span class="dot <%= i === 0 ? 'active' : '' %>"
                            onclick="goToSlide(event,this,<%= i %>)"></span>
                    <% }) %>
                  <% } %>
                </div>
                <span class="card-badge badge-<%= (l.gender || '').toLowerCase() %>">
                  <%= l.gender %>
                </span>
                <% if (l.isVerified) { %>
