/* ===== VIEW / CALL / WA ===== */
function viewHostel(slug) { window.location.href = '/hostel/' + slug; }
function callHostel(phone) { window.location.href = 'tel:' + phone; }
function waHostel(phone) {
  const num = (phone || '').replace(/[^0-9]/g, '');
  if (!num) return;
  window.open('https://wa.me/' + num + '?text=' +
    encodeURIComponent('Hi! I found your hostel on HostelNode. I am interested in a room. Can you share details?'), '_blank');
}

/* ===== COLLEGE CHIP ===== */
function searchCollege(name) {
  window.location.href = '/findHostels/results?college=' + encodeURIComponent(name);
}

/* ===== MAP ===== */
function openMap() {
  alert('Map view coming soon! Add your Google Maps API key to enable this.');
}

/* ===== LOAD MORE ===== */
function loadMore(btn) {
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Loading…';
  setTimeout(() => { btn.innerHTML = '<i class="fa-solid fa-rotate"></i> Load more hostels'; }, 1200);
}

/* ===== IMAGE SLIDER ===== */
function slideImage(e, btn, direction) {
  e.stopPropagation();
  const wrap = btn.closest('.card-img-wrap');
  const slides = wrap.querySelectorAll('.slide');
  const dots   = wrap.querySelectorAll('.dot');
  let idx = [...slides].findIndex(s => s.classList.contains('active'));
  slides[idx].classList.remove('active');
  dots[idx]?.classList.remove('active');
  idx = (idx + direction + slides.length) % slides.length;
  slides[idx].classList.add('active');
  dots[idx]?.classList.add('active');
}
function goToSlide(e, dot, idx) {
  e.stopPropagation();
  const wrap = dot.closest('.card-img-wrap');
  const slides = wrap.querySelectorAll('.slide');
  const dots   = wrap.querySelectorAll('.dot');
  slides.forEach(s => s.classList.remove('active'));
  dots.forEach(d => d.classList.remove('active'));
  slides[idx].classList.add('active');
  dots[idx].classList.add('active');
}

/* ===== AUTOCOMPLETE ===== */
const POPULAR = [
  'IIT Bombay','IIT Delhi','IIT Madras','IIT Kharagpur',
  'Delhi University','Jawaharlal Nehru University','Jamia Millia',
  'Christ University Bangalore','Pune University','Savitribai Phule Pune University',
  'VIT Vellore','VIT Chennai','SRM Chennai','Amity Noida',
  'BITS Pilani','BITS Goa','BITS Hyderabad',
  'NIT Trichy','NIT Warangal','NIT Surathkal',
  'Manipal University','Manipal Jaipur',
  'Osmania University Hyderabad','JNTU Hyderabad',
  'Anna University Chennai','PSG Coimbatore',
  'Mumbai University','Navi Mumbai','Thane',
  'Andheri','Powai','Vashi','Kharghar',
  'Koregaon Park Pune','Kothrud Pune','Hadapsar',
  'Koramangala Bangalore','Electronic City','HSR Layout',
  'Lajpat Nagar Delhi','Dwarka','Noida','Gurgaon',
];
const input = document.getElementById('collegeInput');
const box   = document.getElementById('acSuggestions');
input?.addEventListener('input', function () {
  const q = this.value.trim().toLowerCase();
  if (!q || q.length < 2) { box.style.display = 'none'; return; }
  const hits = POPULAR.filter(s => s.toLowerCase().includes(q)).slice(0, 7);
  if (!hits.length) { box.style.display = 'none'; return; }
  box.innerHTML = hits.map(h => `
    <div onclick="pickSuggestion('${h}')" style="padding:10px 16px;cursor:pointer;font-size:13.5px;display:flex;align-items:center;gap:10px;color:#0a1628;transition:background .12s;"
      onmouseover="this.style.background='#f0fdf4'" onmouseout="this.style.background=''">
      <i class="fa-solid fa-location-dot" style="color:#09b850;width:14px"></i>
      ${h.replace(new RegExp(q, 'gi'), m => `<mark>${m}</mark>`)}
    </div>`).join('');
  box.style.display = 'block';
});
function pickSuggestion(val) {
  input.value = val;
  box.style.display = 'none';
  document.getElementById('heroSearchForm').submit();
}
document.addEventListener('click', e => {
  if (!box.contains(e.target) && e.target !== input) box.style.display = 'none';
});


/* ═══════════════════════════════════════════════════════
   NEARBY FEATURE
   Location is asked ONLY when user clicks the button.
   No auto-request on page load.
═══════════════════════════════════════════════════════ */

let _userLat      = null;
let _userLng      = null;
let _curRadius    = 5;   // default 5 km

/* Called when user clicks "Find PG / Hostel Near Me" */
async function findNearby() {
  const btn = document.getElementById('nearbyBtn');

  if (!navigator.geolocation) {
    showToast('❌ Your browser does not support location. Try Chrome or Firefox.');
    return;
  }

  /* Show spinner on button */
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Getting your location…';
  btn.disabled  = true;

  navigator.geolocation.getCurrentPosition(
    async (pos) => {
      _userLat = pos.coords.latitude;
      _userLng = pos.coords.longitude;
      resetNearbyBtn();
      await fetchNearby(_curRadius);
    },
    (err) => {
      resetNearbyBtn();
      const msgs = {
        1: '❌ Location access denied. Please allow location in your browser settings.',
        2: '❌ Location unavailable. Check your device GPS.',
        3: '❌ Location request timed out. Please try again.',
      };
      showToast(msgs[err.code] || '❌ Could not get your location.');
    },
    { timeout: 12000, maximumAge: 60000, enableHighAccuracy: true }
  );
}

function resetNearbyBtn() {
  const btn = document.getElementById('nearbyBtn');
  btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Find PG / Hostel Near Me';
  btn.disabled  = false;
}

/* Fetch from backend and render panel */
async function fetchNearby(radius) {
  if (!_userLat || !_userLng) return;

  const panel   = document.getElementById('nearbyPanel');
  const loading = document.getElementById('nearbyLoading');
  const empty   = document.getElementById('nearbyEmpty');
  const grid    = document.getElementById('nearbyGrid');
  const countEl = document.getElementById('nearbyCount');

  /* Show panel with loading state */
  panel.style.display = 'block';
  loading.style.display = 'block';
  empty.style.display   = 'none';
  grid.innerHTML        = '';
  countEl.textContent   = '…';

  /* Scroll panel into view smoothly */
  setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);

  try {
    const res  = await fetch(`/student/nearby?lat=${_userLat}&lng=${_userLng}&radius=${radius}`);
    const data = await res.json();

    loading.style.display = 'none';
    countEl.textContent   = data.count || 0;

    if (!data.success || !data.listings || data.listings.length === 0) {
      empty.style.display = 'block';
      return;
    }

    grid.innerHTML = data.listings.map(l => buildNearbyCard(l)).join('');

  } catch (err) {
    loading.style.display = 'none';
    grid.innerHTML = `<div style="text-align:center;padding:30px;color:#e53e3e;">
      <i class="fa-solid fa-triangle-exclamation" style="font-size:1.5rem;display:block;margin-bottom:8px;"></i>
      Failed to load nearby hostels. Please try again.
    </div>`;
    console.error('Nearby fetch error:', err);
  }
}

/* Change radius pill */
async function changeRadius(r) {
  _curRadius = r;
  document.querySelectorAll('.radius-btn').forEach(b => {
    b.classList.toggle('active', parseInt(b.dataset.r) === r);
  });
  if (_userLat && _userLng) await fetchNearby(r);
}

/* Close panel */
function closeNearby() {
  document.getElementById('nearbyPanel').style.display = 'none';
}

/* Build one hostel card for the nearby grid */
function buildNearbyCard(l) {
  const img        = l.images && l.images.length > 0
                     ? `/listing-images/${l.images[0]}`
                     : '/images/placeholder.jpg';
  const distText   = l.distanceKm != null
                     ? `<span class="dist-badge"><i class="fa-solid fa-location-dot"></i> ${l.distanceKm.toFixed(1)} km</span>`
                     : '';
  const verified   = l.isVerified
                     ? `<span class="card-badge" style="left:72px;top:12px;background:#fff;margin-left:4px;color:#09b850;"><i class="fa-solid fa-shield-halved"></i> Verified</span>`
                     : '';
  const amenities  = (l.amenities || []).slice(0, 4)
                     .map(a => `<span class="amenity-tag">${a}</span>`).join('');
  const waNum      = (l.contact?.whatsapp || '').replace(/[^0-9]/g, '');
  const waClick    = waNum ? `waHostel('${l.contact.whatsapp}')` : '';

  return `
  <div class="hostel-card" onclick="viewHostel('${l.slug}')">
    <div class="card-img-wrap">
      <div class="card-slider">
        <img src="${img}" class="slide active" style="width:100%;height:100%;object-fit:cover;">
      </div>
      <span class="card-badge badge-${(l.gender || '').toLowerCase()}">${l.gender || ''}</span>
      ${verified}
      <div class="card-wishlist" onclick="event.stopPropagation();">
        <i class="fa-regular fa-heart"></i>
      </div>
      <div class="card-dist">
        <i class="fa-solid fa-location-dot"></i>
        ${l.location?.nearCollege || l.location?.city || ''}
        ${distText}
      </div>
    </div>
    <div class="card-body">
      <div class="card-top">
        <div>
          <div class="card-name">${l.title}</div>
          <div class="card-best-value"><i class="fa-solid fa-bolt"></i> ${l.propertyType}</div>
        </div>
        <div class="card-rating">
          <i class="fa-solid fa-star"></i> ${l.rating || 4.2}
          <span style="font-size:.7rem;color:var(--muted-light)">(${l.reviewCount || 0})</span>
        </div>
      </div>
      <div class="card-loc">
        <i class="fa-solid fa-location-dot"></i>
        ${l.location?.address || ''}, ${l.location?.city || ''}
      </div>
      <div class="card-amenities">${amenities}</div>
      
      <div class="card-footer-row">
        <div class="card-price">
          <div class="price-val">₹${l.startingPrice} <span>/mo</span></div>
          <div class="price-label">${l.rooms?.[0]?.type || 'Room'}</div>
        </div>
         <div class="card-rating">
                  <i class="fa-solid fa-star"></i>
                  ${l.rating || 4.2}
          </div>

      </div>

        <div class="btn-see-more-wrap" style="margin-top:12px;">
          <span class="pulse-ring"></span>
          <span class="pulse-ring-2"></span>
          <button class="btn-see-more"
            onclick="event.stopPropagation(); viewHostel('${l.slug}')">
            <span class="btn-inner">
              <span class="btn-dot"></span>
              <span class="btn-label">See More Details</span>
              <span class="btn-arrow">
                <i class="fa-solid fa-arrow-right" style="font-size:13px"></i>
              </span>
            </span>
          </button>
        </div>

       
      
    </div>
  </div>`;
}
</script>



