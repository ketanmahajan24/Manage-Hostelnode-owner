<script>
/* ===== LOADER ===== */
document.addEventListener('DOMContentLoaded', function () {
  setTimeout(function () {
    const loader = document.getElementById('hn-loader');
    loader.style.opacity = '0';
    setTimeout(() => loader.style.display = 'none', 400);
  }, 1400);
});

/* ===== NAVBAR SCROLL ===== */
window.addEventListener('scroll', function () {
  document.getElementById('hnNav').classList.toggle('scrolled', window.scrollY > 10);
}, { passive: true });

/* ===== MOBILE NAV ===== */
function openMobileNav() {
  document.getElementById('mobileNav').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeMobileNav(e) {
  if (e.target === document.getElementById('mobileNav')) {
    document.getElementById('mobileNav').classList.remove('open');
    document.body.style.overflow = '';
  }
}

/* ===== PROFILE DROPDOWN ===== */
function snToggle(e) {
  e.stopPropagation();
  const pill = document.getElementById('snPill');
  if (pill) pill.classList.toggle('open');
}
document.addEventListener('click', function () {
  const pill = document.getElementById('snPill');
  if (pill) pill.classList.remove('open');
});

/* ===== SEARCH TABS ===== */
function switchTab(el) {
  document.querySelectorAll('.search-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  const map = { 'All':'', 'Hostel':'hostel', 'PG':'pg', 'Flat share':'flat' };
  document.getElementById('propTypeInput').value = map[el.textContent.trim()] || '';
}

/* ===== QUICK CHIPS ===== */
function fillSearch(college) {
  document.getElementById('collegeInput').value = college;
  document.getElementById('collegeInput').focus();
}

/* ===== PRICE RANGE ===== */
function updatePrice(val) {
  document.getElementById('priceVal').textContent = '₹' + Number(val).toLocaleString('en-IN');
}

/* ===== WISHLIST TOGGLE ===== */
async function toggleWish(e, btn) {
  e.stopPropagation();
  const card = btn.closest('.hostel-card');
  const listingId = card?.dataset.id;
  if (!listingId) { window.location.href = '/student/login'; return; }
  const isSaved = btn.classList.contains('saved');
  btn.classList.toggle('saved', !isSaved);
  btn.querySelector('i').className = !isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
  try {
    const res = await fetch(`/student/wishlist/toggle/${listingId}`, { method: 'POST' });
    if (res.redirected || res.status === 401) {
      btn.classList.toggle('saved', isSaved);
      btn.querySelector('i').className = isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      window.location.href = '/student/login'; return;
    }
    const data = await res.json();
    if (data.success) {
      btn.classList.toggle('saved', data.saved);
      btn.querySelector('i').className = data.saved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      showToast(data.saved ? '❤️ Saved to wishlist' : '🤍 Removed from wishlist');
    } else {
      btn.classList.toggle('saved', isSaved);
      btn.querySelector('i').className = isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      showToast('Could not update wishlist');
    }
  } catch (err) {
    btn.classList.toggle('saved', isSaved);
    btn.querySelector('i').className = isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
    console.error('Wishlist error:', err);
  }
}

function showToast(msg) {
  let t = document.getElementById('hn-toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'hn-toast';
    t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#1a1a2e;color:white;padding:12px 22px;border-radius:12px;font-size:14px;font-weight:500;z-index:9999;transition:transform .3s,opacity .3s;opacity:0;pointer-events:none;white-space:nowrap;';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => {
    t.style.opacity = '0';
    t.style.transform = 'translateX(-50%) translateY(80px)';
  }, 2500);
}

/* ===== SORT ===== */
function setSort(el, type) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
}

/* ===== FILTERS ===== */
function applyFilters() {
  const btn = document.querySelector('.btn-apply-filter');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Applying…';
  setTimeout(() => { btn.innerHTML = '<i class="fa-solid fa-sliders"></i> Apply filters'; }, 900);
}
function clearFilters() {
  document.querySelectorAll('.sidebar input[type="checkbox"]').forEach(cb => cb.checked = false);
  document.getElementById('priceRange').value = 8000;
  updatePrice(8000);
