<script>
/* ============================================================
   CONSTANTS
============================================================ */
const MAX_IMAGES    = 15;
const MAX_IMG_MB    = 5;       // input guard — raw file before compression
const MAX_TITLE     = 80;
const MAX_DESC      = 1000;
const MAX_RULE_LEN  = 200;
const PHONE_RE      = /^[6-9]\d{9}$/;
const PINCODE_RE    = /^\d{6}$/;
const ALLOWED_TYPES = ["image/jpeg","image/png","image/webp"];

// ── Compression settings (tweak here if needed) ──
const COMPRESS_MAX_W   = 1280;   // max width in px
const COMPRESS_MAX_H   = 1280;   // max height in px
const COMPRESS_QUALITY = 0.82;   // 0–1 (0.82 = sweet spot for quality vs size)
const COMPRESS_FORMAT  = 'image/webp'; // WebP = best for SEO / Core Web Vitals

/* ============================================================
   MAP PICKER STATE
============================================================ */
let mpLat = null, mpLng = null, mpConfirmed = false;
let currentMode = 'click';
let mpSearchTimeout = null;
let iframeReady = false;

const POPULAR_PLACES = [
  { name:'IIT Bombay', detail:'Powai, Mumbai, Maharashtra', lat:19.1334, lng:72.9133 },
  { name:'Delhi University North Campus', detail:'Maurice Nagar, Delhi', lat:28.6862, lng:77.2126 },
