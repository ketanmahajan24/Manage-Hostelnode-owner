  const style = document.createElement('style');
  style.textContent = `
    .field-err {
      display: none;
      color: #ef4444;
      font-size: 0.76rem;
      font-weight: 600;
      margin-top: 4px;
      padding: 4px 8px;
      background: #fff1f1;
      border-radius: 6px;
      border-left: 3px solid #ef4444;
    }
    .input-error {
      border-color: #ef4444 !important;
      background: #fff8f8 !important;
    }
    #globalErrBanner { display: none; }
    #globalErrBanner.show { display: flex !important; }
    #compressProgress { transition: opacity 0.3s; }
  `;
  document.head.appendChild(style);
})();
