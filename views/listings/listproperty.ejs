/* ============================================================
   PROGRESS
============================================================ */
function updateProgress() {
  try {
    const checks = [
      !!(document.getElementById('title').value || '').trim(),
      !!document.getElementById('startingPrice').value,
      !!document.querySelector('input[name="gender"]:checked'),
      !!(document.getElementById('address').value || '').trim(),
      !!(document.getElementById('nearCollege').value || '').trim(),
      mpConfirmed,
      !!(document.querySelector('.room-type-select') && document.querySelector('.room-type-select').value),
      document.querySelectorAll('.amenity-cb:checked').length > 0,
      uploadedFiles.filter(Boolean).length > 0,
      !!(document.getElementById('phone').value || '').trim(),
    ];
    const done = checks.filter(Boolean).length;
    const pct  = Math.round(done / checks.length * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('pctText').textContent = pct + '%';
    const stepDone = [
      checks[0] && checks[1] && checks[2],
      checks[3] && checks[4] && checks[5],
      checks[6], checks[7], checks[8], checks[9],
    ];
    document.querySelectorAll('.ps-item').forEach((el, i) => {
      el.classList.toggle('done', !!stepDone[i]);
    });
  } catch(e) {}
}

document.addEventListener('DOMContentLoaded', () => {
  try {
    document.querySelectorAll('.form-input,.form-select,.form-textarea,input[type="radio"],input[type="checkbox"]').forEach(el => {
      el.addEventListener('input',  updateProgress);
      el.addEventListener('change', updateProgress);
    });
  } catch(e) {}
});

/* ============================================================
   NAV STEPS HIGHLIGHT ON SCROLL
============================================================ */
const SECS = ['sec-basic','sec-location','sec-rooms','sec-amenities','sec-media','sec-contact'];
window.addEventListener('scroll', () => {
  try {
    let cur = 0;
    SECS.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && window.scrollY + 100 >= el.offsetTop) cur = i;
    });
    document.querySelectorAll('.lp-step').forEach((el, i) => el.classList.toggle('active', i === cur));
  } catch(e) {}
}, { passive: true });

/* ============================================================
   JUMP
============================================================ */
function jumpTo(id) {
  try {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch(e) {}
}

/* ============================================================
   SAME NUMBER
============================================================ */
function toggleSameNum() {
  try {
    const cb = document.getElementById('sameNumber');
    const wa = document.getElementById('whatsapp');
    if (cb.checked) {
      wa.value = document.getElementById('phone').value;
      wa.readOnly = true;
      wa.style.background = 'var(--bg2)';
      clearFieldErr('whatsapp');
    } else {
      wa.readOnly = false;
      wa.style.background = '';
    }
  } catch(e) {}
}

/* ============================================================
   DRAFT
============================================================ */
function saveDraft() {
  try {
    const btn = document.querySelector('.btn-draft');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';
    btn.disabled = true;
    const draft = {
      title:         document.getElementById('title').value,
      description:   document.getElementById('description').value,
      startingPrice: document.getElementById('startingPrice').value,
      address:       document.getElementById('address').value,
      nearCollege:   document.getElementById('nearCollege').value,
      city:          document.getElementById('city').value,
      phone:         document.getElementById('phone').value,
      savedAt:       new Date().toISOString(),
    };
    try { localStorage.setItem('hn_listing_draft', JSON.stringify(draft)); } catch(_) {}
    setTimeout(() => {
      btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Draft';
      btn.disabled = false;
      showToast('Draft saved locally!');
    }, 700);
  } catch(e) { showToast('Could not save draft. Please try again.', true); }
}

(function restoreDraft() {
  try {
    const raw = localStorage.getItem('hn_listing_draft');
    if (!raw) return;
    const draft = JSON.parse(raw);
    if (!draft || !draft.title) return;
    const age = Date.now() - new Date(draft.savedAt).getTime();
    if (age > 86400000) { localStorage.removeItem('hn_listing_draft'); return; }
    const set = (id, val) => { const el = document.getElementById(id); if (el && val) el.value = val; };
    set('title', draft.title);
    set('description', draft.description);
    set('startingPrice', draft.startingPrice);
    set('address', draft.address);
    set('nearCollege', draft.nearCollege);
    set('city', draft.city);
    set('phone', draft.phone);
    updatePreview();
    updateCharCount('title','titleCount', 80);
    updateCharCount('description','descCount', 1000);
    updateProgress();
    showToast('Draft restored from last session!');
  } catch(e) {}
})();

