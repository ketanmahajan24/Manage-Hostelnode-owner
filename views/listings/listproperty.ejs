  { name:'NIT Trichy', detail:'Tiruchirappalli, Tamil Nadu', lat:10.7603, lng:78.8125 },
  { name:'Manipal University', detail:'Manipal, Udupi, Karnataka', lat:13.3494, lng:74.7896 },
  { name:'SRM University Chennai', detail:'Kattankulathur, Chennai, Tamil Nadu', lat:12.7395, lng:80.0275 },
  { name:'JNTU Hyderabad', detail:'Kukatpally, Hyderabad, Telangana', lat:17.4933, lng:78.3782 },
  { name:'Mumbai University', detail:'Fort, Mumbai, Maharashtra', lat:18.9322, lng:72.8353 },
  { name:'Osmania University', detail:'Amberpet, Hyderabad, Telangana', lat:17.4126, lng:78.5283 },
  { name:'Calcutta University', detail:'Ballygunge, Kolkata, West Bengal', lat:22.5197, lng:88.3663 },
  { name:'Anna University Chennai', detail:'Guindy, Chennai, Tamil Nadu', lat:13.0101, lng:80.2337 },
  { name:'Amity University Noida', detail:'Sector 125, Noida, UP', lat:28.5445, lng:77.3325 },
];

/* ============================================================
   ★ IMAGE COMPRESSION UTILITY
   Canvas-based, runs instantly in the browser before upload.
   Input : raw File object (JPEG / PNG / WebP)
   Output: compressed File object (WebP, ≤1280px, quality 0.82)
   Typical result: 3–6 MB → 100–250 KB  (95%+ reduction)
============================================================ */
function compressImage(file) {
  return new Promise((resolve) => {
    const img = new Image();
    const objectUrl = URL.createObjectURL(file);

    // If anything fails, fall back to the original file so upload still works
    img.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      resolve(file);
    };

    img.onload = () => {
      URL.revokeObjectURL(objectUrl);

      let { width, height } = img;

      // Scale down proportionally if larger than max dimensions
      if (width > COMPRESS_MAX_W || height > COMPRESS_MAX_H) {
        const ratio = Math.min(COMPRESS_MAX_W / width, COMPRESS_MAX_H / height);
        width  = Math.round(width  * ratio);
        height = Math.round(height * ratio);
      }

      const canvas = document.createElement('canvas');
      canvas.width  = width;
      canvas.height = height;

      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, width, height);

      canvas.toBlob(
        (blob) => {
          if (!blob) { resolve(file); return; } // fallback
          const newName = file.name.replace(/\.[^.]+$/, '') + '.webp';
          const compressed = new File([blob], newName, {
            type: COMPRESS_FORMAT,
            lastModified: Date.now(),
          });
          resolve(compressed);
        },
        COMPRESS_FORMAT,
        COMPRESS_QUALITY
      );
    };

    img.src = objectUrl;
  });
}

/* ============================================================
   INLINE FIELD ERROR HELPERS
============================================================ */
function setFieldErr(id, msg) {
  try {
    const el = document.getElementById('err-' + id);
    if (!el) return;
    el.textContent = msg || '';
    el.style.display = msg ? 'block' : 'none';
    const input = document.getElementById(id);
    if (input) input.classList.toggle('input-error', !!msg);
  } catch(e) {}
}
function clearFieldErr(id) { setFieldErr(id, ''); }

/* ============================================================
   FIELD-LEVEL VALIDATION
============================================================ */
function validateField(id) {
  try {
    const el = document.getElementById(id);
    if (!el) return true;
    const v = el.value.trim();

    switch (id) {
      case 'title':
        if (!v)                   { setFieldErr(id, 'Property title is required.'); return false; }
        if (v.length > MAX_TITLE) { setFieldErr(id, `Title must be ${MAX_TITLE} characters or less.`); return false; }
        break;
      case 'description':
        if (v.length > MAX_DESC)  { setFieldErr(id, `Description must be ${MAX_DESC} characters or less.`); return false; }
        break;
      case 'startingPrice': {
        const n = Number(v);
        if (!v || isNaN(n))  { setFieldErr(id, 'Please enter a valid price.'); return false; }
        if (n < 100)         { setFieldErr(id, 'Price must be at least ₹100/month.'); return false; }
        if (n > 500000)      { setFieldErr(id, 'Price seems too high. Max ₹5,00,000.'); return false; }
        break;
      }
      case 'deposit': {
        if (!v) break;
        const n = Number(v);
        if (isNaN(n) || n < 0) { setFieldErr(id, 'Please enter a valid deposit amount.'); return false; }
        if (n > 2000000)       { setFieldErr(id, 'Deposit seems too high. Max ₹20,00,000.'); return false; }
        break;
      }
      case 'capacity': {
        if (!v) break;
        const n = Number(v);
        if (isNaN(n) || n < 1) { setFieldErr(id, 'Capacity must be at least 1.'); return false; }
        if (n > 1000)          { setFieldErr(id, 'Capacity max is 1000.'); return false; }
        break;
      }
      case 'address':     if (!v) { setFieldErr(id, 'Full address is required.'); return false; } break;
      case 'nearCollege': if (!v) { setFieldErr(id, 'Nearest college / place is required.'); return false; } break;
      case 'city':        if (!v) { setFieldErr(id, 'City is required.'); return false; } break;
      case 'pincode':
        if (v && !PINCODE_RE.test(v)) { setFieldErr(id, 'Pincode must be exactly 6 digits.'); return false; }
        break;
      case 'phone':
        if (!v)               { setFieldErr(id, 'Phone number is required.'); return false; }
        if (!PHONE_RE.test(v)) { setFieldErr(id, 'Enter a valid 10-digit Indian mobile number.'); return false; }
        break;
      case 'whatsapp':
        if (v && !PHONE_RE.test(v)) { setFieldErr(id, 'Enter a valid 10-digit WhatsApp number.'); return false; }
        break;
    }
    clearFieldErr(id);
    return true;
  } catch(e) { return true; }
}

function validateGender() {
  if (!document.querySelector('input[name="gender"]:checked')) {
    setFieldErr('gender', 'Please select who this property is for.');
    return false;
  }
  clearFieldErr('gender');
  return true;
}

function validateMap() {
  if (!mpConfirmed) {
    setFieldErr('map', 'Please pin your location on the map and click "Confirm Pin".');
    return false;
  }
  clearFieldErr('map');
  return true;
}

function validateRooms() {
  try {
    const selects = document.querySelectorAll('.room-type-select');
    for (const s of selects) {
      if (!s.value) { setFieldErr('rooms', 'Please select a room type for each room you added.'); return false; }
    }
    const priceInputs = document.querySelectorAll('.room-price-input');
    for (const p of priceInputs) {
      const n = Number(p.value);
      if (p.value && (isNaN(n) || n < 0)) { setFieldErr('rooms', 'Room price must be a valid positive number.'); return false; }
      if (n > 500000) { setFieldErr('rooms', 'Room price seems too high (max ₹5,00,000).'); return false; }
    }
    clearFieldErr('rooms');
    return true;
  } catch(e) { return true; }
}

function validateImages() {
  const active = uploadedFiles.filter(Boolean);
  if (active.length === 0) {
    setFieldErr('images', 'Please upload at least one photo of your property.');
    return false;
  }
  clearFieldErr('images');
  return true;
}

function validateRuleLength(input) {
  if (input.value.length >= MAX_RULE_LEN) {
    showToast(`Rule text is limited to ${MAX_RULE_LEN} characters.`, true);
    input.value = input.value.slice(0, MAX_RULE_LEN);
  }
}

/* ============================================================
   GLOBAL ERROR BANNER
============================================================ */
function showGlobalErr(msg) {
  const banner = document.getElementById('globalErrBanner');
  document.getElementById('globalErrText').textContent = msg;
  banner.style.display = 'flex';
  banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
  setTimeout(() => closeGlobalErr(), 10000);
}
function closeGlobalErr() {
  const banner = document.getElementById('globalErrBanner');
  if (banner) banner.style.display = 'none';
}

/* ============================================================
   TOAST
============================================================ */
let toastTimer = null;
function showToast(msg, isError = false) {
  try {
    const t = document.getElementById('toastMsg');
    const icon = document.getElementById('toastIcon');
    document.getElementById('toastText').textContent = msg;
    icon.className = isError ? 'fa-solid fa-circle-exclamation' : 'fa-solid fa-circle-check';
    icon.style.color = isError ? '#ef4444' : 'var(--green)';
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 3200);
  } catch(e) {}
}

/* ============================================================
   SUBMIT
============================================================ */
async function handleSubmit(e) {
  e.preventDefault();
  closeGlobalErr();

  const fieldChecks = [
    validateField('title'),
    validateField('startingPrice'),
    validateField('deposit'),
    validateField('capacity'),
    validateField('description'),
    validateGender(),
    validateField('address'),
    validateField('nearCollege'),
    validateField('city'),
    validateField('pincode'),
    validateMap(),
    validateRooms(),
    validateImages(),
    validateField('phone'),
    validateField('whatsapp'),
  ];

  if (fieldChecks.includes(false)) {
    const errEls = document.querySelectorAll('.field-err');
    let scrolled = false;
    errEls.forEach(el => {
      if (!scrolled && el.textContent.trim() && el.style.display !== 'none') {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        scrolled = true;
      }
    });
    showToast('Please fix the highlighted errors before submitting.', true);
    return;
  }

  const form = document.getElementById('listingForm');

  // Sync compressed files back into the file input via DataTransfer
  try {
    const dt = new DataTransfer();
    uploadedFiles.filter(Boolean).forEach(f => dt.items.add(f));
    document.getElementById('imagesInput').files = dt.files;
  } catch (dtErr) { /* fallback — older browsers */ }

  const formData = new FormData(form);

  const btn = document.getElementById('submitBtn');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
  btn.disabled = true;

  try {
    const resp = await fetch('/user/new-list-property', {
      method: 'POST',
      body: formData,
    });

    const contentType = resp.headers.get('content-type') || '';

    if (resp.ok) {
      if (contentType.includes('text/html')) {
        const html = await resp.text();
        document.open(); document.write(html); document.close();
        return;
      }
      window.location.href = '/user/my-listings';
      return;
    }

    let errMsg = 'Something went wrong. Please try again.';
    if (contentType.includes('application/json')) {
      try { const data = await resp.json(); errMsg = data.message || errMsg; } catch(_) {}
    } else {
      try { errMsg = await resp.text(); } catch(_) {}
      if (!errMsg || errMsg.length > 300) errMsg = `Server error (${resp.status}). Please try again.`;
    }
    if (resp.status === 401) errMsg = 'Session expired. Please log in again.';
    if (resp.status === 413) errMsg = 'Uploaded files are too large. Please reduce photo sizes and try again.';
    if (resp.status === 503) errMsg = 'Server is temporarily unavailable. Please try again in a moment.';

    showGlobalErr(errMsg);
    showToast(errMsg, true);

  } catch (networkErr) {
    const msg = navigator.onLine
      ? 'Could not reach the server. Please try again.'
      : 'You appear to be offline. Please check your internet connection and try again.';
    showGlobalErr(msg);
    showToast(msg, true);
  } finally {
    btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Listing';
    btn.disabled = false;
  }
}

/* ============================================================
   MAP PICKER
============================================================ */
function onMpInput() {
  clearTimeout(mpSearchTimeout);
  const q = (document.getElementById('mpSearchInput').value || '').trim();
  if (q.length < 2) { closeSugg(); return; }
  mpSearchTimeout = setTimeout(() => renderSugg(q), 180);
}

function renderSugg(q) {
  try {
    const ql = q.toLowerCase();
    const matches = POPULAR_PLACES.filter(p =>
      p.name.toLowerCase().includes(ql) || p.detail.toLowerCase().includes(ql)
    ).slice(0, 6);
    const drop = document.getElementById('mpSuggDrop');
    if (!matches.length) { closeSugg(); return; }
    drop.innerHTML = matches.map(m => `
      <div class="mp-sugg-item" onclick="pickSugg(${m.lat},${m.lng},'${escJs(m.name)}','${escJs(m.detail)}')">
        <i class="fa-solid fa-location-dot mp-sugg-icon"></i>
        <div><div class="mp-sugg-name">${escHtml(m.name)}</div><div class="mp-sugg-detail">${escHtml(m.detail)}</div></div>
      </div>`).join('');
    drop.classList.add('open');
  } catch(e) {}
}

function escJs(s)   { return String(s).replace(/\\/g,'\\\\').replace(/'/g, "\\'"); }
function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function closeSugg() {
  try { document.getElementById('mpSuggDrop').classList.remove('open'); } catch(e) {}
}

function pickSugg(lat, lng, name) {
  document.getElementById('mpSearchInput').value = name;
  closeSugg();
  loadMapAt(lat, lng, name);
}

function doMpSearch() {
  closeSugg();
  const q = (document.getElementById('mpSearchInput').value || '').trim();
  if (!q) { showToast('Please type a college or area name first.', true); return; }
  const ql = q.toLowerCase();
  const match = POPULAR_PLACES.find(p =>
    p.name.toLowerCase().includes(ql) || p.detail.toLowerCase().includes(ql)
  );
  if (match) { loadMapAt(match.lat, match.lng, match.name); return; }
  const addr = document.getElementById('address').value || q;
  setMpStatus('Searching…', 'loading');
  setTimeout(() => {
    try {
      document.getElementById('mpIframe').src = `https://maps.google.com/maps?q=${encodeURIComponent(addr)}&z=16&output=embed`;
      setMpStatus('Map updated — click to drop pin', '');
    } catch(e) { setMpStatus('Search failed. Try again.', ''); }
  }, 700);
}

function loadMapAt(lat, lng, label) {
  try {
    setMpStatus('Loading…', 'loading');
    document.getElementById('mpLoader').classList.remove('hidden');
    document.getElementById('mpIframe').src = `https://maps.google.com/maps?q=${lat},${lng}&z=17&output=embed`;
    mpLat = parseFloat(parseFloat(lat).toFixed(6));
    mpLng = parseFloat(parseFloat(lng).toFixed(6));
    showPinAt(50, 50);
    updateCoordsBar(lat, lng, label || '');
  } catch(e) { setMpStatus('Could not load map. Check your connection.', ''); }
}

function onIframeLoad() {
  try {
    iframeReady = true;
    document.getElementById('mpLoader').classList.add('hidden');
    setMpStatus(mpLat !== null ? 'Map loaded — click exact hostel location to pin' : 'Click on map to drop pin', '');
  } catch(e) {}
}

function setMode(mode) {
  try {
    currentMode = mode;
    const overlay = document.getElementById('mpOverlay');
    document.getElementById('modeClick').classList.toggle('active', mode === 'click');
    document.getElementById('modeDrag').classList.toggle('active', mode === 'drag');
    overlay.classList.toggle('disabled', mode === 'drag');
    document.getElementById('mpIframe').style.pointerEvents = mode === 'drag' ? 'auto' : 'none';
    setMpStatus(mode === 'drag' ? 'Pan mode — switch back to click to pin' : 'Click on the map to drop your pin', '');
  } catch(e) {}
}

function handleMapClick(e) {
  if (currentMode !== 'click') return;
  try {
    const container = document.getElementById('mpMapContainer');
    const rect = container.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const pctX = x / rect.width;
    const pctY = y / rect.height;

    showRipple(x, y);
    showPinAt(pctX * 100, pctY * 100);

    const iframe = document.getElementById('mpIframe');
    const srcMatch = iframe.src.match(/q=([\-\d.]+),([\-\d.]+)/);
    let centerLat = 20.5937, centerLng = 78.9629;
    if (srcMatch) { centerLat = parseFloat(srcMatch[1]); centerLng = parseFloat(srcMatch[2]); }

    const zoomMatch = iframe.src.match(/z=(\d+)/);
    const zoom = zoomMatch ? parseInt(zoomMatch[1]) : 16;
    const degPerPixel = 360 / (256 * Math.pow(2, zoom));
    mpLat = parseFloat((centerLat - (pctY - 0.5) * rect.height * degPerPixel).toFixed(6));
    mpLng = parseFloat((centerLng + (pctX - 0.5) * rect.width  * degPerPixel).toFixed(6));

    updateCoordsBar(mpLat, mpLng, '');
    setMpStatus(`Pin at ${mpLat.toFixed(4)}, ${mpLng.toFixed(4)} — confirm below ↓`, 'green');
    document.getElementById('mpConfirmBtn').disabled = false;
    mpConfirmed = false;
    document.getElementById('confirmedBadge').classList.remove('show');
    document.getElementById('mapPickerWrap').classList.remove('pinned');
    clearFieldErr('map');
  } catch(e) { showToast('Could not set pin. Please try again.', true); }
}

function showPinAt(pctX, pctY) {
  try {
    const pin = document.getElementById('mpPin');
    pin.style.left = pctX + '%';
    pin.style.top  = pctY + '%';
    pin.style.display = 'block';
    pin.style.animation = 'none';
    pin.offsetHeight;
    pin.style.animation = '';
  } catch(e) {}
}

function showRipple(x, y) {
  try {
    const r = document.getElementById('mpRipple');
    r.style.left = x + 'px'; r.style.top = y + 'px';
    r.style.display = 'block';
    r.style.animation = 'none'; r.offsetHeight;
    r.style.animation = 'rippleOut 0.5s ease forwards';
    setTimeout(() => { try { r.style.display = 'none'; } catch(e){} }, 500);
  } catch(e) {}
}

function updateCoordsBar(lat, lng, addr) {
  try {
    const latEl  = document.getElementById('dispLat');
    const lngEl  = document.getElementById('dispLng');
    const addrEl = document.getElementById('dispAddr');
    latEl.textContent = parseFloat(lat).toFixed(6); latEl.className = 'mp-coord-value filled';
    lngEl.textContent = parseFloat(lng).toFixed(6); lngEl.className = 'mp-coord-value filled';
    if (addr) { addrEl.textContent = addr; addrEl.className = 'mp-coord-value filled'; }
    else       { addrEl.textContent = 'Click to detect'; addrEl.className = 'mp-coord-value empty'; }
  } catch(e) {}
}

function setMpStatus(text, state) {
  try {
    document.getElementById('mpStatusText').textContent = text;
    const dot = document.getElementById('mpDot');
    dot.className = 'mp-status-dot' + (state === 'green' ? ' green' : state === 'loading' ? ' loading' : '');
  } catch(e) {}
}

function confirmPin() {
  if (mpLat === null) { showToast('Please click on the map first to drop a pin.', true); return; }
  try {
    document.getElementById('coordLat').value = mpLat;
    document.getElementById('coordLng').value = mpLng;
    mpConfirmed = true;
    document.getElementById('mapPickerWrap').classList.add('pinned');
    document.getElementById('confirmedBadge').classList.add('show');
    document.getElementById('mpConfirmBtn').innerHTML = '<i class="fa-solid fa-circle-check"></i> Pinned ✓';
    document.getElementById('mpConfirmBtn').style.background = 'var(--green-dark)';
    setMpStatus('Location confirmed and saved!', 'green');
    clearFieldErr('map');
    showToast('📍 Location pinned successfully!');
    updateProgress();
  } catch(e) { showToast('Could not confirm pin. Please try again.', true); }
}

function useGps() {
  if (!navigator.geolocation) { showToast('GPS not supported in this browser.', true); return; }
  setMpStatus('Getting GPS location…', 'loading');
  navigator.geolocation.getCurrentPosition(
    pos => {
      try {
        const { latitude: lat, longitude: lng } = pos.coords;
        document.getElementById('mpSearchInput').value = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
        loadMapAt(lat, lng, 'Your GPS location');
        showToast('GPS location detected!');
      } catch(e) { showToast('GPS error. Please try manually.', true); }
    },
    err => {
      const msgs = { 1:'Location permission denied. Please allow location access in your browser.', 2:'Location unavailable. Please search manually.', 3:'GPS timed out. Please try again or search manually.' };
      const msg = msgs[err.code] || 'GPS error. Please search manually.';
      setMpStatus(msg, ''); showToast(msg, true);
    },
    { enableHighAccuracy: true, timeout: 10000 }
  );
}

function resetMap() {
  try {
    mpLat = null; mpLng = null; mpConfirmed = false;
    document.getElementById('mpIframe').src = 'https://maps.google.com/maps?q=India&z=5&output=embed';
    document.getElementById('mpPin').style.display = 'none';
    document.getElementById('coordLat').value = '';
    document.getElementById('coordLng').value = '';
    ['dispLat','dispLng'].forEach(id => {
      document.getElementById(id).textContent = 'Not set yet';
      document.getElementById(id).className = 'mp-coord-value empty';
    });
    document.getElementById('dispAddr').textContent = 'Drop pin to detect';
    document.getElementById('dispAddr').className = 'mp-coord-value empty';
    const btn = document.getElementById('mpConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Confirm Pin';
    btn.style.background = '';
    document.getElementById('confirmedBadge').classList.remove('show');
    document.getElementById('mapPickerWrap').classList.remove('pinned');
    document.getElementById('mpSearchInput').value = '';
    setMpStatus('Click on map to drop pin', '');
    clearFieldErr('map');
  } catch(e) {}
}

document.addEventListener('click', e => {
  try {
    if (!document.getElementById('mpSearchInput').contains(e.target) &&
        !document.getElementById('mpSuggDrop').contains(e.target)) closeSugg();
  } catch(e) {}
});

