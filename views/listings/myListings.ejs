<script>
/* ─── SLIDER ─── */
const sliderState = {};

function sliderGoTo(id, index) {
  const slider = document.querySelector(`.ml-slider[data-slider-id="${id}"]`);
  if (!slider) return;
  const slides = slider.querySelectorAll('.ml-slide');
  const dots   = slider.querySelectorAll('.ml-dot');
  const prev   = sliderState[id]?.current ?? 0;
  slides[prev]?.classList.remove('active');
  dots[prev]?.classList.remove('active');
  const next = (index + slides.length) % slides.length;
  slides[next].classList.add('active');
  dots[next]?.classList.add('active');
  sliderState[id] = { ...sliderState[id], current: next };
}

function sliderNav(id, dir) {
  const slider = document.querySelector(`.ml-slider[data-slider-id="${id}"]`);
  if (!slider) return;
  const slides = slider.querySelectorAll('.ml-slide');
  sliderGoTo(id, (sliderState[id]?.current ?? 0) + dir);
  sliderResetAuto(id, slides.length);
}

function sliderStartAuto(id, total) {
  if (total <= 1) return;
  const timer = setInterval(() => sliderGoTo(id, (sliderState[id]?.current ?? 0) + 1), 3500);
  sliderState[id] = { ...(sliderState[id] || {}), timer };
}
function sliderStopAuto(id) {
  if (sliderState[id]?.timer) { clearInterval(sliderState[id].timer); sliderState[id].timer = null; }
}
function sliderResetAuto(id, total) { sliderStopAuto(id); sliderStartAuto(id, total); }

function initAllSliders() {
  document.querySelectorAll('.ml-slider').forEach(slider => {
    const id = slider.dataset.sliderId;
    const slides = slider.querySelectorAll('.ml-slide');
    if (!id || !slides.length) return;
    sliderState[id] = { current: 0, timer: null };
    slider.addEventListener('mouseenter', () => sliderStopAuto(id));
    slider.addEventListener('mouseleave', () => sliderStartAuto(id, slides.length));
    const detail = slider.closest('.ml-detail');
    if (detail?.classList.contains('visible')) sliderStartAuto(id, slides.length);
  });
}

/* ─── TABS ─── */
function switchTab(btn, panelId) {
  const detail = btn.closest('.ml-detail');
  detail.querySelectorAll('.ml-tab').forEach(t => t.classList.remove('active'));
  detail.querySelectorAll('.ml-tab-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(panelId)?.classList.add('active');
}

/* ─── SELECT LISTING ─── */
function selectListing(id) {
  document.querySelectorAll('.ml-card').forEach(c => c.classList.remove('active'));
  document.getElementById('card-' + id)?.classList.add('active');
  Object.keys(sliderState).forEach(sid => sliderStopAuto(sid));
  document.querySelectorAll('.ml-detail').forEach(d => d.classList.remove('visible'));
  const detail = document.getElementById('detail-' + id);
  if (detail) { detail.classList.add('visible'); detail.scrollTop = 0; }
  document.getElementById('mlPlaceholder').style.display = 'none';
  const slider = detail?.querySelector('.ml-slider');
  if (slider) sliderStartAuto(id, slider.querySelectorAll('.ml-slide').length);
}

/* ─── STATUS FILTER ─── */
let activeStatus = 'all';
function filterByStatus(status, btn) {
  activeStatus = status;
  document.querySelectorAll('.ml-ftab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  filterCards();
}

/* ─── SEARCH + STATUS FILTER ─── */
function filterCards() {
  const q = document.getElementById('listingSearch').value.toLowerCase().trim();
  let visible = 0;
  document.querySelectorAll('.ml-card').forEach(card => {
    const matchStatus = activeStatus === 'all' || card.dataset.status === activeStatus;
    const matchSearch = !q || card.dataset.title.includes(q) || card.dataset.city.includes(q);
    const show = matchStatus && matchSearch;
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';
  document.getElementById('visibleCount').textContent = visible;
}

/* ─── CHARTS ─── */
const chartInstances = {};

function initChart(id, views, shortlisted, reviews, enquiries) {
  const ctx = document.getElementById('chart-' + id);
  if (!ctx) return;
  if (chartInstances[id]) chartInstances[id].destroy();

  chartInstances[id] = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Views', 'Shortlisted', 'Reviews', 'enquiries'],
      datasets: [{
        label: 'Count',
        data: [views, shortlisted, reviews, enquiries],
        backgroundColor: [
          'rgba(9,184,80,0.18)',
          'rgba(9,184,80,0.35)',
          'rgba(245,158,11,0.30)',
          'rgba(59,130,246,0.28)'
        ],
        borderColor: [
          '#09b850', '#09b850', '#f59e0b', '#3b82f6'
        ],
        borderWidth: 1.5,
        borderRadius: 8,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ' ' + ctx.parsed.y } }
      },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 11, family: 'DM Sans' } } },
        y: { beginAtZero: true, grid: { color: '#e2e4ea' }, ticks: { precision: 0, font: { size: 11 } } }
      }
    }
  });
}

/* Init all charts for all listings */
function initAllCharts() {
  <% listings.forEach(l => { %>
    initChart(
      '<%= l._id %>',
      <%= l.views || 0 %>,
      <%= l.shortlisted || 0 %>,
      <%= l.reviewCount || 0 %>,
      <%= l.enquiries ? l.enquiries.length : 0 %>
    );
  <% }) %>
}

/* ─── DELETE REVIEW ─── */
async function deleteReview(listingId, reviewId) {
  if (!confirm('Delete this review? This cannot be undone.')) return;

  try {
    const res  = await fetch(`/user/listing/${listingId}/review/${reviewId}`, { method: 'DELETE' });
    const data = await res.json();

    if (data.success) {
      // Remove card from DOM
      document.getElementById('rev-' + reviewId)?.remove();

      // Update count label
      const countEl = document.getElementById('rev-count-' + listingId);
      if (countEl) {
        countEl.textContent = `Based on ${data.newReviewCount} review${data.newReviewCount !== 1 ? 's' : ''}`;
      }

      // If no reviews left, show empty state
      const list = document.getElementById('rev-list-' + listingId);
      if (list && list.querySelectorAll('.rev-card').length === 0) {
        list.innerHTML = `<div class="rev-empty"><i class="fa-regular fa-star"></i><p>No reviews yet.</p></div>`;
      }

      showToast('Review deleted');

      // Refresh chart
      initChart(
        listingId,
        parseInt(document.querySelector(`#analytics-${listingId} .an-val`)?.textContent) || 0,
        0, data.newReviewCount, 0
      );
    } else {
      showToast(data.error || 'Could not delete', true);
    }
  } catch (err) {
    showToast('Network error', true);
  }
}

/* ─── COPY LINK ─── */
function copyLink(slug) {
  navigator.clipboard.writeText(window.location.origin + '/hostel/' + slug)
    .then(() => showToast('Link copied!'))
    .catch(() => showToast('Could not copy', true));
}

/* ─── BOOST ─── */
function boostListing(id) { showToast('Boost feature coming soon!'); }

/* ─── DELETE LISTING MODAL ─── */
function openDelete(id, name) {
  document.getElementById('deleteMsg').textContent = `"${name}" will be permanently removed. This cannot be undone.`;
  document.getElementById('deleteForm').action = '/user/listing/' + id + '/delete';
  document.getElementById('deleteModal').classList.add('open');
}
function closeDelete() { document.getElementById('deleteModal').classList.remove('open'); }
document.getElementById('deleteModal').addEventListener('click', function(e) {
  if (e.target === this) closeDelete();
});

/* ─── TOAST ─── */
function showToast(msg, err = false) {
  let t = document.getElementById('mlToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'mlToast';
    Object.assign(t.style, {
      position:'fixed', bottom:'24px', right:'24px',
      padding:'10px 18px', borderRadius:'10px',
      fontSize:'0.78rem', fontWeight:'600',
      fontFamily:"'DM Sans', sans-serif",
      zIndex:'9999', transition:'opacity .3s',
      boxShadow:'0 4px 20px rgba(0,0,0,.15)'
    });
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.background = err ? '#dc2626' : '#09B850';
  t.style.color = '#fff';
  t.style.opacity = '1';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.style.opacity = '0', 2800);
}

/* ─── INIT ─── */
document.addEventListener('DOMContentLoaded', () => {
  initAllSliders();
  initAllCharts();
});

</script>