<style>
  .inq-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  font-size: 13px;
  color: #555;
}

.inq-meta i {
  color: #4CAF50;
}

.info-badge {
  background: #f1f5f9;
  padding: 3px 8px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 12px;
  color: #222;
}
  .wa-btn {
  background: #25D366;
  color: #fff;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
  text-decoration: none;
}

  .call-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: #22c55e;
  color: #fff;
  border-radius: 20px;
  font-size: 12px;
  text-decoration: none;
  font-weight: 500;
  transition: 0.2s;
}

.call-btn:hover {
  background: #16a34a;
}
</style>
<style>
  :root {
    --g:       #09B850;
    --g-dark:  #078040;
    --g-dim:   rgba(9,184,80,.12);
    --g-glow:  rgba(9,184,80,.22);
    --ink:     #0f1117;
    --ink2:    #3a3d47;
    --muted:   #7c8090;
    --surface: #ffffff;
    --bg:      #f4f5f7;
    --border:  #e2e4ea;
    --radius:  14px;
    --panel-l: 300px;
    --hdr:     64px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .ml-shell {
    width: 80%; margin-top: 50px; 
    display: flex; height: calc(100vh - var(--hdr));
    background: var(--bg); font-family: 'DM Sans', sans-serif; overflow: hidden;
  }
 
  /* ═══ LEFT PANEL ═══ */
  .ml-left {
    width: var(--panel-l); min-width: var(--panel-l);
    background: var(--surface); border-right: 1.5px solid var(--border);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .ml-left-head { padding: 20px 18px 14px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .ml-left-head h2 { font-family: sans-serif; font-size: 1.05rem; font-weight: 800; color: var(--ink); }
  .ml-left-head p  { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }
  .ml-add-btn {
    display: flex; align-items: center; gap: 6px;
    margin-top: 12px; padding: 9px 14px;
    background: var(--g); color: #fff; border: none; border-radius: 10px;
    font-size: 0.78rem; font-weight: 600; font-family: 'DM Sans', sans-serif;
    cursor: pointer; text-decoration: none; width: 100%; justify-content: center;
    transition: background .18s, transform .12s;
  }
  .ml-add-btn:hover { background: var(--g-dark); transform: translateY(-1px); color: #fff; }

  /* Status filter tabs */
  .ml-filter-tabs {
    display: flex; gap: 4px; padding: 10px 12px;
    border-bottom: 1px solid var(--border); flex-shrink: 0; flex-wrap: wrap;
  }
  .ml-ftab {
    font-size: 0.68rem; font-weight: 600; padding: 4px 10px;
    border-radius: 20px; border: 1.5px solid var(--border);
    background: transparent; color: var(--muted); cursor: pointer;
    font-family: 'DM Sans', sans-serif; transition: all .15s;
  }
  .ml-ftab:hover { border-color: var(--g); color: var(--g); }
  .ml-ftab.active { background: var(--g); color: #fff; border-color: var(--g); }
  .ml-ftab.f-pending.active  { background: #d97706; border-color: #d97706; }
  .ml-ftab.f-approved.active { background: #059669; border-color: #059669; }
  .ml-ftab.f-rejected.active { background: #dc2626; border-color: #dc2626; }

  .ml-search { padding: 10px 18px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .ml-search-wrap {
    display: flex; align-items: center; gap: 7px;
    background: var(--bg); border: 1.5px solid var(--border);
    border-radius: 10px; padding: 7px 11px;
  }
  .ml-search-wrap i { color: var(--muted); font-size: 0.78rem; }
  .ml-search-wrap input {
    border: none; background: transparent; outline: none;
    font-size: 0.78rem; color: var(--ink);
    font-family: 'DM Sans', sans-serif; width: 100%;
  }

  .ml-cards-scroll { flex: 1; overflow-y: auto; padding: 10px 10px 20px; }
  .ml-cards-scroll::-webkit-scrollbar { width: 4px; }
  .ml-cards-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .ml-card {
    display: flex; gap: 10px; padding: 11px 10px; border-radius: 12px;
    cursor: pointer; transition: background .15s, box-shadow .15s;
    border: 1.5px solid transparent; margin-bottom: 4px; position: relative;
  }
  .ml-card:hover { background: var(--bg); }
  .ml-card.active { background: var(--g-dim); border-color: var(--g); }
  .ml-card.active::before {
    content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 3px; height: 60%; background: var(--g); border-radius: 0 3px 3px 0;
  }
  .ml-card-thumb { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
  .ml-card-thumb-placeholder {
    width: 56px; height: 56px; border-radius: 10px; background: var(--border);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .ml-card-thumb-placeholder i { color: var(--muted); font-size: 1rem; }
  .ml-card-info { flex: 1; min-width: 0; }
  .ml-card-title { font-size: 0.8rem; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: sans-serif; }
  .ml-card-loc   { font-size: 0.7rem; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ml-card-meta  { display: flex; align-items: center; gap: 5px; margin-top: 5px; }
  .ml-card-price { font-size: 0.72rem; font-weight: 600; color: var(--g); }
  .status-pill { font-size: 0.62rem; font-weight: 600; padding: 2px 7px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.4px; }
  .status-pill.Pending  { background: #FFF3CD; color: #856404; }
  .status-pill.Approved { background: #D1FAE5; color: #065f46; }
  .status-pill.Rejected { background: #FEE2E2; color: #991b1b; }
  .ml-empty { text-align: center; padding: 40px 20px; color: var(--muted); font-size: 0.8rem; }
  .ml-empty i { font-size: 2rem; display: block; margin-bottom: 8px; color: var(--border); }

  /* ═══ RIGHT PANEL ═══ */
  .ml-right { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: var(--bg); }
  .ml-placeholder {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 12px; color: var(--muted);
  }
  .ml-placeholder .ph-icon {
    width: 72px; height: 72px; border-radius: 50%; background: var(--border);
    display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--muted);
  }

  /* Detail panel */
  .ml-detail { flex: 1; overflow-y: auto; display: none; flex-direction: column; }
  .ml-detail.visible { display: flex; }
  .ml-detail::-webkit-scrollbar { width: 5px; }
  .ml-detail::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  /* Hero slider */
  .ml-hero { position: relative; height: 230px; flex-shrink: 0; overflow: hidden; background: var(--ink); }
  .ml-slider { position: relative; width: 100%; height: 100%; }
  .ml-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.7s ease; }
  .ml-slide.active { opacity: 1; position: relative; z-index: 1; }
  .ml-slide-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(255,255,255,0.92); border: none; width: 34px; height: 34px;
    border-radius: 50%; cursor: pointer; z-index: 20; font-size: 0.75rem;
    display: flex; align-items: center; justify-content: center;
    transition: background .18s, color .18s; box-shadow: 0 2px 8px rgba(0,0,0,0.18);
  }
  .ml-slide-btn:hover { background: var(--g); color: #fff; }
  .ml-slide-btn.prev { left: 12px; }
  .ml-slide-btn.next { right: 12px; }
  .ml-dots { position: absolute; bottom: 14px; width: 100%; text-align: center; z-index: 20; display: flex; align-items: center; justify-content: center; gap: 5px; }
  .ml-dot { height: 6px; width: 6px; background: rgba(255,255,255,0.5); border-radius: 50%; cursor: pointer; transition: width .3s, background .3s; display: inline-block; }
  .ml-dot.active { width: 18px; border-radius: 10px; background: #fff; }
  .ml-hero-overlay { position: absolute; inset: 0; z-index: 5; background: linear-gradient(to bottom, transparent 35%, rgba(0,0,0,.65)); pointer-events: none; }
  .ml-hero-title { position: absolute; bottom: 16px; left: 16px; right: 16px; z-index: 10; pointer-events: none; }
  .ml-hero-title h1 { font-family: sans-serif; font-size: 1.35rem; font-weight: 800; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,.4); }

  /* Action bar */
  .ml-action-bar {
    display: flex; align-items: center; gap: 8px; padding: 14px 20px;
    background: var(--surface); border-bottom: 1px solid var(--border); flex-shrink: 0; flex-wrap: wrap;
  }
  .action-btn {
    display: flex; align-items: center; gap: 6px; padding: 8px 15px; border-radius: 9px;
    font-size: 0.78rem; font-weight: 600; font-family: 'DM Sans', sans-serif;
    cursor: pointer; border: 1.5px solid transparent; text-decoration: none; transition: all .16s;
  }
  .action-btn.primary { background: var(--g); color: #fff; }
  .action-btn.primary:hover { background: var(--g-dark); color: #fff; }
  .action-btn.outline { background: #fff; color: var(--ink); border-color: var(--border); }
  .action-btn.outline:hover { border-color: var(--g); color: var(--g); }
  .action-btn.danger  { background: #fff; color: #dc2626; border-color: #fecaca; }
  .action-btn.danger:hover { background: #fee2e2; }
  .action-btn.ghost   { background: transparent; color: var(--muted); }
  .action-btn.ghost:hover { color: var(--ink); }
  .ml-action-spacer { flex: 1; }
  .ml-status-badge { padding: 6px 12px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; }
  .ml-status-badge.Pending  { background: #fef3c7; color: #92400e; }
  .ml-status-badge.Approved { background: #d1fae5; color: #065f46; }
  .ml-status-badge.Rejected { background: #fee2e2; color: #991b1b; }

  /* Tabs inside detail */
  .ml-tabs {
    display: flex; gap: 0; border-bottom: 1.5px solid var(--border);
    background: var(--surface); flex-shrink: 0;
  }
  .ml-tab {
    padding: 11px 18px; font-size: 0.78rem; font-weight: 600;
    color: var(--muted); cursor: pointer; border-bottom: 2.5px solid transparent;
    transition: color .15s, border-color .15s; white-space: nowrap;
    font-family: 'DM Sans', sans-serif; background: none; border-top: none;
    border-left: none; border-right: none;
  }
  .ml-tab:hover { color: var(--ink); }
  .ml-tab.active { color: var(--g); border-bottom-color: var(--g); }

  /* Tab panels */
  .ml-tab-panel { display: none; }
  .ml-tab-panel.active { display: block; }

  /* Body */
  .ml-body { padding: 22px 22px 40px; }
  .ml-info-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-bottom: 22px; }
  .ml-info-card { background: var(--surface); border-radius: var(--radius); padding: 14px; border: 1px solid var(--border); }
  .ml-info-card .label { font-size: 0.67rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; font-weight: 600; margin-bottom: 4px; }
  .ml-info-card .value { font-size: 1rem; font-weight: 700; color: var(--ink); font-family: sans-serif; }
  .ml-info-card .value.green { color: var(--g); }
  .ml-section { margin-bottom: 20px; }
  .ml-section-title { font-family: sans-serif; font-size: 0.82rem; font-weight: 800; color: var(--ink); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px; }
  .ml-section-title i { color: var(--g); font-size: 0.8rem; }
  .ml-rooms-table { width: 100%; border-collapse: collapse; }
  .ml-rooms-table th { text-align: left; font-size: 0.68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; padding: 8px 10px; background: var(--bg); border-bottom: 1.5px solid var(--border); }
  .ml-rooms-table td { padding: 10px; font-size: 0.78rem; color: var(--ink2); border-bottom: 1px solid var(--border); }
  .ml-rooms-table tbody tr:last-child td { border-bottom: none; }
  .ml-rooms-table tbody tr:hover td { background: var(--bg); }
  .ml-rooms-wrap { background: var(--surface); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
  .ml-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ml-chip { display: flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 20px; font-size: 0.72rem; font-weight: 500; background: var(--surface); border: 1px solid var(--border); color: var(--ink2); }
  .ml-chip i { color: var(--g); font-size: 0.72rem; }
  .ml-rule { display: flex; align-items: flex-start; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.78rem; color: var(--ink2); }
  .ml-rule:last-child { border-bottom: none; }
  .ml-rule i { color: var(--g); font-size: 0.7rem; margin-top: 3px; flex-shrink: 0; }
  .ml-contact-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .ml-contact-item { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; background: var(--surface); border: 1px solid var(--border); font-size: 0.78rem; color: var(--ink2); }
  .ml-contact-item i { color: var(--g); }
  .ml-loc-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; font-size: 0.78rem; color: var(--ink2); line-height: 1.7; }
  .ml-loc-box span { color: var(--muted); font-size: 0.7rem; }

  /* ── ANALYTICS ── */
  .ml-analytics { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; margin-bottom: 22px; }
  .ml-analytic { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; text-align: center; }
  .ml-analytic .an-val { font-family: sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--ink); }
  .ml-analytic .an-label { font-size: 0.68rem; color: var(--muted); margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px; }
  .chart-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; margin-bottom: 16px; }
  .chart-wrap canvas { max-height: 220px; }

  /* ── REVIEWS ── */
  .rev-card {
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 16px; margin-bottom: 10px;
    display: flex; gap: 12px; align-items: flex-start;
  }
  .rev-card:hover { border-color: var(--g); }
  .rev-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--g); color: #fff; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.95rem; flex-shrink: 0; overflow: hidden;
  }
  .rev-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .rev-body { flex: 1; min-width: 0; }
  .rev-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .rev-name { font-size: 0.82rem; font-weight: 700; color: var(--ink); }
  .rev-date { font-size: 0.7rem; color: var(--muted); }
  .rev-stars i { color: #f59e0b; font-size: 0.72rem; }
  .rev-stars .se { color: #d1d5db; }
  .rev-text { font-size: 0.78rem; color: var(--ink2); line-height: 1.6; margin-top: 5px; }
  .rev-del-btn {
    background: none; border: 1.5px solid #fecaca; color: #dc2626;
    padding: 5px 10px; border-radius: 8px; font-size: 0.7rem; font-weight: 600;
    cursor: pointer; flex-shrink: 0; transition: all .15s; font-family: 'DM Sans', sans-serif;
  }
  .rev-del-btn:hover { background: #fee2e2; }
  .rev-empty { text-align: center; padding: 32px; color: var(--muted); font-size: 0.8rem; }
  .rev-empty i { font-size: 1.8rem; display: block; margin-bottom: 8px; color: var(--border); }
  .rev-summary { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--g-dim); border: 1.5px solid rgba(9,184,80,.2); border-radius: var(--radius); margin-bottom: 16px; }
  .rev-summary .rs-num { font-family: sans-serif; font-size: 2rem; font-weight: 800; color: var(--g); line-height: 1; }
  .rev-summary .rs-label { font-size: 0.72rem; color: var(--muted); margin-top: 3px; }
  .rev-summary .rs-stars i { color: #f59e0b; font-size: 0.82rem; }

  /* ── enquirIES ── */
  .inq-empty { text-align: center; padding: 40px; color: var(--muted); font-size: 0.82rem; }
  .inq-empty i { font-size: 2rem; display: block; margin-bottom: 10px; color: var(--border); }
  .inq-card {
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 14px 16px; margin-bottom: 10px;
  }
  .inq-card:hover { border-color: var(--g); }
  .inq-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .inq-name { font-size: 0.82rem; font-weight: 700; color: var(--ink); }
  .inq-date { font-size: 0.7rem; color: var(--muted); }
  .inq-room { display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; font-weight: 600; padding: 3px 9px; border-radius: 20px; background: var(--g-dim); color: var(--g-dark); margin-bottom: 7px; }
  .inq-row  { display: flex; gap: 14px; flex-wrap: wrap; font-size: 0.75rem; color: var(--ink2); }
  .inq-row span { display: flex; align-items: center; gap: 4px; }
  .inq-row i { color: var(--g); font-size: 0.7rem; }
  .inq-msg  { font-size: 0.85rem; color: var(--muted); margin-top: 7px; font-style: italic; line-height: 1.5; border-top: 1px solid var(--border); padding-top: 7px; }
  .inq-badge { font-size: 0.62rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
  .inq-badge.new  { background: #d1fae5; color: #065f46; }
  .inq-badge.seen { background: var(--bg); color: var(--muted); }

  /* modal */
  .ml-modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1000; display: none; align-items: center; justify-content: center; }
  .ml-modal-bg.open { display: flex; }
  .ml-modal { background: var(--surface); border-radius: 18px; padding: 28px 28px 22px; max-width: 380px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,.18); animation: modalIn .2s ease; }
  @keyframes modalIn { from { opacity:0; transform: scale(.94) translateY(10px); } to { opacity:1; transform: none; } }
  .ml-modal h3 { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .ml-modal p  { font-size: 0.82rem; color: var(--muted); margin-bottom: 20px; line-height: 1.6; }
  .ml-modal-btns { display: flex; gap: 8px; justify-content: flex-end; }
  .no-results { display: none; padding: 20px; text-align: center; color: var(--muted); font-size: 0.78rem; }

  @media (max-width: 700px) {
    .ml-shell { width: 100%; margin: 20px auto; flex-direction: column; height: auto; }
    .ml-left  { width: 100%; min-width: unset; height: auto; max-height: 45vh; border-right: none; border-bottom: 1.5px solid var(--border); }
    .ml-right { min-height: 60vh; }
  }
</style>

<div class="ml-shell">

  <!-- ════ LEFT PANEL ════ -->
  <div class="ml-left">
    <div class="ml-left-head">
      <h2>My Properties</h2>
      <p><span id="visibleCount"><%= listings.length %></span> listing<%= listings.length !== 1 ? 's' : '' %></p>
      <a href="/user/list-property" class="ml-add-btn">
        <i class="fa-solid fa-plus"></i> Add New Listing
      </a>
    </div>

    <!-- Status filter tabs -->
    <div class="ml-filter-tabs">
      <button class="ml-ftab active" onclick="filterByStatus('all', this)">All</button>
      <button class="ml-ftab f-pending"  onclick="filterByStatus('Pending', this)">Pending</button>
      <button class="ml-ftab f-approved" onclick="filterByStatus('Approved', this)">Approved</button>
      <button class="ml-ftab f-rejected" onclick="filterByStatus('Rejected', this)">Rejected</button>
    </div>

    <div class="ml-search">
      <div class="ml-search-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="listingSearch" placeholder="Search by name, city…" oninput="filterCards()">
      </div>
    </div>

    <div class="ml-cards-scroll" id="cardsScroll">
      <% if (listings.length === 0) { %>
        <div class="ml-empty">
          <i class="fa-solid fa-house-circle-xmark"></i>
          <p>No listings yet.<br>Add your first property!</p>
        </div>
      <% } else { %>
