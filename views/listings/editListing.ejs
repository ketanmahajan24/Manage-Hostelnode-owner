function markImageDelete(idx, filename) {
  const wrap = document.getElementById(`existImg-${idx}`);
  if (!wrap) return;
  if (wrap.classList.contains('marked-delete')) {
    wrap.classList.remove('marked-delete');
    deletedImages = deletedImages.filter(f => f !== filename);
