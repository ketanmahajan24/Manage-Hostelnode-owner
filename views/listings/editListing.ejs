<script>
/* ============================================================
   CONSTANTS  (identical to listProperty)
============================================================ */
const MAX_IMAGES      = 15;
const MAX_IMG_MB      = 5;
const COMPRESS_MAX_W  = 1280;
const COMPRESS_MAX_H  = 1280;
const COMPRESS_QUALITY = 0.82;
const COMPRESS_FORMAT  = 'image/webp';
const ALLOWED_TYPES    = ['image/jpeg', 'image/png', 'image/webp'];

/* ============================================================
   EDIT PAGE STATE
============================================================ */
let mpLat        = <%= listing.location?.coordinates?.lat || 'null' %>;
let mpLng        = <%= listing.location?.coordinates?.lng || 'null' %>;
let mpConfirmed  = <%= listing.location?.coordinates?.lat ? 'true' : 'false' %>;
let currentMode       = 'click';
let mpSearchTimeout   = null;
let hasUnsavedChanges = false;
let roomCount  = <%= (listing.rooms || []).length %>;
let ruleCount  = <%= Math.max((listing.rules || []).filter(r => r && r.trim()).length, 1) %>;
let uploadedFiles  = [];   // stores compressed File objects for new uploads
let deletedImages  = [];
let toastTimer     = null;

/* ── Shared room-type options HTML ── */
const ROOM_TYPE_OPTIONS = `
  <option value="">— Select room type —</option>
  <optgroup label="🛏️ Sharing Rooms">
    <option>Single Occupancy</option>
    <option>Double Sharing</option>
    <option>Triple Sharing</option>
    <option>4-Bed Sharing</option>
    <option>5-Bed Sharing</option>
    <option>6-Bed Sharing</option>
    <option>Dormitory (7+ Beds)</option>
  </optgroup>
  <optgroup label="❄️ AC Variants">
    <option>AC Single</option>
    <option>AC Double Sharing</option>
    <option>AC Triple Sharing</option>
    <option>AC 4-Bed Sharing</option>
    <option>AC 5-Bed Sharing</option>
    <option>AC Dormitory</option>
  </optgroup>
  <optgroup label="🏠 Flat / Apartment">
    <option>1 RK</option>
    <option>1 BHK</option>
    <option>2 BHK</option>
    <option>3 BHK</option>
    <option>4 BHK</option>
    <option>Studio Apartment</option>
  </optgroup>
  <optgroup label="🚪 Room in Shared Flat">
    <option>Private Room in 2 BHK</option>
    <option>Private Room in 3 BHK</option>
    <option>Private Room in 4 BHK</option>
    <option>Shared Room in Flat (2 Sharing)</option>
    <option>Shared Room in Flat (3 Sharing)</option>
  </optgroup>
  <optgroup label="⭐ Premium / Special">
    <option>Deluxe Single (Attached Bath)</option>
    <option>Deluxe Double (Attached Bath)</option>
    <option>Master Bedroom</option>
    <option>Bunk Bed Room</option>
    <option>Semi-Private Room</option>
    <option>Terrace Room</option>
  </optgroup>
`;

/* ============================================================
   ★ IMAGE COMPRESSION UTILITY  (ported 1:1 from listProperty)
   Canvas-based, runs instantly in browser before upload.
   Input : raw File (JPEG / PNG / WebP)
   Output: compressed File (WebP ≤1280px, quality 0.82)
============================================================ */
function compressImage(file) {
  return new Promise((resolve) => {
    const img = new Image();
    const objectUrl = URL.createObjectURL(file);

    img.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      resolve(file); // fallback: upload original if compression fails
    };

    img.onload = () => {
      URL.revokeObjectURL(objectUrl);

      let { width, height } = img;

      // Scale down proportionally if larger than max dimensions
      if (width > COMPRESS_MAX_W || height > COMPRESS_MAX_H) {
        const ratio = Math.min(COMPRESS_MAX_W / width, COMPRESS_MAX_H / height);
        width  = Math.round(width  * ratio);
        height = Math.round(height * ratio);
      }

      const canvas = document.createElement('canvas');
      canvas.width  = width;
      canvas.height = height;

      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, width, height);

      canvas.toBlob(
        (blob) => {
          if (!blob) { resolve(file); return; }
          const newName = file.name.replace(/\.[^.]+$/, '') + '.webp';
          const compressed = new File([blob], newName, {
            type: COMPRESS_FORMAT,
            lastModified: Date.now(),
          });
          resolve(compressed);
        },
        COMPRESS_FORMAT,
        COMPRESS_QUALITY
      );
    };

    img.src = objectUrl;
  });
}

