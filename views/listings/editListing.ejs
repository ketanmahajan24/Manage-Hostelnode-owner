/* ============================================================
   ★ NEW IMAGE UPLOAD WITH INSTANT COMPRESSION
   Same flow as listProperty:
   pick files → type/size guard → compressImage() →
   store compressed File in uploadedFiles[] → render preview
============================================================ */
function handleFileSelect(e) {
  try { addFiles(Array.from(e.target.files)); } catch(err) { showToast('Could not read selected files.', true); }
}
function handleDrop(e) {
  e.preventDefault();
  try {
    document.getElementById('uploadZone').classList.remove('drag-over');
    addFiles(Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/')));
  } catch(err) { showToast('Drop failed. Please use the browse button.', true); }
}
function handleDragOver(e) {
  e.preventDefault();
  try { document.getElementById('uploadZone').classList.add('drag-over'); } catch(e) {}
}
function handleDragLeave() {
  try { document.getElementById('uploadZone').classList.remove('drag-over'); } catch(e) {}
}

async function addFiles(files) {
  try {
    // Count: existing (not marked for delete) + already added new ones
    const existingKept = document.querySelectorAll('.existing-img-wrap:not(.marked-delete)').length;
    const newAdded     = uploadedFiles.filter(Boolean).length;
    const totalNow     = existingKept + newAdded;
    const slots        = Math.max(0, MAX_IMAGES - totalNow);

    if (slots === 0) {
      showToast(`Maximum ${MAX_IMAGES} photos allowed. Remove some to add more.`, true);
      return;
    }

    const skipped    = [];
    const validFiles = [];

    files.slice(0, slots).forEach(file => {
      if (!ALLOWED_TYPES.includes(file.type)) {
        skipped.push(`"${file.name}" — use JPEG/PNG/WebP`);
        return;
      }
      if (file.size > MAX_IMG_MB * 1024 * 1024) {
        skipped.push(`"${file.name}" — exceeds ${MAX_IMG_MB} MB`);
        return;
      }
      validFiles.push(file);
    });

    if (skipped.length) {
      showToast(`${skipped.length} photo(s) skipped: ${skipped[0]}${skipped.length > 1 ? ` (+${skipped.length-1} more)` : ''}`, true);
    }
    if (files.length > slots) {
      showToast(`Only ${slots} slot(s) remaining. ${files.length - slots} photo(s) not added.`, true);
    }
    if (!validFiles.length) return;

    // ── Show compression progress bar ──
    const progressWrap = document.getElementById('compressProgress');
    const progressBar  = document.getElementById('compressBar');
    const progressText = document.getElementById('compressText');
    progressWrap.style.display = 'block';
    progressBar.style.width = '0%';
    progressText.textContent = `Compressing ${validFiles.length} photo${validFiles.length > 1 ? 's' : ''}…`;

    // ── Compress each file sequentially and update progress bar ──
    const compressed = [];
    for (let idx = 0; idx < validFiles.length; idx++) {
      const result = await compressImage(validFiles[idx]);
      compressed.push(result);
      const pct = Math.round(((idx + 1) / validFiles.length) * 100);
      progressBar.style.width = pct + '%';
      progressText.textContent = `Compressing… ${idx + 1} / ${validFiles.length} done`;
    }

    // Hide progress bar after short delay
    setTimeout(() => { progressWrap.style.display = 'none'; }, 600);

    // ── Render previews for compressed files ──
    compressed.forEach((file, relIdx) => {
      const gi = uploadedFiles.length;
      uploadedFiles.push(file);

      // Dev log: shows compression result in browser console
      const origKB = Math.round(validFiles[relIdx].size / 1024);
      const compKB = Math.round(file.size / 1024);
      console.log(`[HostelNode] ${file.name}: ${origKB} KB → ${compKB} KB (${Math.round((1 - compKB/origKB)*100)}% smaller)`);

      const reader = new FileReader();
      reader.onerror = () => {
        showToast(`Could not read "${file.name}". File may be corrupt.`, true);
        uploadedFiles[gi] = null;
      };
      reader.onload = ev => {
        try {
          const compKB    = Math.round(file.size / 1024);
          const sizeLabel = compKB < 1024 ? `${compKB} KB` : `${(compKB / 1024).toFixed(1)} MB`;

          const wrap = document.createElement('div');
          wrap.className = 'preview-img-wrap';
          wrap.id = `prev-${gi}`;
          wrap.style.position = 'relative';
          wrap.innerHTML = `
            <img src="${ev.target.result}" alt="Preview ${gi + 1}">
            <div style="
              position:absolute;bottom:5px;left:5px;
              background:rgba(0,0,0,0.58);color:#fff;
              font-size:0.63rem;font-weight:700;letter-spacing:0.02em;
              padding:2px 6px;border-radius:4px;pointer-events:none;
              backdrop-filter:blur(2px)">
              📦 ${sizeLabel}
            </div>
            <button type="button" class="preview-remove" onclick="removePreview(${gi})" title="Remove photo">
              <i class="fa-solid fa-xmark"></i>
            </button>`;
          document.getElementById('uploadPreview').appendChild(wrap);

          // Update sidebar preview with first newly added image if no existing images
          const existingCount = document.querySelectorAll('.existing-img-wrap:not(.marked-delete)').length;
          if (existingCount === 0 && gi === 0) {
            document.getElementById('previewImg').src = ev.target.result;
            document.getElementById('previewImg').style.display = 'block';
            const icon = document.querySelector('#previewImgWrap i');
            if (icon) icon.style.display = 'none';
          }

          updateUploadStatus();
          updateProgress();
        } catch(e) {}
      };
      reader.readAsDataURL(file);
    });

    // ── Friendly success toast with savings info ──
    const totalOrigKB = validFiles.reduce((s, f) => s + f.size, 0) / 1024;
    const totalCompKB = compressed.reduce((s, f) => s + f.size, 0) / 1024;
    const savingsPct  = Math.round((1 - totalCompKB / totalOrigKB) * 100);
    showToast(`✅ ${compressed.length} photo${compressed.length > 1 ? 's' : ''} compressed & added — ${savingsPct}% smaller!`);

    showUnsavedBar();
    updateUploadStatus();
  } catch(err) {
    document.getElementById('compressProgress').style.display = 'none';
    showToast('Photo upload error. Please try again.', true);
  }
}

function removePreview(idx) {
  try {
    const el = document.getElementById(`prev-${idx}`);
    if (el) {
      el.style.transition = 'all 0.2s';
      el.style.opacity = '0';
      el.style.transform = 'scale(0.85)';
      setTimeout(() => { try { el.remove(); } catch(e){} }, 210);
    }
    uploadedFiles[idx] = null;
    updateUploadStatus();
    updateProgress();
  } catch(e) {}
}

/* ── Sync compressed files into <input> on submit via DataTransfer ── */
function syncCompressedFilesToInput() {
  try {
    const dt = new DataTransfer();
    uploadedFiles.filter(Boolean).forEach(f => dt.items.add(f));
    document.getElementById('imagesInput').files = dt.files;
  } catch(dtErr) { /* DataTransfer not supported in very old browsers — files fall back naturally */ }
}

function updateUploadStatus() {
  try {
    const count = uploadedFiles.filter(Boolean).length;
    const el  = document.getElementById('uploadStatus');
    const txt = document.getElementById('uploadStatusText');
    if (count > 0) {
      el.style.display = 'block';
      txt.textContent = `${count} new photo${count !== 1 ? 's' : ''} added (auto-compressed to WebP)`;
    } else {
      el.style.display = 'none';
    }
  } catch(e) {}
}

/* ============================================================
   LIVE PREVIEW
============================================================ */
function updatePreview() {
  try {
    const name  = document.getElementById('title').value || 'Your property name';
    const price = document.getElementById('startingPrice').value;
    const addr  = document.getElementById('address').value;
    const coll  = document.getElementById('nearCollege').value;
    document.getElementById('previewName').textContent = name;
    document.getElementById('previewPrice').textContent = price
      ? `₹${Number(price).toLocaleString('en-IN')}/mo` : '₹—/mo';
    let loc = addr || '';
    if (coll) loc += (loc ? ' · ' : '') + 'Near ' + coll;
    document.getElementById('previewLoc').innerHTML =
      `<i class="fa-solid fa-location-dot"></i> ${loc || 'Location · Near College'}`;
  } catch(e) {}
}

/* ============================================================
   CHAR COUNTER
============================================================ */
function updateCharCount(id, cid, max) {
  try {
    const v  = (document.getElementById(id).value || '').length;
    const el = document.getElementById(cid);
    el.textContent = `${v} / ${max}`;
    el.className = 'char-counter' + (v > max * 0.9 ? ' warn' : '') + (v >= max ? ' over' : '');
  } catch(e) {}
}

/* ============================================================
   PROGRESS
============================================================ */
function updateProgress() {
  try {
    const checks = [
      !!(document.getElementById('title').value || '').trim(),
      !!document.getElementById('startingPrice').value,
      !!document.querySelector('input[name="gender"]:checked'),
      !!(document.getElementById('address').value || '').trim(),
      !!(document.getElementById('nearCollege').value || '').trim(),
      mpConfirmed,
      !!(document.querySelector('#roomsList .form-select') && document.querySelector('#roomsList .form-select').value),
      document.querySelectorAll('.amenity-cb:checked').length > 0,
      (document.querySelectorAll('.existing-img-wrap:not(.marked-delete)').length + uploadedFiles.filter(Boolean).length) > 0,
      !!(document.getElementById('phone').value || '').trim(),
    ];
    const done = checks.filter(Boolean).length;
    const pct  = Math.round(done / checks.length * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('pctText').textContent = pct + '%';
    const stepDone = [
      checks[0] && checks[1] && checks[2],
      checks[3] && checks[4] && checks[5],
      checks[6], checks[7], checks[8], checks[9],
    ];
    document.querySelectorAll('.ps-item').forEach((el, i) => el.classList.toggle('done', !!stepDone[i]));
  } catch(e) {}
}

document.addEventListener('DOMContentLoaded', () => {
  try {
    updateProgress();
    document.querySelectorAll('.form-input,.form-select,.form-textarea,input[type="radio"],input[type="checkbox"]').forEach(el => {
      el.addEventListener('input',  updateProgress);
      el.addEventListener('change', updateProgress);
    });
  } catch(e) {}
});

/* ============================================================
   NAV HIGHLIGHT ON SCROLL
============================================================ */
const SECS = ['sec-basic','sec-location','sec-rooms','sec-amenities','sec-media','sec-contact'];
window.addEventListener('scroll', () => {
  try {
    let cur = 0;
    SECS.forEach((id, i) => { const el = document.getElementById(id); if (el && window.scrollY + 100 >= el.offsetTop) cur = i; });
    document.querySelectorAll('.lp-step').forEach((el, i) => el.classList.toggle('active', i === cur));
  } catch(e) {}
}, { passive: true });

/* ============================================================
   SAME NUMBER
============================================================ */
function toggleSameNum() {
  try {
    const cb = document.getElementById('sameNumber');
    const wa = document.getElementById('whatsapp');
    if (cb.checked) {
      wa.value = document.getElementById('phone').value;
      wa.readOnly = true;
      wa.style.background = 'var(--bg2)';
    } else {
      wa.readOnly = false;
      wa.style.background = '';
    }
  } catch(e) {}
}

/* ============================================================
   JUMP
============================================================ */
function jumpTo(id) {
  try { const el = document.getElementById(id); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch(e) {}
}

/* ============================================================
   SUBMIT  — syncs compressed files then submits
============================================================ */
function handleEditSubmit(e) {
  e.preventDefault();

  // Basic required-field checks
  const required = [
    { id:'title',         msg:'Please enter a property title.' },
    { id:'startingPrice', msg:'Please enter the starting price.' },
    { id:'address',       msg:'Please enter the full address.' },
    { id:'nearCollege',   msg:'Please specify the nearest college.' },
    { id:'city',          msg:'Please enter the city.' },
    { id:'phone',         msg:'Please enter a contact phone number.' },
  ];
  for (const f of required) {
    if (!document.getElementById(f.id).value.trim()) {
      showToast(f.msg, true);
      document.getElementById(f.id).focus();
      return;
    }
  }
  if (!document.querySelector('input[name="gender"]:checked')) {
    showToast('Please select who the property is for.', true); return;
  }

  // ── Sync compressed files into <input type="file"> before submit ──
  syncCompressedFilesToInput();

  const btn = document.getElementById('submitBtn');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';
  btn.disabled = true;
  hideUnsavedBar();
  document.getElementById('editForm').submit();
}

/* ============================================================
   WARN BEFORE LEAVING WITH UNSAVED CHANGES
============================================================ */
window.addEventListener('beforeunload', e => {
  if (hasUnsavedChanges) { e.preventDefault(); e.returnValue = ''; }
});

/* ============================================================
   HELPER: update coordinates (called from map if needed)
============================================================ */
function updateCoordinates(lat, lng) {
  document.getElementById('coordLat').value = lat;
  document.getElementById('coordLng').value = lng;
  document.getElementById('dispLat').innerText = lat.toFixed(6);
  document.getElementById('dispLng').innerText = lng.toFixed(6);
}
</script>
