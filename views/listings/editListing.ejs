<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/listingProperty.css">

<style>
/* ── EDIT-SPECIFIC OVERRIDES ── */
.edit-hero-badge { background: #fef3c7; border-color: #fcd34d; color: #92400e; }
.edit-hero-badge .dot { background: #09b850; }
.lp-hero h1 .edit-accent { color: #09b850; }

/* Status banner */
.status-banner {
  padding: 12px clamp(16px,5vw,60px);
  display: flex; align-items: center; gap: 10px;
  font-size: 0.82rem; font-weight: 600;
  border-bottom: 1px solid var(--border);
}
.status-banner.Pending  { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
.status-banner.Approved { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
.status-banner.Rejected { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
.status-banner i { font-size: 0.9rem; flex-shrink: 0; }
.status-banner span { flex: 1; }
.status-banner a {
  font-size: 0.75rem; font-weight: 700;
  padding: 4px 12px; border-radius: var(--radius-full);
  border: 1.5px solid currentColor;
  background: transparent; color: inherit; cursor: pointer;
  text-decoration: none; transition: all 0.18s;
}
.status-banner a:hover { opacity: 0.75; }

/* Changed-field highlight */
.form-input.changed,
.form-select.changed,
.form-textarea.changed {
  border-color: #f59e0b;
  box-shadow: 0 0 0 3px rgba(245,158,11,0.13);
}

/* Image management grid */
.existing-images-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(90px,1fr));
  gap: 10px; margin-bottom: 14px;
}
.existing-img-wrap {
  position: relative; aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden; border: 1.5px solid var(--border);
}
.existing-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.existing-img-wrap .img-delete-btn {
  position: absolute; top: 4px; right: 4px;
  width: 22px; height: 22px; border-radius: 50%;
  background: rgba(220,38,38,0.85); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.6rem; cursor: pointer; border: none;
  opacity: 0; transition: opacity 0.18s;
}
.existing-img-wrap:hover .img-delete-btn { opacity: 1; }
.existing-img-wrap.marked-delete { opacity: 0.35; }
.existing-img-wrap.marked-delete .img-delete-btn { opacity: 1; background: rgba(220,38,38,1); }
.existing-img-wrap .img-cover-tag {
  position: absolute; bottom: 4px; left: 4px;
  font-size: 0.55rem; font-weight: 700; letter-spacing: 0.05em;
  padding: 2px 6px; border-radius: 4px;
  background: var(--green); color: #fff; text-transform: uppercase;
}
.existing-img-wrap .img-set-cover {
  position: absolute; bottom: 4px; left: 4px;
  font-size: 0.6rem; font-weight: 600;
  padding: 2px 7px; border-radius: 4px;
  background: rgba(0,0,0,0.55); color: #fff;
  cursor: pointer; border: none;
  opacity: 0; transition: opacity 0.18s;
}
.existing-img-wrap:hover .img-set-cover { opacity: 1; }
.img-section-label {
  font-size: 0.78rem; font-weight: 600; color: var(--muted);
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 8px;
}
.img-section-label span {
  font-size: 0.68rem; font-weight: 500;
  padding: 2px 8px; border-radius: var(--radius-full);
  background: var(--bg2); color: var(--muted-light);
}
.img-divider {
  height: 1px; background: var(--border);
  margin: 16px 0; position: relative;
}
.img-divider::before {
  content: 'Add more photos';
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  background: var(--white);
  padding: 0 10px;
  font-size: 0.7rem; font-weight: 600; color: var(--muted-light);
}

/* Unsaved changes bar */
.unsaved-bar {
  position: fixed; bottom: 0; left: 20%; right: 0; z-index: 800;
  background: var(--ink); color: #fff;
  padding: 14px 24px;
  display: flex; align-items: center; gap: 12px;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(.22,.68,0,1.2);
  border-top: 3px solid #f59e0b;
}
.unsaved-bar.show { transform: translateY(0); }
.unsaved-bar-text { flex: 1; font-size: 0.82rem; display: flex; align-items: center; gap: 8px; }
.unsaved-bar-text i { color: #09b850; }
.unsaved-discard {
  padding: 8px 16px; border-radius: var(--radius-sm);
  border: 1.5px solid rgba(255,255,255,0.2); background: transparent;
  color: rgba(255,255,255,0.7); font-size: 0.8rem; font-weight: 600;
  cursor: pointer; transition: all 0.18s;
}
.unsaved-discard:hover { border-color: rgba(255,255,255,0.5); color: #fff; }
.unsaved-save {
  padding: 9px 22px; border-radius: var(--radius-sm);
  border: none; background: #09b850;
  color: #fff; font-size: 0.82rem; font-weight: 700;
  cursor: pointer; font-family: var(--font-d);
  display: flex; align-items: center; gap: 7px;
  transition: background 0.18s;
}
.unsaved-save:hover { background: #09b850; }

/* ── Compression progress bar (same as listProperty) ── */
#compressProgress { transition: opacity 0.3s; }
</style>


<!-- HERO -->
<div class="lp-hero">
<!-- STATUS BANNER -->
<div class="status-banner <%= listing.status %>" id="statusBanner">
  <% if (listing.status === 'Pending') { %>
    <i class="fa-solid fa-clock"></i>
    <span>This listing is <strong>pending review</strong> — our team will approve it within 24 hours.</span>
  <% } else if (listing.status === 'Approved') { %>
    <i class="fa-solid fa-circle-check"></i>
    <span>This listing is <strong>live and approved</strong>. Changes will need re-approval.</span>
    <a href="/listings/<%= listing.slug %>" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> View live</a>
  <% } else if (listing.status === 'Rejected') { %>
    <i class="fa-solid fa-circle-xmark"></i>
    <span>This listing was <strong>rejected</strong>. Fix the issues below and resubmit.</span>
  <% } %>
</div>

<br>
  <div class="lp-hero-inner">
    <div class="lp-hero-text">
      <div class="lp-hero-badge edit-hero-badge"><div class="dot" style="background:#f59e0b"></div> Editing Listing</div>
      <h1>Edit your <span class="edit-accent" style="color:#f59e0b">property</span> details</h1>
      <p>Update your listing information. Changes will be reviewed before going live again.</p>
    </div>
    <div class="lp-steps-strip">
      <div class="lp-step active" id="navStep1" onclick="jumpTo('sec-basic')"><div class="step-circle">1</div><span class="step-label">Basic</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep2" onclick="jumpTo('sec-location')"><div class="step-circle">2</div><span class="step-label">Location</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep3" onclick="jumpTo('sec-rooms')"><div class="step-circle">3</div><span class="step-label">Rooms</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep4" onclick="jumpTo('sec-amenities')"><div class="step-circle">4</div><span class="step-label">Amenities</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep5" onclick="jumpTo('sec-media')"><div class="step-circle">5</div><span class="step-label">Photos</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep6" onclick="jumpTo('sec-contact')"><div class="step-circle">6</div><span class="step-label">Contact</span></div>
    </div>
  </div>
</div>

<!-- MAIN BODY -->
<div class="lp-body">
  <div class="lp-form-col">
  <form id="editForm"
        action="/user/listing/<%=listing._id%>/edit"
        method="POST"
        enctype="multipart/form-data"
        novalidate>

    <!-- ── SECTION 1: BASIC ── -->
    <div class="form-section" id="sec-basic">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-house"></i></div>
        <div class="section-title-text"><h3>Basic Information</h3><p>Core details about your property</p></div>
        <span class="section-num">01 / 06</span>
      </div>

      <!-- Property Type -->
      <div class="form-group" style="margin-bottom:18px">
        <label class="form-label">Property Type <span class="label-required">*</span></label>
        <div class="type-selector">
          <div>
            <input type="radio" name="propertyType" id="typeHostel" class="type-option" value="Hostel" <%= listing.propertyType === 'Hostel' ? 'checked' : '' %>>
            <label for="typeHostel" class="type-label"><div class="type-icon"><i class="fa-solid fa-building"></i></div><div class="type-name">Hostel</div><div class="type-desc">Shared with warden</div></label>
          </div>
          <div>
            <input type="radio" name="propertyType" id="typePG" class="type-option" value="PG" <%= listing.propertyType === 'PG' ? 'checked' : '' %>>
            <label for="typePG" class="type-label"><div class="type-icon"><i class="fa-solid fa-house-user"></i></div><div class="type-name">PG</div><div class="type-desc">With meals & services</div></label>
          </div>
          <div>
            <input type="radio" name="propertyType" id="typeFlat" class="type-option" value="Flat" <%= listing.propertyType === 'Flat' ? 'checked' : '' %>>
            <label for="typeFlat" class="type-label"><div class="type-icon"><i class="fa-solid fa-door-open"></i></div><div class="type-name">Flat</div><div class="type-desc">Shared apartment</div></label>
          </div>
        </div>
      </div>

      <!-- Gender -->
      <div class="form-group" style="margin-bottom:18px">
        <label class="form-label">For whom? <span class="label-required">*</span></label>
        <div class="gender-selector">
          <div>
            <input type="radio" name="gender" id="gBoys" class="gender-option boys" value="Boys" <%= listing.gender === 'Boys' ? 'checked' : '' %> required>
            <label for="gBoys" class="gender-label"><i class="fa-solid fa-mars"></i> Boys only</label>
          </div>
          <div>
            <input type="radio" name="gender" id="gGirls" class="gender-option girls" value="Girls" <%= listing.gender === 'Girls' ? 'checked' : '' %>>
            <label for="gGirls" class="gender-label"><i class="fa-solid fa-venus"></i> Girls only</label>
          </div>
          <div>
            <input type="radio" name="gender" id="gCoed" class="gender-option" value="Co-ed" <%= listing.gender === 'Co-ed' ? 'checked' : '' %>>
            <label for="gCoed" class="gender-label"><i class="fa-solid fa-venus-mars"></i> Co-ed</label>
          </div>
        </div>
      </div>

      <div class="form-grid">
        <!-- Title -->
        <div class="form-group full">
          <label class="form-label" for="title">Property Name / Title <span class="label-required">*</span><span class="label-hint">e.g. "Sai Niwas Boys Hostel"</span></label>
          <input type="text" id="title" name="title" class="form-input" value="<%= listing.title %>"
            maxlength="80" oninput="updateCharCount('title','titleCount',80);updatePreview();markChanged(this)" required>
          <div class="char-counter" id="titleCount"><%= listing.title.length %> / 80</div>
        </div>

        <!-- Starting Price -->
        <div class="form-group">
          <label class="form-label" for="startingPrice">Starting Price / month <span class="label-required">*</span></label>
          <div class="input-icon-wrap has-prefix">
            <span class="input-prefix">₹</span>
            <input type="number" id="startingPrice" name="startingPrice" class="form-input"
              value="<%= listing.startingPrice %>" min="500" required
              oninput="updatePreview();markChanged(this)">
          </div>
        </div>

        <!-- Deposit -->
        <div class="form-group">
          <label class="form-label" for="deposit">Security Deposit<span class="label-hint">Optional</span></label>
          <div class="input-icon-wrap has-prefix">
            <span class="input-prefix">₹</span>
            <input type="number" id="deposit" name="deposit" class="form-input"
              value="<%= listing.deposit || '' %>" min="0" oninput="markChanged(this)">
          </div>
        </div>

        <!-- Capacity -->
        <div class="form-group">
          <label class="form-label" for="capacity">Total Capacity</label>
          <div class="input-icon-wrap">
            <i class="input-icon fa-solid fa-users"></i>
            <input type="number" id="capacity" name="capacity" class="form-input"
              value="<%= listing.capacity || '' %>" min="1" oninput="markChanged(this)">
          </div>
        </div>

        <!-- Description -->
        <div class="form-group full">
          <label class="form-label" for="description">Description <span class="label-required">*</span><span class="label-hint">What makes your place great?</span></label>
          <textarea id="description" name="description" class="form-textarea"
            maxlength="1000" rows="4"
            oninput="updateCharCount('description','descCount',1000);markChanged(this)"
            required><%= listing.description %></textarea>
          <div class="char-counter" id="descCount"><%= (listing.description || '').length %> / 1000</div>
        </div>
      </div>
    </div><!-- /sec-basic -->

    <!-- ── SECTION 2: LOCATION + MAP ── -->
    <div class="form-section" id="sec-location">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-location-dot"></i></div>
        <div class="section-title-text"><h3>Location & Map Pin</h3><p>Update your address and map location</p></div>
        <span class="section-num">02 / 06</span>
      </div>

      <div class="form-grid" style="margin-bottom:20px">
        <div class="form-group full">
          <label class="form-label" for="address">Full Address <span class="label-required">*</span></label>
          <div class="input-icon-wrap">
            <i class="input-icon fa-solid fa-location-dot"></i>
            <input type="text" id="address" name="location[address]" class="form-input"
              value="<%= listing.location?.address %>" required
              oninput="updatePreview();markChanged(this)">
          </div>
        </div>

        <div class="form-group full">
          <label class="form-label" for="nearCollege">Nearest College / Place <span class="label-required">*</span><span class="label-hint">Students search by College / University / Institute / Place name</span></label>
          <div class="input-icon-wrap">
            <i class="input-icon fa-solid fa-graduation-cap"></i>
            <input type="text" id="nearCollege" name="location[nearCollege]" class="form-input"
              value="<%= listing.location?.nearCollege || '' %>" required
              oninput="updatePreview();markChanged(this)">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="city">City <span class="label-required">*</span></label>
          <input type="text" id="city" name="location[city]" class="form-input"
            value="<%= listing.location?.city || '' %>" required oninput="markChanged(this)">
        </div>

        <div class="form-group">
          <label class="form-label" for="state">State</label>
          <select id="state" name="location[state]" class="form-select" onchange="markChanged(this)">
            <option value="">Select state</option>
            <% ['Maharashtra','Delhi','Karnataka','Tamil Nadu','Telangana','Gujarat','Rajasthan','Uttar Pradesh','West Bengal','Madhya Pradesh','Punjab','Haryana','Kerala','Andhra Pradesh','Bihar','Jharkhand','Odisha','Assam','Other'].forEach(s => { %>
              <option value="<%= s %>" <%= listing.location?.state === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="pincode">Pincode</label>
          <input type="text" id="pincode" name="location[pincode]" class="form-input"
            value="<%= listing.location?.pincode || '' %>" maxlength="6" pattern="[0-9]{6}"
            oninput="markChanged(this)">
        </div>

        <div class="form-group">
          <label class="form-label">Country</label>
          <input type="text" name="location[country]" class="form-input" value="India" readonly
            style="background:var(--bg2);color:var(--muted)">
        </div>
      </div>

      <!-- Hidden coord inputs -->
      <input type="hidden" id="coordLat" name="location[coordinates][lat]"
             value="<%= listing.location?.coordinates?.lat || '' %>">
      <input type="hidden" id="coordLng" name="location[coordinates][lng]"
             value="<%= listing.location?.coordinates?.lng || '' %>">

      <!-- MAP PICKER -->
      <label class="form-label" style="margin-bottom:10px;display:flex;align-items:center;gap:6px;">
        <i class="fa-solid fa-map-pin" style="color:var(--green)"></i>
        Update your map pin
        <span id="confirmedBadge" class="mp-confirmed-badge <%= listing.location?.coordinates?.lat ? 'show' : '' %>" style="margin-left:auto">
          <i class="fa-solid fa-circle-check" style="font-size:0.8rem"></i>
          <%= listing.location?.coordinates?.lat ? 'Location pinned' : 'Not pinned yet' %>
        </span>
      </label>

      <div class="map-picker-wrap <%= listing.location?.coordinates?.lat ? 'pinned' : '' %>" id="mapPickerWrap">

        <div class="mp-searchbar">
          <div class="mp-searchbar-inner">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="mpSearchInput"
              placeholder="Search college, area, landmark..."
              oninput="onMpInput()"
              onkeydown="if(event.key==='Enter'){event.preventDefault();doMpSearch()}">
          </div>
          <button type="button" class="mp-searchbar-btn green" onclick="doMpSearch()">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
          <button type="button" class="mp-searchbar-btn ghost" onclick="useGps()">
            <i class="fa-solid fa-location-crosshairs" style="color:var(--green)"></i> GPS
          </button>
        </div>

        <div class="mp-sugg-outer" id="mpSuggOuter">
          <div class="mp-sugg-drop" id="mpSuggDrop"></div>
        </div>

        <div class="mp-toolbar">
          <button type="button" class="mp-mode-btn active" id="modeClick" onclick="setMode('click')">
            <i class="fa-solid fa-hand-pointer"></i> Click to pin
          </button>
          <button type="button" class="mp-mode-btn" id="modeDrag" onclick="setMode('drag')">
            <i class="fa-solid fa-up-down-left-right"></i> Pan & explore
          </button>
          <div class="mp-toolbar-sep"></div>
          <button type="button" class="mp-mode-btn" onclick="resetMap()" style="color:#ef4444;border-color:#fecaca">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </button>
          <div class="mp-status-chip">
            <div class="mp-status-dot <%= listing.location?.coordinates?.lat ? 'green' : '' %>" id="mpDot"></div>
            <span id="mpStatusText">
              <%= listing.location?.coordinates?.lat
                ? 'Pin saved — click to update location'
                : 'Click on map to drop pin' %>
            </span>
          </div>
        </div>

        <div class="mp-map-container" id="mpMapContainer">
          <div class="mp-map-loader hidden" id="mpLoader">
            <div class="mp-spinner"></div>
            <p>Loading map…</p>
          </div>
          <iframe id="mpIframe"
            src="https://maps.google.com/maps?q=<%= listing.location?.coordinates?.lat ? listing.location.coordinates.lat + ',' + listing.location.coordinates.lng : encodeURIComponent((listing.location?.address || '') + ' ' + (listing.location?.city || '') + ' India') %>&z=<%= listing.location?.coordinates?.lat ? 17 : 14 %>&output=embed"
            onload="onIframeLoad()"
            title="Location map">
          </iframe>
          <div class="mp-click-overlay" id="mpOverlay" onclick="handleMapClick(event)"></div>
          <div class="mp-pin" id="mpPin" style="<%= listing.location?.coordinates?.lat ? 'display:block;left:50%;top:50%' : 'display:none' %>">
            <svg width="36" height="44" viewBox="0 0 36 44" fill="none">
              <path d="M18 0C8.06 0 0 8.06 0 18c0 13.5 18 26 18 26s18-12.5 18-26C36 8.06 27.94 0 18 0z" fill="#09b850"/>
              <circle cx="18" cy="18" r="7" fill="white"/>
              <circle cx="18" cy="18" r="4" fill="#09b850"/>
            </svg>
            <div class="mp-pin-pulse"></div>
          </div>
          <div class="mp-ripple" id="mpRipple"></div>
        </div>

        <div class="mp-coords-bar">
          <div class="mp-coord-box">
            <div class="mp-coord-label">Latitude</div>
            <div class="mp-coord-value <%= listing.location?.coordinates?.lat ? 'filled' : 'empty' %>" id="dispLat">
              <%= listing.location?.coordinates?.lat ? listing.location.coordinates.lat.toFixed(6) : 'Not set yet' %>
            </div>
          </div>
          <div class="mp-coord-box">
            <div class="mp-coord-label">Longitude</div>
            <div class="mp-coord-value <%= listing.location?.coordinates?.lng ? 'filled' : 'empty' %>" id="dispLng">
              <%= listing.location?.coordinates?.lng ? listing.location.coordinates.lng.toFixed(6) : 'Not set yet' %>
            </div>
          </div>
          <div class="mp-coord-box">
            <div class="mp-coord-label">Address</div>
            <div class="mp-coord-value <%= listing.location?.address ? 'filled' : 'empty' %>" id="dispAddr"
                 style="font-size:0.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px">
              <%= listing.location?.address || 'Drop pin to detect' %>
            </div>
          </div>
          <button type="button" class="mp-confirm-btn" id="mpConfirmBtn"
                  onclick="confirmPin()"
                  <%= listing.location?.coordinates?.lat ? '' : 'disabled' %>>
            <i class="fa-solid fa-circle-check"></i>
            <%= listing.location?.coordinates?.lat ? 'Pinned ✓' : 'Confirm Pin' %>
          </button>
        </div>

        <div class="mp-tip">
          <i class="fa-solid fa-lightbulb"></i>
          <span><strong>To update pin:</strong> Search your area, then click the exact location on the map. Hit "Confirm Pin" to save.</span>
        </div>
      </div>
    </div><!-- /sec-location -->

    <!-- ── SECTION 3: ROOMS ── -->
    <div class="form-section" id="sec-rooms">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-bed"></i></div>
        <div class="section-title-text"><h3>Rooms & Pricing</h3><p>Update your room types and prices</p></div>
        <span class="section-num">03 / 06</span>
      </div>

      <div class="rooms-list" id="roomsList">
        <%
          const ALL_ROOM_TYPES = [
            'Single Occupancy','Double Sharing','Triple Sharing',
            '4-Bed Sharing','5-Bed Sharing','6-Bed Sharing','Dormitory (7+ Beds)',
            'AC Single','AC Double Sharing','AC Triple Sharing','AC 4-Bed Sharing','AC 5-Bed Sharing','AC Dormitory',
            '1 RK','1 BHK','2 BHK','3 BHK','4 BHK','Studio Apartment',
            'Private Room in 2 BHK','Private Room in 3 BHK','Private Room in 4 BHK',
            'Shared Room in Flat (2 Sharing)','Shared Room in Flat (3 Sharing)',
            'Deluxe Single (Attached Bath)','Deluxe Double (Attached Bath)',
            'Master Bedroom','Bunk Bed Room','Semi-Private Room','Terrace Room'
          ];
        %>
        <% (listing.rooms || []).forEach((room, i) => { %>
        <%   const isLegacy = room.type && !ALL_ROOM_TYPES.includes(room.type); %>
        <div class="room-entry" id="room-<%= i %>">
          <div class="room-entry-header">
            <div class="room-entry-title">
              <span class="room-num"><%= i+1 %></span> Room Type <%= i+1 %>
            </div>
            <button type="button" class="btn-remove-room" onclick="removeRoom('room-<%= i %>')">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
          <div class="room-grid">
