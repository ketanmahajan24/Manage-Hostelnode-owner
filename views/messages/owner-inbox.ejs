<!-- owner-inbox.ejs — HostelNode Owner-side PG/Hostel Messages inbox
     NEW in Phase 4. Lists every PG_INQUIRY conversation where this
     Owner is the ownerParticipant — i.e. every student who has
     started a "Chat with Owner" conversation on one of this owner's
     listings. Flatmate chat has no owner side at all, so there is
     nothing to list here for it — this page is PG/Hostel-only by
     construction (the query itself only ever matches type: "PG_INQUIRY"). -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages | HostelNode Owner</title>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: var(--bg); }
    .own-topbar { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--border); background: #fff; }
    .own-topbar a.back { color: var(--muted); font-size: 16px; text-decoration: none; }
    .own-topbar .brand { font-family: var(--font-d); font-weight: 800; color: var(--ink); font-size: 15px; }
    .own-topbar .brand span { color: var(--green-dark); }

    .inbox-wrap { max-width: 640px; margin: 0 auto; padding: 24px 16px; }
    .inbox-title { font-family: var(--font-d); font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 18px; }

    .row { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid var(--border); border-radius: 14px; margin-bottom: 10px; text-decoration: none; background: #fff; transition: border-color .15s, box-shadow .15s; }
    .row:hover { border-color: var(--green); box-shadow: var(--shadow-sm); }
    .row-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--green), #00c264); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }
    .row-body { flex: 1; min-width: 0; }
    .row-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .row-name { font-size: 14px; font-weight: 700; color: var(--ink); }
    .row-time { font-size: 11px; color: var(--muted); flex-shrink: 0; }
    .row-listing { font-size: 11.5px; color: var(--green-dark); font-weight: 600; margin: 2px 0; }
    .row-last { font-size: 12.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row-unread { background: #e53e3e; color: #fff; font-size: 11px; font-weight: 700; min-width: 20px; height: 20px; border-radius: 999px; display: flex; align-items: center; justify-content: center; padding: 0 5px; flex-shrink: 0; }

    .empty-state { text-align: center; padding: 60px 20px; color: var(--muted); }
    .empty-state i { font-size: 2rem; color: var(--border-dark); margin-bottom: 12px; display: block; }
  </style>
</head>
<body>

<div class="own-topbar">
  <a href="/user" class="back"><i class="fa-solid fa-arrow-left"></i></a>
  <div class="brand">Hostel<span>Node</span> · Messages</div>
</div>

<div class="inbox-wrap">
  <div class="inbox-title">PG / Hostel Enquiries</div>

  <% if (!rows || rows.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-comment-slash"></i>
      No enquiries yet. When a student starts a chat from one of your listings, it'll show up here.
    </div>
  <% } else { %>
    <% rows.forEach(function(row) { %>
      <a class="row" href="/user/messages/<%= row.conversationId %>">
        <div class="row-avatar"><%= (row.studentName || 'S')[0] %></div>
        <div class="row-body">
          <div class="row-top">
            <span class="row-name"><%= row.studentName %></span>
            <span class="row-time"><%= row.updatedAt ? new Date(row.updatedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '' %></span>
          </div>
          <div class="row-listing"><%= row.listingTitle %></div>
          <div class="row-last"><%= row.lastMessage || 'No messages yet' %></div>
        </div>
        <% if (row.unread > 0) { %>
          <div class="row-unread"><%= row.unread %></div>
        <% } %>
      </a>
    <% }) %>
  <% } %>
</div>

</body>
</html>
