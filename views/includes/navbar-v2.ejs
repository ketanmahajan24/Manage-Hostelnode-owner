<%#
  ════════════════════════════════════════════════════════════
  views/includes/navbar-v2.ejs  —  Phase 1: approved navbar shell
  The previous views/includes/navbar.ejs is left untouched and is
  still used when HN_NEW_UI=0 (see layouts/boilerplate.ejs).

  Reads (all optional — every read is guarded with typeof):
    user            Owner document (every owner route already passes it)
    hostels         from attachHostel
    selectedHostel  from attachHostel
    hn2             from Middlewares/navData.js (badge counts, setup)
  ════════════════════════════════════════════════════════════
%>
<%
  // Note: ejs-mate puts its own object at `locals`, so page data must be
  // read by name, guarded with typeof (a missing name would throw).
  const hnUser    = (typeof user !== "undefined" && user) || {};
  const hnHostels = (typeof hostels !== "undefined" && Array.isArray(hostels)) ? hostels : [];
  const hnSel     = (typeof selectedHostel !== "undefined" && selectedHostel) || null;
  const hnData    = (typeof hn2 !== "undefined" && hn2) || {};
  const hnSetup   = hnData.setup || { done: 4, total: 4, next: null };
  const hnUnread  = Number(hnData.unreadMessages) || 0;
  const hnNewEnq  = Number(hnData.newEnquiries) || 0;
  const hnNotif   = Number(hnData.unreadNotifications) || 0;

  const hnName     = String(hnUser.name || "Owner").trim();
  const hnFirst    = hnName.split(/\s+/)[0] || "Owner";
  const hnInitials = hnName.split(/\s+/).filter(Boolean).slice(0, 2).map(p => p[0].toUpperCase()).join("") || "O";
  const hnSelId    = hnSel && hnSel._id ? String(hnSel._id) : "";
  const hnSelSub   = hnSel ? [hnSel.hostelId, hnSel.city].filter(Boolean).join(" · ") : "Add your first property";

  const hnStatus = hnUser.status || "Pending";
  const hnStatusClass = hnStatus === "Active" ? "is-ok" : hnStatus === "Inactive" ? "is-bad" : "is-warn";

  const hnCount = n => (n > 99 ? "99+" : String(n));

  // Inline stroke icons — same shapes as the approved design.
  const P = {
    dash:     '<rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect>',
    msg:      '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>',
    property: '<path d="M4 21V7l8-4 8 4v14"></path><path d="M9 21v-6h6v6"></path>',
    down:     '<path d="m6 9 6 6 6-6"></path>',
    right:    '<path d="m9 6 6 6-6 6"></path>',
    tenants:  '<path d="M16 21v-4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v4"></path><circle cx="12" cy="7" r="4"></circle>',
    rupee:    '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>',
    rooms:    '<rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path>',
    reports:  '<path d="M3 3v18h18"></path><path d="M7 15l4-5 3 3 5-7"></path>',
    home:     '<path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path>',
    plus:     '<path d="M12 5v14M5 12h14"></path>',
    funnel:   '<path d="M22 3H2l8 9.5V19l4 2v-8.5z"></path>',
    doc:      '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path>',
    team:     '<circle cx="9" cy="7" r="3.2"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M17 8.5c1.3.3 2.3 1.5 2.3 3S18.3 14.2 17 14.5"></path><path d="M20 20a5 5 0 0 0-3.2-4.7"></path>',
    help:     '<circle cx="12" cy="12" r="10"></circle><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2-3 4M12 17h.01"></path>',
    collapse: '<path d="m11 17-5-5 5-5M18 17l-5-5 5-5"></path>',
    bell:     '<path d="M6 8a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6"></path><path d="M10 21a2 2 0 0 0 4 0"></path>',
    clock:    '<circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path>',
    user:     '<circle cx="12" cy="8" r="4"></circle><path d="M4 21v-1a8 8 0 0 1 16 0v1"></path>',
    gear:     '<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path>',
    card:     '<rect x="1" y="4" width="22" height="16" rx="2.5"></rect><path d="M1 10h22"></path>',
    shield:   '<path d="M12 2 3 6v6c0 5 4 9 9 10 5-1 9-5 9-10V6z"></path><path d="m9 12 2 2 4-4"></path>',
    logout:   '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path>',
    check:    '<path d="M20 6 9 17l-5-5"></path>',
    burger:   '<path d="M3 6h18M3 12h18M3 18h18"></path>',
    mail:     '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>',
    phone:    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>',
    bed:      '<path d="M2 4v16"></path><path d="M2 8h18a2 2 0 0 1 2 2v10"></path><path d="M2 17h20"></path><path d="M6 8v9"></path>',
    layers:   '<path d="m12 2 9 5-9 5-9-5z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>'
  };
  const svg = (name, size, stroke, width, cls) =>
    '<svg class="' + (cls || '') + '" width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="' + stroke +
    '" stroke-width="' + (width || 2) + '" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + P[name] + '</svg>';
%>
<script>
  /* Apply the saved rail state before the sidebar paints (no flash). */
  try { if (localStorage.getItem('hn2-collapsed') === '1') document.documentElement.classList.add('hn2-collapsed'); } catch (e) {}
</script>

<div class="hn2-shell" id="hn2Shell">
  <div class="hn2-overlay" data-hn2-close-drawer></div>

  <!-- ════════════════ SIDEBAR ════════════════ -->
  <aside class="hn2-sidebar" id="hn2Sidebar" aria-label="Main navigation">

    <!-- Brand strip -->
    <a class="hn2-brand" href="/user" aria-label="HostelNode home">
      <img src="/images/hostelnode-logo-cutout.png" alt="">
      <span class="hn2-wordmark hn2-hide-rail">Hostel<span>Node</span></span>
    </a>

    <nav class="hn2-nav">

      <!-- Global: Dashboard + Messages -->
      <a class="hn2-item" href="/user" data-hn2-match="^/user/?$" title="Dashboard" style="margin-bottom:2px">
        <%- svg('dash', 17, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Dashboard</span>
      </a>
      <a class="hn2-item is-strong" href="/user/messages" data-hn2-match="^/user/messages" title="Messages" style="margin-bottom:10px">
        <%- svg('msg', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Messages</span>
        <% if (hnUnread > 0) { %><span class="hn2-count" aria-label="<%= hnUnread %> unread"><%= hnCount(hnUnread) %></span><% } %>
      </a>

      <div class="hn2-divider is-top"></div>

      <!-- Property switcher: scopes everything in Property Operations below -->
      <div class="hn2-switcher" id="hn2Switcher">
        <button type="button" class="hn2-switch-btn" data-hn2-toggle="switcher" aria-expanded="false" aria-controls="hn2SwitchList"
                title="<%= hnSel ? hnSel.hostelName : 'Select property' %>">
          <span class="hn2-switch-ic"><%- svg('property', 13, '#34d399', 2.3) %></span>
          <span class="hn2-switch-text hn2-hide-rail">
            <span class="hn2-switch-name"><%= hnSel ? hnSel.hostelName : 'Select property' %></span>
            <span class="hn2-switch-sub"><%= hnSelSub %></span>
          </span>
          <span class="hn2-hide-rail"><%- svg('down', 12, '#34d399', 2.6, 'hn2-switch-chev') %></span>
        </button>

        <div class="hn2-switch-list" id="hn2SwitchList">
          <div class="hn2-switch-head">Switch property</div>
          <% if (hnHostels.length > 8) { %>
            <input type="search" class="hn2-switch-search" placeholder="Search properties" aria-label="Search properties" data-hn2-switch-search>
          <% } %>
          <% if (hnHostels.length) { %>
            <% hnHostels.forEach(function (h) { const isCur = String(h._id) === hnSelId; %>
              <a class="hn2-switch-opt <%= isCur ? 'is-current' : '' %>"
                 href="/user/hostel/<%= h._id %>" data-hn2-switch-opt
                 data-hn2-search="<%= (h.hostelName + ' ' + (h.hostelId || '') + ' ' + (h.city || '')).toLowerCase() %>">
                <%- svg('property', 14, isCur ? '#34d399' : '#828b96', 2) %>
                <span class="hn2-opt-text">
                  <span class="hn2-opt-name"><%= h.hostelName %></span>
                  <span class="hn2-opt-sub"><%= [h.hostelId, h.city].filter(Boolean).join(' · ') %></span>
                </span>
                <% if (isCur) { %><%- svg('check', 13, '#34d399', 2.6) %><% } %>
              </a>
            <% }) %>
          <% } else { %>
            <div class="hn2-switch-empty">No properties yet.</div>
          <% } %>
          <a class="hn2-switch-add" href="/user/addnewhostel">
            <%- svg('plus', 13, '#34d399', 2.4) %> Add new property
          </a>
        </div>
      </div>

      <!-- ZONE 1 — Property Operations -->
      <div class="hn2-zone hn2-hide-rail">
        <div class="hn2-zone-title">Property Operations</div>
        <div class="hn2-zone-note">Tenants, payments &amp; rooms below are scoped to <%= hnSel ? hnSel.hostelName : 'the selected property' %></div>
      </div>

      <button type="button" class="hn2-item" data-hn2-sub="hn2SubTenants" aria-controls="hn2SubTenants" title="Tenants" aria-expanded="false">
        <%- svg('tenants', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Tenants</span>
        <span class="hn2-hide-rail"><%- svg('right', 12, '#5b6470', 2.4, 'hn2-chev') %></span>
      </button>
      <div class="hn2-sub" id="hn2SubTenants">
        <a class="hn2-subitem" href="/user/members"      data-hn2-match="^/user/(members/?$|member-edit/|member/search)">All Tenants</a>
        <a class="hn2-subitem" href="/user/newmember"    data-hn2-match="^/user/(newmember|newMember|newAdded)">Add Tenant</a>
        <a class="hn2-subitem" href="/user/activeMember" data-hn2-match="^/user/activeMember">Active Tenants</a>
      </div>

      <button type="button" class="hn2-item" data-hn2-sub="hn2SubPayments" aria-controls="hn2SubPayments" title="Payments" aria-expanded="false">
        <%- svg('rupee', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Payments</span>
        <span class="hn2-hide-rail"><%- svg('right', 12, '#5b6470', 2.4, 'hn2-chev') %></span>
      </button>
      <div class="hn2-sub" id="hn2SubPayments">
        <a class="hn2-subitem is-accent" href="/user/allfeesrecords"
           data-hn2-match="^/user/(allfeesrecords|searchfeesrecords|members/[^/]+/addpayment|addpayment/|payment-receipt/|payment-history/)">
          Collect Payment <span class="hn2-pill-new">NEW</span>
        </a>
        <a class="hn2-subitem" href="/user/upcomingPayments" data-hn2-match="^/user/upcomingPayments">Upcoming</a>
        <a class="hn2-subitem" href="/user/deureports"       data-hn2-match="^/user/deureports">Dues</a>
      </div>

      <button type="button" class="hn2-item" data-hn2-sub="hn2SubRooms" aria-controls="hn2SubRooms" title="Rooms &amp; Floors" aria-expanded="false">
        <%- svg('rooms', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Rooms &amp; Floors</span>
        <span class="hn2-hide-rail"><%- svg('right', 12, '#5b6470', 2.4, 'hn2-chev') %></span>
      </button>
      <div class="hn2-sub" id="hn2SubRooms">
        <a class="hn2-subitem" href="/user/allrooms"    data-hn2-match="^/user/allrooms">All Rooms</a>
        <a class="hn2-subitem" href="/user/managerooms" data-hn2-match="^/user/(managerooms|manageroom/|newroom)">Manage Rooms</a>
        <a class="hn2-subitem" href="/user/floors"      data-hn2-match="^/user/floors">All Floors</a>
        <a class="hn2-subitem" href="/user/managefloor" data-hn2-match="^/user/(managefloor|newfloor)">Manage Floors</a>
      </div>

      <a class="hn2-item" href="/user/revenue" data-hn2-match="^/user/revenue" title="Reports">
        <%- svg('reports', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Reports</span>
      </a>

      <!-- ZONE 2 — Marketplace & Growth (all properties) -->
      <div class="hn2-divider"></div>
      <div class="hn2-zone is-marketplace hn2-hide-rail">
        <div class="hn2-zone-title">Marketplace &amp; Growth <span class="hn2-zone-sub">· all properties</span></div>
      </div>

      <a class="hn2-item" href="/user/my-listings" data-hn2-match="^/user/(my-listings|listing/)" title="My Listings">
        <%- svg('home', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">My Listings</span>
      </a>
      <a class="hn2-item" href="/user/list-property" data-hn2-match="^/user/(list-property|new-list-property)" title="List New Property">
        <%- svg('plus', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">List New Property</span>
      </a>

      <%# Leads & CRM page arrives in Phase 3; until then these open the
          enquiries shown on My Listings. %>
      <button type="button" class="hn2-item" data-hn2-sub="hn2SubLeads" aria-controls="hn2SubLeads" title="Leads &amp; CRM" aria-expanded="false">
        <%- svg('funnel', 16, '#828b96', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Leads &amp; CRM</span>
        <% if (hnNewEnq > 0) { %><span class="hn2-pill-new hn2-hide-rail"><%= hnCount(hnNewEnq) %> NEW</span><% } %>
      </button>
      <div class="hn2-sub" id="hn2SubLeads">
        <a class="hn2-subitem" href="/user/my-listings">All Enquiries</a>
        <a class="hn2-subitem" href="/user/my-listings">Hot Leads <span class="hn2-dot" aria-hidden="true"></span></a>
        <a class="hn2-subitem" href="/user/my-listings">Scheduled Visits</a>
      </div>

      <div class="hn2-divider"></div>

      <span class="hn2-item is-soon" role="link" aria-disabled="true" title="Documents &amp; E-Sign — coming soon">
        <%- svg('doc', 16, '#5b6470', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Documents &amp; E-Sign</span>
        <span class="hn2-pill-soon hn2-hide-rail">SOON</span>
      </span>
      <span class="hn2-item is-soon" role="link" aria-disabled="true" title="Manage Wardens — coming soon">
        <%- svg('team', 16, '#5b6470', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Manage Wardens</span>
        <span class="hn2-pill-soon hn2-hide-rail">SOON</span>
      </span>

      <div class="hn2-spacer"></div>
      <div class="hn2-divider is-bottom"></div>

      <button type="button" class="hn2-item is-quiet" data-hn2-sub="hn2SubSupport" aria-controls="hn2SubSupport" title="Support" aria-expanded="false">
        <%- svg('help', 14, '#5b6470', 2, 'hn2-ic') %>
        <span class="hn2-label hn2-hide-rail">Support</span>
      </button>
      <div class="hn2-sub" id="hn2SubSupport">
        <a class="hn2-subitem" href="https://mail.google.com/mail/?view=cm&fs=1&to=hostelnodehelp@gmail.com" target="_blank" rel="noopener">
          <%- svg('mail', 13, '#828b96', 2) %> Email support
        </a>
        <a class="hn2-subitem" href="tel:+918828397001"><%- svg('phone', 13, '#828b96', 2) %> Call support</a>
      </div>

      <button type="button" class="hn2-item is-quiet hn2-collapse-row" data-hn2-collapse title="Collapse sidebar" aria-label="Collapse sidebar" style="margin-top:4px">
        <%- svg('collapse', 14, '#5b6470', 2.2, 'hn2-ic hn2-collapse-ic') %>
        <span class="hn2-label hn2-hide-rail">Collapse</span>
      </button>
    </nav>
  </aside>

  <!-- ════════════════ TOP BAR ════════════════ -->
  <header class="hn2-top">
    <div class="hn2-top-left">
      <button type="button" class="hn2-burger" data-hn2-open-drawer aria-label="Open menu" aria-expanded="false" aria-controls="hn2Sidebar">
        <%- svg('burger', 18, '#475467', 2) %>
      </button>

      <% if (hnSetup.next && hnSetup.done < hnSetup.total) { %>
        <a class="hn2-setup" href="<%= hnSetup.next.href %>" title="Next step: <%= hnSetup.next.label %>">
          <span class="hn2-setup-text">SETUP <%= hnSetup.done %>/<%= hnSetup.total %></span>
          <span class="hn2-setup-bar"><span class="hn2-setup-fill" style="display:block;width:<%= Math.round((hnSetup.done / hnSetup.total) * 100) %>%"></span></span>
        </a>
      <% } %>
    </div>

    <div class="hn2-top-right">
      <div class="hn2-quick" id="hn2Quick">
        <button type="button" class="hn2-quick-btn" data-hn2-toggle="quick" aria-expanded="false" aria-controls="hn2QuickMenu">
          <%- svg('plus', 15, '#fff', 2.4) %>
          <span class="hn2-quick-label">Quick add</span>
          <%- svg('down', 11, '#eafff2', 2.6) %>
        </button>
        <div class="hn2-menu" id="hn2QuickMenu">
          <a class="hn2-menu-item" href="/user/newmember"><%- svg('tenants', 15, '#667085', 2) %> Add tenant</a>
          <a class="hn2-menu-item" href="/user/allfeesrecords"><%- svg('rupee', 15, '#667085', 2) %> Collect payment</a>
          <a class="hn2-menu-item" href="/user/newroom"><%- svg('bed', 15, '#667085', 2) %> Add room</a>
          <a class="hn2-menu-item" href="/user/newfloor"><%- svg('layers', 15, '#667085', 2) %> Add floor</a>
          <a class="hn2-menu-item" href="/user/list-property"><%- svg('home', 15, '#667085', 2) %> List a property</a>
          <a class="hn2-menu-item" href="/user/addnewhostel"><%- svg('property', 15, '#667085', 2) %> Add new property</a>
        </div>
      </div>

      <button type="button" class="hn2-iconbtn" aria-disabled="true" aria-label="Notifications<%= hnNotif > 0 ? ' (' + hnNotif + ' unread)' : '' %>" title="Notifications — coming soon">
        <%- svg('bell', 16, '#475467', 2) %>
        <% if (hnNotif > 0) { %><span class="hn2-bell-dot"></span><% } %>
      </button>

      <button type="button" class="hn2-tour" aria-disabled="true" title="Guided tour — coming soon">
        <%- svg('clock', 14, '#475467', 2.2) %> Tour
      </button>

      <div class="hn2-vsep"></div>

      <div class="hn2-profile" id="hn2Profile">
        <button type="button" class="hn2-profile-btn" data-hn2-toggle="profile" aria-expanded="false" aria-controls="hn2ProfileMenu" aria-label="Account menu">
          <span class="hn2-avatar">
            <%= hnInitials %>
            <% if (hnUser.profileImage) { %><img src="/profile-image/<%= hnUser.profileImage %>" alt="" onerror="this.remove()"><% } %>
          </span>
          <span class="hn2-profile-name"><%= hnFirst %></span>
          <%- svg('down', 11, '#7a8794', 2.6, 'hn2-profile-chev') %>
        </button>

        <div class="hn2-pop" id="hn2ProfileMenu">
          <div class="hn2-pop-head">Signed in as</div>
          <div class="hn2-pop-card">
            <span class="hn2-avatar is-lg">
              <%= hnInitials %>
              <% if (hnUser.profileImage) { %><img src="/profile-image/<%= hnUser.profileImage %>" alt="" onerror="this.remove()"><% } %>
            </span>
            <div class="hn2-pop-who">
              <div class="hn2-pop-name"><%= hnName %></div>
              <div class="hn2-pop-email"><%= hnUser.email || '' %></div>
            </div>
            <%- svg('check', 15, '#0EA968', 2.6) %>
          </div>

          <div class="hn2-pop-sep"></div>
          <div class="hn2-pop-group">
            <a class="hn2-pop-item" href="/user/editOwner"><%- svg('user', 15, '#667085', 2) %> Profile</a>
            <span class="hn2-pop-item" role="link" aria-disabled="true" title="Settings — available in the next update"><%- svg('gear', 15, '#667085', 2) %> Settings</span>
            <span class="hn2-pop-item" role="link" aria-disabled="true" title="Billing — available in the next update">
              <%- svg('card', 15, '#667085', 2) %> <span class="hn2-grow">Billing</span>
              <span class="hn2-status <%= hnStatusClass %>"><%= String(hnStatus).toUpperCase() %></span>
            </span>
          </div>

          <div class="hn2-pop-sep"></div>
          <div class="hn2-pop-group">
            <span class="hn2-pop-item" role="link" aria-disabled="true" title="KYC verification — available in the next update">
              <%- svg('shield', 15, '#667085', 2) %> <span class="hn2-grow">KYC Verification</span>
              <span class="hn2-status is-warn">PENDING</span>
            </span>
          </div>

          <div class="hn2-pop-sep"></div>
          <div class="hn2-pop-group is-last">
            <a class="hn2-pop-item is-danger" href="/user/logout"><%- svg('logout', 15, '#dc2626', 2.1) %> Sign out</a>
          </div>
        </div>
      </div>
    </div>
  </header>
</div>

<script src="/js/hn-shell.js"></script>
