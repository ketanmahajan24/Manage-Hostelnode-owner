<script>
/* ── Sidebar ── */
function toggleSidebar() {
  const sidebar  = document.getElementById('hnSidebar');
  const overlay  = document.getElementById('hnSidebarOverlay');
  sidebar.classList.toggle('open');
  overlay.classList.toggle('open');
}
function closeSidebar() {
  document.getElementById('hnSidebar').classList.remove('open');
  document.getElementById('hnSidebarOverlay').classList.remove('open');
}

/* ── Submenu ── */
function toggleSubmenu(id, btn) {
  const sub = document.getElementById(id);
  const isOpen = sub.classList.contains('open');
  document.querySelectorAll('.hn-submenu').forEach(s => s.classList.remove('open'));
  document.querySelectorAll('.hn-snav-item').forEach(b => b.classList.remove('open'));
  if (!isOpen) {
    sub.classList.add('open');
    btn.classList.add('open');
  }
}

/* ── Hostel dropdown ── */
function toggleHostelDropdown() {
  document.getElementById('hnHostelSelector').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  const sel = document.getElementById('hnHostelSelector');
  if (sel && !sel.contains(e.target)) sel.classList.remove('open');
});

/* ── Profile panel ── */
function toggleProfilePanel() {
  document.getElementById('hnProfilePanel').classList.toggle('open');
  document.getElementById('hnSidebarOverlay').classList.toggle('open');
}
function closeProfilePanel() {
  document.getElementById('hnProfilePanel').classList.remove('open');
  document.getElementById('hnSidebarOverlay').classList.remove('open');
}

/* ── Active nav item ── */
const path = window.location.pathname;
document.querySelectorAll('.hn-snav-item, .hn-submenu-item').forEach(link => {
  if (link.href && link.href.includes(path) && path !== '/') {
    link.classList.add('active');
    const submenu = link.closest('.hn-submenu');
    if (submenu) {
      submenu.classList.add('open');
      const parentBtn = submenu.previousElementSibling;
      if (parentBtn) parentBtn.classList.add('open');
    }
  }
});

/* ── Close sidebar on overlay click ── */
document.getElementById('hnSidebarOverlay').addEventListener('click', function() {
  closeSidebar();
  closeProfilePanel();
});
</script>