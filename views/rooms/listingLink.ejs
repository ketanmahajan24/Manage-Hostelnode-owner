<% layout("/layouts/boilerplate") -%>
<%# Property Operations Phase 2 — link a listing to a property so hostelnode.com shows real free beds. %>
<%- include("../account/_style.ejs") %>
<style>
  .hn2k2 .hn2a-inner { max-width: 900px; }
  .hn2k2-lh { display: flex; gap: 14px; align-items: center; }
  .hn2k2-ph { width: 84px; height: 64px; border-radius: 12px; background: linear-gradient(135deg, #cfe9db, #a7d7bd) center/cover; flex-shrink: 0; }
  .hn2k2-lh h2 { font-size: 18px; font-weight: 800; margin: 0; color: var(--hn-ink); overflow-wrap: anywhere; }
  .hn2k2-st { margin-left: auto; font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 99px; background: var(--hn-green-tint); color: var(--hn-green); white-space: nowrap; }
  .hn2k2-st.is-wait { background: var(--hn-amber-tint); color: var(--hn-amber); }
  .hn2k2 .hn2a-select { max-width: 420px; height: 44px; }
  .hn2k2-tbl { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 14px; }
  .hn2k2-tbl th { text-align: left; font-size: 12px; color: var(--hn-soft); font-weight: 600; padding: 10px; background: #f5faf7; border-bottom: 1px solid var(--hn-line); }
  .hn2k2-tbl td { padding: 12px 10px; border-bottom: 1px solid #eef4f1; font-weight: 600; vertical-align: top; }
  .hn2k2-ok { color: var(--hn-green); } .hn2k2-full { color: var(--hn-coral); }
  .hn2k2-ch { display: inline-block; background: #f2f6f4; border-radius: 7px; padding: 3px 8px; font-size: 12px; margin: 2px; }
  .hn2k2-pick { margin-top: 8px; display: none; flex-wrap: wrap; gap: 6px 12px; font-size: 13px; font-weight: 600; }
  .hn2k2-pick.is-open { display: flex; }
  .hn2k2-pick label { display: flex; gap: 6px; align-items: center; }
  .hn2k2-pick input { accent-color: var(--hn-green); }
  .hn2k2-auto { font-size: 12.5px; font-weight: 600; color: var(--hn-body); display: flex; gap: 6px; align-items: center; margin-top: 6px; }
  .hn2k2-prev { display: flex; gap: 16px; align-items: center; margin-top: 20px; background: #f5faf7; border-radius: 14px; padding: 14px; flex-wrap: wrap; }
  .hn2k2-site { width: 250px; background: #fff; border-radius: 14px; border: 1px solid var(--hn-line); overflow: hidden; }
  .hn2k2-site .img { height: 90px; background: linear-gradient(135deg, #cfe9db, #a7d7bd) center/cover; }
  .hn2k2-site .b { padding: 10px 12px; font-size: 13px; font-weight: 700; }
  .hn2k2-badge { display: inline-block; margin-top: 6px; font-size: 11.5px; font-weight: 700; padding: 3px 9px; border-radius: 99px; background: var(--hn-green-bright); color: #fff; }
  .hn2k2-badge.is-full { background: var(--hn-coral); }
  @media (max-width: 640px) { .hn2k2-tbl th:nth-child(2), .hn2k2-tbl td:nth-child(2) { display: none; } }
</style>
<% const img = (listing.images && listing.images[0] && /^[\w.-]+$/.test(listing.images[0])) ? "/listing-images/" + listing.images[0] : ""; const freeTotal = rows.reduce(function (s, r) { return s + r.free; }, 0); %>
<div class="hn2a hn2k2">
  <div class="hn2a-inner">
    <a href="/user/my-listings" style="font-size:13px;font-weight:600;color:var(--hn-green)">← My Listings</a>
    <h1 class="hn2a-title" style="margin-top:8px">Show real free beds on hostelnode.com</h1>
    <div class="hn2a-sub">Link this listing to your property. Students then see free beds that update by themselves.</div>
    <% if (flash.err) { %><div class="hn2a-notice is-bad" role="alert"><%= flash.err %></div><% } %>

    <form class="hn2a-card" method="POST" action="/user/listing/<%= listing._id %>/link">
      <div class="hn2k2-lh">
        <span class="hn2k2-ph" <% if (typeof img === "string" && /^(https?:\/\/|\/)/.test(img)) { %>style="background-image:url('<%= img.replace(/'/g, "%27") %>')"<% } %>></span>
        <div><h2><%= listing.title %></h2><div class="hn2a-help" style="margin:3px 0 0">Listing on hostelnode.com · <%= (listing.rooms || []).length %> room type<%= (listing.rooms || []).length === 1 ? "" : "s" %></div></div>
        <span class="hn2k2-st <%= listing.status === 'Approved' ? '' : 'is-wait' %>"><%= listing.status === "Approved" ? "Live" : listing.status %></span>
      </div>

      <label class="hn2a-label" for="hs" style="margin-top:18px">This listing is for property</label>
      <select class="hn2a-select" id="hs" name="hostel" onchange="location.href='?hostel='+encodeURIComponent(this.value)">
        <option value="">Choose a property</option>
        <% hostels.forEach(function (h) { %><option value="<%= h._id %>" <%= hostel && String(hostel._id) === String(h._id) ? "selected" : "" %>><%= h.hostelName %><%= h.hostelId ? " (" + h.hostelId + ")" : "" %></option><% }) %>
      </select>

      <% if (!hostel) { %>
        <div class="hn2a-help" style="margin-top:12px">Pick the property this listing is for, to see how its room types match your rooms.</div>
      <% } else if (!(listing.rooms || []).length) { %>
        <div class="hn2a-notice is-bad" style="margin-top:14px">This listing has no room types yet. Add them in Edit listing first.</div>
      <% } else { %>
        <span class="hn2a-label" style="margin-top:18px">Room types on the listing, matched to your rooms</span>
        <table class="hn2k2-tbl">
          <thead><tr><th>On the listing</th><th>Matched rooms</th><th>Shown to students</th></tr></thead>
          <tbody>
          <% rows.forEach(function (r) { %>
            <tr>
              <td><%= r.type %> · ₹<%= Number(r.price || 0).toLocaleString("en-IN") %></td>
              <td>
                <% if (r.matched.length) { r.matched.forEach(function (m) { %><span class="hn2k2-ch"><%= m.number %></span><% }) } else { %><span class="hn2a-help">No rooms matched<%= r.cap ? " (no " + r.cap + "-bed rooms)" : "" %></span><% } %>
                <label class="hn2k2-auto"><input type="checkbox" name="auto<%= r.i %>" value="1" <%= r.auto ? "checked" : "" %> data-auto="<%= r.i %>"> Match by beds per room</label>
                <div class="hn2k2-pick <%= r.auto ? '' : 'is-open' %>" id="pick<%= r.i %>">
                  <% rooms.forEach(function (rm) { %><label><input type="checkbox" name="pick<%= r.i %>" value="<%= rm.id %>" <%= r.picked.includes(rm.id) ? "checked" : "" %>> <%= rm.number %> (<%= rm.capacity %> bed<%= rm.capacity === 1 ? "" : "s" %>)</label><% }) %>
                </div>
              </td>
              <td class="<%= r.free ? 'hn2k2-ok' : 'hn2k2-full' %>"><%= r.free ? (r.free === 1 ? "1 bed free" : r.free + " beds free") : "Full" %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <div class="hn2a-help">Untick "Match by beds per room" to pick the rooms yourself. A room type that matches no rooms keeps using the listing's own "Available" tick.</div>
        <div class="hn2k2-prev">
          <div class="hn2k2-site"><div class="img" <% if (typeof img === "string" && /^(https?:\/\/|\/)/.test(img)) { %>style="background-image:url('<%= img.replace(/'/g, "%27") %>')"<% } %>></div><div class="b"><%= listing.title %><br><span class="<%= freeTotal ? 'hn2k2-badge' : 'hn2k2-badge is-full' %>"><%= freeTotal ? (freeTotal === 1 ? "1 bed free" : freeTotal + " beds free") : "Full" %></span></div></div>
          <div style="font-size:13px;font-weight:600;color:var(--hn-body);max-width:380px">How students will see it on hostelnode.com. When a tenant moves in or out, this changes by itself.</div>
        </div>
      <% } %>
      <div style="display:flex;gap:10px;margin-top:18px;flex-wrap:wrap">
        <button type="submit" class="hn2a-btn" <%= hostel ? "" : "disabled" %>>Save link</button>
        <a class="hn2a-btn is-ghost" href="/user/my-listings">Not now</a>
      </div>
    </form>
    <% if (typeof bookingView !== "undefined" && bookingView) { const bs = bookingView.s; %>
    <%# Property Operations Phase 8: students book a free bed from this listing and pay a booking amount. %>
    <form class="hn2a-card" id="booking" method="POST" action="/user/listing/<%= listing._id %>/booking" style="margin-top:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h2 style="font-size:17px;font-weight:800;margin:0;color:var(--hn-ink)">Online booking</h2>
        <label class="hn2k2-auto" style="margin:0;font-size:14px"><input type="checkbox" name="on" value="1" <%= bs.on ? "checked" : "" %> <%= listing.linkedHostel ? "" : "disabled" %>> Students can book a bed</label>
      </div>
      <div class="hn2a-help" style="margin:4px 0 12px">Students pick a room type with free beds and a move-in date, verify their Aadhaar, and pay a booking amount online. You accept with the exact bed, or decline (full refund).</div>
      <% if (bookingView.saved) { %><div class="hn2a-notice is-ok" role="status">Booking settings saved.</div><% } %>
      <% if (!listing.linkedHostel) { %><div class="hn2a-notice is-bad">Link this listing to your property above first.</div><% } %>
      <% if (!bookingView.ready) { %><div class="hn2a-notice is-bad">Your payout account (Account → Receive payments) must be Active before students can book.</div><% } %>
      <span class="hn2a-label">Booking amount</span>
      <div class="hn3-seg" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:6px">
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="amountType" value="rent" <%= bs.amountType === "rent" ? "checked" : "" %>> One month's rent of the room type</label>
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="amountType" value="fixed" <%= bs.amountType === "fixed" ? "checked" : "" %>> Fixed ₹</label>
        <input class="hn2a-input" name="amount" value="<%= bs.amountType === 'fixed' ? bs.amount : '' %>" inputmode="numeric" placeholder="₹ amount" style="max-width:140px;height:40px" aria-label="Fixed booking amount">
      </div>
      <div class="hn2a-help" style="margin:0 0 14px"><%= bookingView.types.map(function (t) { return t.type + " ₹" + (bs.amountType === "fixed" ? bs.amount : t.price).toLocaleString("en-IN"); }).join(" · ") || "Add room types to the listing first." %></div>
      <span class="hn2a-label">It counts towards</span>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px">
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="countsTowards" value="rent" <%= bs.countsTowards === "rent" ? "checked" : "" %>> First month's rent</label>
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="countsTowards" value="deposit" <%= bs.countsTowards === "deposit" ? "checked" : "" %>> Deposit</label>
      </div>
      <span class="hn2a-label">If the student cancels after you accept</span>
      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-bottom:6px">
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="refundAfter" value="full" <%= bs.refundAfter === "full" ? "checked" : "" %>> Full refund</label>
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="refundAfter" value="half" <%= bs.refundAfter === "half" ? "checked" : "" %>> Half refund</label>
        <label class="hn2k2-auto" style="margin:0"><input type="radio" name="refundAfter" value="none" <%= bs.refundAfter === "none" ? "checked" : "" %>> No refund</label>
        <span class="hn2k2-auto" style="margin:0">up to <input class="hn2a-input" name="refundDays" value="<%= bs.refundDays %>" inputmode="numeric" style="width:64px;height:36px;margin:0 6px" aria-label="Days before move-in"> days before move-in</span>
      </div>
      <div class="hn2a-help" style="margin:0 0 14px">Before you accept, and if you decline or don't answer in 72 hours, the student always gets a full refund. The rule is shown to students before they pay.</div>
      <button type="submit" class="hn2a-btn">Save booking settings</button>
    </form>
    <% } %>
    <% if (listing.linkedHostel) { %>
      <form method="POST" action="/user/listing/<%= listing._id %>/link" style="margin-top:6px"><input type="hidden" name="unlink" value="1"><button type="submit" class="hn2a-btn is-ghost" style="color:var(--hn-coral)">Unlink (show the "Available" tick again)</button></form>
    <% } %>
  </div>
</div>
<script>
document.querySelectorAll('[data-auto]').forEach(function (c) { c.addEventListener('change', function () { document.getElementById('pick' + c.getAttribute('data-auto')).classList.toggle('is-open', !c.checked); }); });
</script>
