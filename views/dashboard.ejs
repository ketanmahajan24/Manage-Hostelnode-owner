<% layout("/layouts/boilerplate") -%>

<style>
    :root {
        --primary: #09B850;
        --primary-dark: #059669;
        --bg: #F8FAFC;
        --card: #FFFFFF;
        --text: #0F172A;
        --muted: #64748B;
        --border: #E2E8F0;
        --danger: #EF4444;
    }

    /* 🌟 Main Page */
    .main-body-page {
        background-color: var(--bg);
        padding: 15px;
    }

    /* 🌟 Add Member Button */



    
/* Button */
.btn-modern {
    background: linear-gradient(135deg, #22C55E, #09B850, #0fa18e);
    color: #fff;
    font-weight: 600;
    padding: 14px 30px;
    border-radius: 50px;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0px 8px 25px rgba(0, 0, 0, 0.28);
}
.btn-modern:hover {
    transform: scale(1.05);
    box-shadow: 0px 12px 30px rgba(0,0,0,0.15);
}

    
    /* 🌟 Card Grid */
    .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    /* 🌟 Card Base */
    .card {
        background: linear-gradient(135deg, rgba(9, 184, 80, 0.08), rgba(34,197,94,0.05));
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px;
        border: 1px solid var(--border);
        box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        transition: transform 0.4s ease, box-shadow 0.4s ease, opacity 0.6s ease;
        opacity: 0;
        transform: translateY(30px);
        cursor: pointer;
    }
    .card.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 28px rgba(0,0,0,0.12);
    }

    /* 🌟 Card Content */
    .card h3 {
        color: var(--text);
        margin: 0;
    }
    .card p {
        color: var(--muted);
        margin: 0;
        font-weight: 400;
    }

    /* 🌟 Icons */
    .icon {
        color: white;
        padding: 16px;
        border-radius: 50%;
        font-size: 18px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card:hover .icon {
        transform: scale(1.2);
        box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }

    /* 🌟 Fade-In Animation Delay */
    .card:nth-child(1) { transition-delay: 0.1s; }
    .card:nth-child(2) { transition-delay: 0.2s; }
    .card:nth-child(3) { transition-delay: 0.3s; }
    .card:nth-child(4) { transition-delay: 0.4s; }
    .card:nth-child(5) { transition-delay: 0.5s; }
    .card:nth-child(6) { transition-delay: 0.6s; }

    /* 🌟 Responsive */
    @media (max-width: 768px) {
        .card h3 { font-size: 24px; }
        .card p { font-size: 13px; }
        .icon { font-size: 16px; padding: 14px; }
    }
    @media (max-width: 480px) {
        .card h3 { font-size: 20px; }
        .card p { font-size: 12px; }
        .icon { font-size: 14px; padding: 12px; }
    }



</style>

<div class="main-body-page">

    <br><br>

    <!-- Add Member Button -->
    <div class="cols" style="display: flex; justify-content: center; margin-bottom: 30px;">
        <a href="/user/newmember" class="btn btn-modern">
            <i class="fa-solid fa-plus"></i> Add Member
        </a>
    </div>


    <!-- Cards -->
    <div class="card-container">

        <!-- Available Beds -->
        <div class="card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3><b><%= availableBeds %></b></h3>
                    <p>Available Beds</p>
                </div>
                <i class="fa-solid fa-bed icon" style="background:#09B850;"></i>
            </div>
        </div>

        <!-- Total Beds -->
        <div class="card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3><b><%= totalBeds %></b></h3>
                    <p>Total Beds</p>
                </div>
                <i class="fa-solid fa-cubes-stacked icon" style="background:#22C55E;"></i>
            </div>
        </div>

        <!-- Booked Rooms -->
        <div class="card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3><b><%= bookedRooms %></b></h3>
                    <p>Booked Rooms</p>
                </div>
                <i class="fa-solid fa-building-circle-check icon" style="background:#3B82F6;"></i>
            </div>
        </div>

        <!-- Total Rooms -->
        <div class="card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3><b><%= totalRooms %></b></h3>
                    <p>Total Rooms</p>
                </div>
                <i class="fa-solid fa-hotel icon" style="background:#8B5CF6;"></i>
            </div>
        </div>

        <!-- Total Members -->
        <div class="card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3><b><%= totalStudents %></b></h3>
                    <p>Total Members</p>
                </div>
                <i class="fa-solid fa-users icon" style="background:#14B8A6;"></i>
            </div>
        </div>

        <!-- Pending Amount -->
        <div class="card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 style="color: var(--danger);">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                        <%= totalPendingAmount.toLocaleString() %>
                    </h3>
                    <p>Total Pending Amount</p>
                </div>
                <i class="fa-solid fa-circle-exclamation icon" style="background:#EF4444;"></i>
            </div>
        </div>

    </div>

</div>

<script>
    // Animate cards on load
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.card');
        cards.forEach(card => {
            setTimeout(() => {
                card.classList.add('visible');
            }, 100);
        });
    });
</script>