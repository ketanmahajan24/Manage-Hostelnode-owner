<% layout("/layouts/boilerplate") -%>

<style>
:root {
    --primary: #09B850;
    --primary-dark: #059669;
    --bg: #F8FAFC;
    --card: #FFFFFF;
    --text: #0F172A;
    --muted: #64748B;
    --border: #E2E8F0;
    --danger: #EF4444;
}

/* Page */
.main-body-page {
    background-color: var(--bg);
    padding: 15px;
}

/* Heading */
.revenue-heading {
    text-align: center;
    font-weight: 600;
    color: var(--text);
}

/* Cards (SAME AS DASHBOARD) */
.card-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.card {
    background: linear-gradient(135deg, rgba(9, 184, 80, 0.08), rgba(34,197,94,0.05));
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid var(--border);
    box-shadow: 0 6px 18px rgba(0,0,0,0.15);
    transition: transform 0.4s ease, box-shadow 0.4s ease, opacity 0.6s ease;
    opacity: 0;
    transform: translateY(30px);
}

.card.visible {
    opacity: 1;
    transform: translateY(0);
}

.card:hover {
    transform: translateY(-6px);
}

/* Text */
.card h2, .card h1, .card h5 {
    color: var(--text);
}
.card p {
    color: var(--muted);
}

/* Icon */
.icon {
    color: white;
    padding: 16px;
    border-radius: 50%;
    font-size: 18px;
}

/* TABLE (MATCH DASHBOARD STYLE) */
.table-container {
    margin-top: 40px;
    background: var(--card);
    border-radius: 16px;
    padding: 15px;
    border: 1px solid var(--border);
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    background: rgba(9,184,80,0.1);
    color: var(--text);
    padding: 12px;
}

td {
    padding: 10px;
    color: var(--muted);
}

tr:hover {
    background: rgba(9,184,80,0.05);
}

/* Button */
.btn-download {
    background: linear-gradient(135deg, #22C55E, #09B850);
    border: none;
    color: white;
    padding: 8px 12px;
    border-radius: 8px;
    transition: 0.3s;
}

.btn-download:hover {
    transform: scale(1.05);
}
</style>

<div class="main-body-page">

<br><br>
<h1 class="revenue-heading">Revenue Report</h1>
<br>

<div class="card-container">

    <!-- Fees Completed -->
    <div class="card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><%= feesCollectionCompleted %> %</h1>
                <p>Fees Collection Completed</p>
            </div>
            <i class="fa-solid fa-chart-pie icon" style="background: var(--primary);"></i>
        </div>
    </div>

    <!-- Accounts -->
    <div class="card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5>Paid: <%= paidAccounts %></h5>
                <p>Due: <%= dueAccounts %></p>
            </div>
            <i class="fa-solid fa-square-poll-horizontal icon" style="background: var(--primary-dark);"></i>
        </div>
    </div>

    <!-- Collected -->
    <div class="card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2>₹ <%= totalFeesCollected %></h2>
                <p>Total Fees Collected</p>
            </div>
            <i class="fa-solid fa-sack-dollar icon" style="background:#22C55E;"></i>
        </div>
    </div>

    <!-- Pending -->
    <div class="card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 style="color: var(--danger);">₹ <%= totalPendingAmount %></h2>
                <p>Total Pending Amount</p>
            </div>
            <i class="fa-solid fa-circle-exclamation icon" style="background: var(--danger);"></i>
        </div>
    </div>

    <!-- Expected -->
    <div class="card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2>₹ <%= totalExpectedRevenue %></h2>
                <p>Total Expected Revenue</p>
            </div>
            <i class="fa-solid fa-chart-line icon" style="background:#10B981;"></i>
        </div>
    </div>

    <!-- Balance -->
    <div class="card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2>₹ <%= balance %></h2>
                <p>Balance</p>
            </div>
            <i class="fa-solid fa-wallet icon" style="background:#059669;"></i>
        </div>
    </div>

</div>

<!-- TABLE -->
<div class="table-container">

<table>
    <tr>
        <th>S. No.</th>
        <th>Months</th>
        <th>Collected</th>
        <th>Pending</th>
        <th>Expected</th>
        <th>Members</th>
        <th>Download</th>
    </tr>

    <tr>
        <td>1</td>
        <td>January 2024</td>
        <td>₹7,00,000</td>
        <td>₹50,000</td>
        <td>₹7,50,000</td>
        <td>120</td>
        <td><button class="btn-download"><i class="fa-solid fa-file-lines"></i></button></td>
    </tr>

    <tr>
        <td>2</td>
        <td>February 2024</td>
        <td>₹8,00,000</td>
        <td>₹10,000</td>
        <td>₹7,90,000</td>
        <td>130</td>
        <td><button class="btn-download"><i class="fa-solid fa-file-lines"></i></button></td>
    </tr>

</table>

</div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.card');
    cards.forEach((card, index) => {
        setTimeout(() => {
            card.classList.add('visible');
        }, index * 100);
    });
});
</script>