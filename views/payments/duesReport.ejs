<% layout("/layouts/boilerplate") -%>
<%# Property Operations Phase 1 — Dues: every tenant who owes rent, most owed first.
    (Until now this page was a copy of "Upcoming" and showed no amounts.) %>
<%- include("../account/_style.ejs") %>
<%
  const inr = n => "₹" + new Intl.NumberFormat("en-IN", { maximumFractionDigits: 0 }).format(Number(n) || 0);
  const day = d => d && !isNaN(new Date(d)) ? new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Kolkata" }) : "";
  const hnDues = Array.isArray(dues) ? dues : [];
%>
<style>
  .hn2d .hn2a-inner { max-width: 980px; }
  .hn2d-sum { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-radius: 22px; padding: 22px 24px; margin-bottom: 18px; color: #fff; background: var(--hn-coral); box-shadow: 0 18px 34px -24px var(--hn-coral); }
  .hn2d-sum.is-clear { background: var(--hn-green); box-shadow: 0 18px 34px -24px var(--hn-green); }
  .hn2d-sum b { display: block; font-size: 34px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .hn2d-sum span { font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.94); }
  .hn2d-list { display: grid; gap: 10px; }
  .hn2d-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 16px; background: #fff; border: 1px solid var(--hn-line); border-left: 5px solid var(--hn-coral); border-radius: 16px; padding: 14px 16px; }
  .hn2d-row.is-out { border-left-color: var(--hn-slate); }
  .hn2d-name { font-size: 15px; font-weight: 700; color: var(--hn-ink); overflow-wrap: anywhere; }
  .hn2d-meta { font-size: 13px; font-weight: 500; color: var(--hn-soft); margin-top: 3px; display: flex; gap: 6px 12px; flex-wrap: wrap; }
  .hn2d-tag { display: inline-block; font-size: 11.5px; font-weight: 700; padding: 2px 9px; border-radius: 99px; background: var(--hn-slate-tint); color: var(--hn-slate); }
  .hn2d-amt { text-align: right; }
  .hn2d-amt b { display: block; font-size: 20px; font-weight: 800; color: var(--hn-coral); font-variant-numeric: tabular-nums; }
  .hn2d-amt span { font-size: 12px; color: var(--hn-soft); font-weight: 500; }
  .hn2d-acts { display: flex; gap: 8px; }
  .hn2d-ic, .hn2d-ic:hover { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 11px; border: 1px solid var(--hn-line); background: #fff; color: var(--hn-body); }
  .hn2d-ic:hover { background: #f4faf7; }
  .hn2d-ic svg { display: block; }
  @media (max-width: 640px) {
    .hn2d-row { grid-template-columns: minmax(0, 1fr) auto; }
    .hn2d-acts { grid-column: 1 / -1; }
    .hn2d-acts .hn2a-btn { flex: 1; }
  }
</style>

<div class="hn2a hn2d">
  <div class="hn2a-inner">
    <h1 class="hn2a-title">Dues</h1>
    <div class="hn2a-sub">Tenants who owe rent in this property, most owed first</div>

    <div class="hn2d-sum <%= hnDues.length ? '' : 'is-clear' %>">
      <div>
        <b><%= inr(total) %></b>
        <span><%= hnDues.length ? (hnDues.length === 1 ? "due from 1 tenant" : "due from " + hnDues.length + " tenants") : "Nobody owes rent right now" %></span>
      </div>
      <a class="hn2a-btn is-ghost" href="/user/allfeesrecords">All payment records</a>
    </div>

    <% if (!hnDues.length) { %>
      <div class="hn2a-card"><div class="hn2a-empty">All rent is paid. New dues appear here on each tenant's rent day.</div></div>
    <% } else { %>
      <div class="hn2d-list">
        <% hnDues.forEach(function (m) {
             const since = day(m.dueSince);
             const waText = "Hello " + m.name + ", your hostel rent of " + inr(m.dueAmount) + " is due. Please pay at the earliest. Thank you.";
        %>
          <div class="hn2d-row <%= m.movedOut ? 'is-out' : '' %>">
            <div>
              <div class="hn2d-name"><%= m.name %></div>
              <div class="hn2d-meta">
                <span>Room <%= m.assignedRoom || "—" %></span>
                <% if (since) { %><span>Due since <%= since %></span><% } %>
                <% if (m.movedOut) { %><span class="hn2d-tag">Moved out</span><% } %>
              </div>
            </div>
            <div class="hn2d-amt"><b><%= inr(m.dueAmount) %></b><span>due</span></div>
            <div class="hn2d-acts">
              <a class="hn2a-btn" href="/user/members/<%= m._id %>/addpayment">Collect</a>
              <% if (m.mobileNo) { %>
                <a class="hn2d-ic" href="https://wa.me/91<%= encodeURIComponent(m.mobileNo) %>?text=<%= encodeURIComponent(waText) %>" target="_blank" rel="noopener" aria-label="Send <%= m.name %> a WhatsApp reminder" title="WhatsApp reminder">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a7d4c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.5 8.5 0 1 1 21 11.5z"></path></svg>
                </a>
                <a class="hn2d-ic" href="tel:+91<%= encodeURIComponent(m.mobileNo) %>" aria-label="Call <%= m.name %>" title="Call">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1d5fd1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
                </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
