<% layout("/layouts/boilerplate") -%>

<style>
/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 25px;
}

/* 🌟 Header */
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.page-title {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
}

/* 🌟 Table Wrapper */
.table-wrapper {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow-x: auto;
    animation: fadeUp 0.5s ease;
}

/* 🌟 Table */
table {
    width: 100%;
    border-collapse: collapse;
}

/* 🌟 Header */
th {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: white;
    padding: 14px;
    font-size: 13px;
    text-align: left;
}

/* 🌟 Rows */
td {
    padding: 14px;
    font-size: 14px;
    color: #0F172A;
    border-bottom: 1px solid #F1F5F9;
}

/* 🌟 Hover */
tbody tr {
    transition: 0.25s;
    animation: fadeInUp 0.4s ease both;
}

tbody tr:hover {
    background: #F8FAFC;
}

/* 🌟 Badge */
.badge-due {
    background: #EF444415;
    color: #EF4444;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
}

.badge-soon {
    background: #09B85015;
    color: #09B850;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
}

/* 🌟 Buttons */
.btn-call {
    background: linear-gradient(135deg, #09B850, #22C55E);
    border: none;
    color: white;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    transition: 0.3s;
}

.btn-call:hover {
    background: linear-gradient(135deg, #059669, #16A34A);
    transform: translateY(-1px);
}

.btn-reminder {
    background: #0F172A;
    color: white;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    border: none;
    transition: 0.3s;
}

.btn-reminder:hover {
    background: #020617;
}

/* 🌟 Animations */
@keyframes fadeUp {
    from {opacity:0; transform:translateY(25px);}
    to {opacity:1; transform:translateY(0);}
}

@keyframes fadeInUp {
    from {opacity:0; transform:translateY(10px);}
    to {opacity:1; transform:translateY(0);}
}

/* 🌟 Responsive */
@media(max-width:900px){
    th, td {
        padding: 10px;
        font-size: 12px;
    }
}
</style>

<div class="main-body-page">

    <!-- Header -->
    <div class="page-header">
        <div class="page-title">
            <i class="fa-solid fa-calendar-days" style="color:#09B850;"></i>
            Upcoming 5 Days Payments
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
        <table>

            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Room</th>
                    <th>Monthly Fee</th>
                    <th>Payable Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% allMembers.filter(member => member.status === "Active").forEach((Member, index) => { %>

                <tr>
                    <td><%= index + 1 %></td>

                    <td><strong><%= Member.name %></strong></td>

                    <td><%= Member.assignedRoom %></td>

                    <td>
                        <% if (Member.payments.length > 0){ %> 
                            ₹<%= Member.payments[0].roomFees %>
                        <% } else { %> 
                            N/A
                        <% } %>
                    </td>

                    <td>
                        <%= Member.joiningDate.toLocaleDateString("en-GB") %>
                    </td>

                    <!-- 🔥 Status -->
                    <td>
                        <span class="badge-soon">Upcoming</span>
                    </td>

                    <!-- 🔥 Actions -->
                    <td style="display:flex; gap:6px;">
                        <!-- Call -->
                        <a href="tel:<%=Member.mobileNo%>">
                            <button class="btn-call">
                                <i class="fa-solid fa-phone"></i>
                            </button>
                        </a>

                        <!-- WhatsApp Reminder -->
                        <a href="https://wa.me/91<%=Member.mobileNo%>?text=Hello%20<%=Member.name%>%2C%20your%20hostel%20payment%20is%20due%20soon." target="_blank">
                            <button class="btn-reminder">
                                <i class="fa-brands fa-whatsapp"></i>
                            </button>
                        </a>
                    </td>

                </tr>

                <% }); %>
            </tbody>

        </table>
    </div>

</div>