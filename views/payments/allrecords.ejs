<% layout("/layouts/boilerplate") -%>

<style>
/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 25px;
}

/* 🌟 Header */
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.page-title {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
}

/* 🌟 Search */
.search-box {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
}

.search-box input {
    flex: 1;
    border-radius: 10px;
    border: 1px solid #CBD5E1;
    padding: 10px;
    transition: 0.25s;
}

.search-box input:focus {
    border-color: #09B850;
    box-shadow: 0 0 0 3px rgba(9,184,80,0.15);
    outline: none;
}

.search-btn {
    background: linear-gradient(135deg, #09B850, #22C55E);
    border: none;
    color: white;
    padding: 10px 18px;
    border-radius: 10px;
    transition: 0.3s;
}

.search-btn:hover {
    background: linear-gradient(135deg, #059669, #16A34A);
    transform: translateY(-1px);
}

/* 🌟 Table Wrapper */
.table-wrapper {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow-x: auto;
    animation: fadeUp 0.5s ease;
}

/* 🌟 Table */
table {
    width: 100%;
    border-collapse: collapse;
}

/* 🌟 Header */
th {
    background: linear-gradient(135deg, #09B850, #22C55E);
    color: white;
    padding: 14px;
    font-size: 13px;
    text-align: left;
}

/* 🌟 Rows */
td {
    padding: 14px;
    font-size: 14px;
    color: #0F172A;
    border-bottom: 1px solid #F1F5F9;
}

/* 🌟 Hover */
tbody tr {
    transition: 0.25s;
    animation: fadeInUp 0.4s ease both;
}

tbody tr:hover {
    background: #F8FAFC;
}

/* 🌟 Status Badges */
.badge-paid {
    background: #09B85015;
    color: #09B850;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
}

.badge-pending {
    background: #EF444415;
    color: #EF4444;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
}

/* 🌟 Action Buttons */
.btn-pay {
    background: linear-gradient(135deg, #09B850, #22C55E);
    border: none;
    color: white;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    transition: 0.3s;
}

.btn-pay:hover {
    background: linear-gradient(135deg, #059669, #16A34A);
    transform: translateY(-1px);
}

.btn-history {
    background: #0F172A;
    color: white;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    border: none;
    transition: 0.3s;
}

.btn-history:hover {
    background: #020617;
}

/* 🌟 Animations */
@keyframes fadeUp {
    from {opacity:0; transform:translateY(25px);}
    to {opacity:1; transform:translateY(0);}
}

@keyframes fadeInUp {
    from {opacity:0; transform:translateY(10px);}
    to {opacity:1; transform:translateY(0);}
}

/* 🌟 Responsive */
@media(max-width:900px){
    th, td {
        padding: 10px;
        font-size: 12px;
    }
}
</style>

<div class="main-body-page">

    <!-- Header -->
    <div class="page-header">
        <div class="page-title">
            <i class="fa-solid fa-money-bill-wave" style="color:#09B850;"></i>
            Members Fees Records
        </div>
    </div>

    <!-- 🔍 Search -->
    <form action="/user/searchfeesrecords" method="POST" class="search-box">
        <input 
            name="searchQuery" 
            type="text" 
            placeholder="Search by Name or Mobile..." 
            required
        >
        <button class="search-btn">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </form>

    <!-- Table -->
    <div class="table-wrapper">
        <table>

            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Mobile</th>
                    <th>Total</th>
                    <th>Advance</th>
                    <th>Paid</th>
                    <th>Due</th>
                    <th>Last Payment</th>
                    <th>Mode</th>
                    <th>Status</th>
                    <th>Pay</th>
                    <th>History</th>
                </tr>
            </thead>

            <tbody>
                <% allMembers.forEach((member, index) => { %>

                <tr>
                    <td><%= index + 1 %></td>

                    <td><strong><%= member.name %></strong></td>

                    <td><%= member.mobileNo %></td>

                    <td>₹<%= member.totalFees.toLocaleString() %></td>

                    <td>₹<%= member.advancedPaid.toLocaleString() %></td>

                    <td>₹<%= member.amountPaid.toLocaleString() %></td>

                    <td>₹<%= member.dueAmount.toLocaleString() %></td>

                    <td>
                        <% if (member.payments.length) { %>
                            <%= new Date(member.payments.at(-1).paymentDate).toLocaleDateString('en-GB') %>
                        <% } else { %>
                            -
                        <% } %>
                    </td>

                    <td>
                        <% if (member.payments.length) { %>
                            <%= member.payments.at(-1).paymentMode %>
                        <% } else { %>
                            -
                        <% } %>
                    </td>

                    <td>
                        <% if(member.dueAmount === 0){ %>
                            <span class="badge-paid">Paid</span>
                        <% } else { %>
                            <span class="badge-pending">Pending</span>
                        <% } %>
                    </td>

                    <td>
                        <a href="/user/members/<%=member._id%>/addpayment">
                            <button class="btn-pay">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </a>
                    </td>

                    <td>
                        <a href="/user/payment-history/<%= member._id %>">
                            <button class="btn-history">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </button>
                        </a>
                    </td>

                </tr>

                <% }) %>
            </tbody>

        </table>
    </div>

</div>