<% layout("/layouts/boilerplate") -%>

<style>

/* 🌟 Page */
.main-body-page {
    background: #F8FAFC;
    padding: 25px;
}

/* 🌟 Header */
.page-header {
    margin-bottom: 18px;
}

.page-title {
    font-size: 22px;
    font-weight: 600;
    color: #0F172A;
}

.page-sub {
    font-size: 14px;
    color: #475569;
}

/* 🌟 Table Card */
.table-wrapper {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
    animation: fadeUp 0.5s ease;
}

/* 🌟 Table */
table {
    width: 100%;
    border-collapse: collapse;
}

/* 🌟 Header */
thead {
    background: #F1F5F9;
}

th {
    background: #09B850;
    color: #fff;
    padding: 14px;
    font-size: 13px;
    font-weight: 600;
}

/* 🌟 Rows */
td {
    padding: 14px;
    font-size: 14px;
    color: #0F172A;
    border-bottom: 1px solid #F1F5F9;
}

/* 🌟 Hover */
tbody tr {
    transition: 0.25s;
    animation: fadeInUp 0.4s ease both;
}

tbody tr:hover {
    background: #F8FAFC;
}

/* 🌟 Amount */
.amount {
    font-weight: 600;
    color: #09B850;
}

/* 🌟 Mode Badge */
.mode-badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    background: #09B85015;
    color: #09B850;
}

/* 🌟 Empty State */
.empty {
    text-align: center;
    padding: 30px;
    color: #94A3B8;
}

/* 🌟 Animations */
@keyframes fadeUp {
    from {opacity: 0; transform: translateY(20px);}
    to {opacity: 1; transform: translateY(0);}
}

@keyframes fadeInUp {
    from {opacity: 0; transform: translateY(10px);}
    to {opacity: 1; transform: translateY(0);}
}

/* 🌟 Responsive */
@media(max-width: 768px){
    th, td {
        padding: 10px;
        font-size: 12px;
    }
}

</style>


<div class="main-body-page">

    <!-- Header -->
    <div class="page-header">
        <div class="page-title">
            <i class="fa-solid fa-clock-rotate-left" style="color:#09B850;"></i>
            Payment History
        </div>
        <div class="page-sub">
            Member: <strong><%= member.name %></strong>
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">

        <table>

            <thead>
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Mode</th>
                </tr>
            </thead>

            <tbody>
                <% if (payments.length) { %>

                    <% payments.forEach((payment, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>

                            <td>
                                <%= new Date(payment.paymentDate).toLocaleDateString('en-GB') %>
                            </td>

                            <td class="amount">
                                ₹<%= payment.amountPaid.toLocaleString() %>
                            </td>

                            <td>
                                <span class="mode-badge">
                                    <%= payment.paymentMode %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="4" class="empty">
                            <i class="fa-regular fa-folder-open"></i><br><br>
                            No Payment Records Found
                        </td>
                    </tr>

                <% } %>
            </tbody>

        </table>

    </div>

</div>