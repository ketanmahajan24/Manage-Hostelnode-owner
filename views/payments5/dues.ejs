<% layout("/layouts/boilerplate") -%>
<%# Property Operations Phase 5 — Dues: who owes money, most overdue first, with call / remind / collect. %>
<%- include("../account/_style.ejs") %>
<%- include("../tenants/_style.ejs") %>
<%- include("_style.ejs") %>
<%
  const PHONE = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>';
  const TONE = { bad: "t-bad", warn: "t-warn", ok: "t-ok", blue: "t-blue", slate: "t-slate" };
  const link = function (o) { const p = Object.assign({ sort: sort === "amount" ? "amount" : "", q: q }, o); const s = Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + "=" + encodeURIComponent(p[k]); }).join("&"); return "/user/dues" + (s ? "?" + s : ""); };
%>
<style>
  .hn5-dues { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 12px; }
  .hn5-dues .hn2a-card { padding: 14px 16px; margin: 0; }
  .hn5-dues .top { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
  .hn5-dues .amt { text-align: right; } .hn5-dues .amt b { display: block; font-size: 18px; font-weight: 800; color: var(--hn-ink); margin-bottom: 4px; }
  .hn5-dues .acts { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 12px; }
  .hn5-dues .acts .hn2a-btn { justify-content: center; width: 100%; padding-left: 8px; padding-right: 8px; }
  .hn5-dues .for { font-size: 12.5px; color: var(--hn-soft); font-weight: 600; margin-top: 8px; }
</style>
<div class="hn2a hn3 hn5">
  <div class="hn2a-inner">
    <a class="hn3-back" href="/user/payments">← Payments</a>
    <div class="hn3-head" style="align-items:flex-end">
      <div><h1 class="hn2a-title" style="margin:0">Dues</h1>
        <div class="hn2a-sub" style="margin:6px 0 0"><% if (list.length) { %><b style="color:var(--hn-coral)"><%= T.inr(total) %></b> due from <%= list.length %> tenant<%= list.length === 1 ? "" : "s" %> · <%= hostel.hostelName %><% } else { %><%= hostel.hostelName %><% } %></div></div>
      <form class="hn2a-row" method="GET" action="/user/dues" style="margin:0;gap:8px" role="search">
        <% if (sort === "amount") { %><input type="hidden" name="sort" value="amount"><% } %>
        <label class="hn3-search" style="margin:0"><span style="position:absolute;left:-9999px">Search</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg><input class="hn2a-input" name="q" value="<%= q %>" placeholder="Name, mobile or room" autocomplete="off"></label>
      </form>
    </div>
    <% if (flash.err) { %><div class="hn2a-notice is-bad" role="alert" style="margin-top:14px"><%= flash.err %></div><% } %>
    <% if (flash.msg && !paid) { %><div class="hn2a-notice is-ok" role="status" style="margin-top:14px"><%= flash.msg %></div><% } %>
    <nav class="hn3-tabs" aria-label="Sort" style="margin:16px 0 14px">
      <a href="<%= link({ sort: '' }) %>" <%- sort !== 'amount' ? 'aria-current="page"' : '' %>>Most overdue</a>
      <a href="<%= link({ sort: 'amount' }) %>" <%- sort === 'amount' ? 'aria-current="page"' : '' %>>Biggest</a>
    </nav>
    <% if (!list.length) { %><div class="hn2a-card"><div class="hn2a-empty"><%= q ? "No one with dues matches “" + q + "”." : "No dues. Everyone has paid. 🎉" %></div></div><% } %>
    <div class="hn5-dues">
      <% list.forEach(function (r) { %>
      <div class="hn2a-card">
        <div class="top">
          <div class="hn5-who"><span class="hn3-ini c-<%= r.tone %>" aria-hidden="true"><%= r.initials %></span><div style="min-width:0"><a href="/user/tenants/<%= r.id %>?tab=payments"><%= r.name %></a><small><%= r.room %></small></div></div>
          <div class="amt"><b><%= T.inr(r.due) %></b><span class="hn3-pill <%= r.out ? 't-slate' : TONE[r.status.tone] || 't-warn' %>"><%= r.out ? "Moved out" + (r.daysLate > 0 ? " · " + r.daysLate + " days" : "") : (r.monthsOwed > 1 ? r.monthsOwed + " months · " : "") + (r.daysLate > 0 ? r.daysLate + (r.daysLate === 1 ? " day late" : " days late") : r.status.label) %></span></div>
        </div>
        <div class="for">For: <%= r.dueFor %></div>
        <div class="acts">
          <a class="hn2a-btn is-ghost is-sm" href="tel:+91<%= r.mobile %>"><%- PHONE %> Call</a>
          <a class="hn2a-btn is-ghost is-sm" href="<%= r.remind %>" target="_blank" rel="noopener">💬 Remind</a>
          <a class="hn2a-btn is-sm" data-collect href="/user/tenants/<%= r.id %>/collect?back=<%= encodeURIComponent(self) %>">Collect</a>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="hn5-help">“Remind” opens WhatsApp on your phone with a short message about the amount due. Nothing is sent until you send it.</div>
  </div>
  <%- include("_drawer.ejs", { paid: paid, flash: flash, self: self }) %>
</div>
