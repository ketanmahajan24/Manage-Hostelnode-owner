<% layout("/layouts/boilerplate") -%>
<%# Property Operations Phase 5 — Payments: this month's numbers, then Due now / Upcoming / Collected. %>
<%- include("../account/_style.ejs") %>
<%- include("../tenants/_style.ejs") %>
<%- include("_style.ejs") %>
<%
  const PHONE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>';
  const CHAT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5z"/></svg>';
  const TONE = { bad: "t-bad", warn: "t-warn", ok: "t-ok", blue: "t-blue", slate: "t-slate" };
  const isCur = key === cur;
  const path = tab === "upcoming" ? "/user/payments/upcoming" : "/user/payments";
  const qs = function (o) { const p = Object.assign({ tab: tab === "collected" ? "collected" : "", month: key === cur ? "" : key, q: q }, o); return Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + "=" + encodeURIComponent(p[k]); }).join("&"); };
  const link = function (pth, o) { const s = qs(o); return pth + (s ? "?" + s : ""); };
  const selfUrl = self;
%>
<div class="hn2a hn3 hn5">
  <div class="hn2a-inner">
    <div class="hn3-head" style="align-items:flex-end">
      <div><h1 class="hn2a-title" style="margin:0">Payments</h1><div class="hn2a-sub" style="margin:6px 0 0"><%= hostel.hostelName %> · <%= monthLabel %></div></div>
      <nav class="hn5-month" aria-label="Month">
        <a class="hn2a-btn is-ghost is-sm" href="<%= link('/user/payments', { month: prev, tab: tab === 'collected' ? 'collected' : '' }) %>">‹ <%= prevShort %></a>
        <span class="hn2a-btn is-ghost is-sm" aria-current="date"><%= monthLabel %></span>
        <a class="hn2a-btn is-ghost is-sm <%= next ? '' : 'is-off' %>" <%- next ? 'href="' + link('/user/payments', { month: next === cur ? '' : next, tab: tab === 'collected' ? 'collected' : '' }) + '"' : 'aria-disabled="true"' %>><%= nextShort %> ›</a>
      </nav>
    </div>
    <% if (flash.err) { %><div class="hn2a-notice is-bad" role="alert" style="margin-top:14px"><%= flash.err %></div><% } %>
    <% if (flash.msg && !paid) { %><div class="hn2a-notice is-ok" role="status" style="margin-top:14px"><%= flash.msg %></div><% } %>

    <div class="hn5-sum" style="margin-top:16px">
      <div class="hn2a-card"><small><%= isCur ? "Expected this month" : "Expected in " + monthLabel.split(" ")[0] %></small><b><%= T.inr(stats.expected) %></b><em><%= stats.expectedTenants %> tenant<%= stats.expectedTenants === 1 ? "" : "s" %> · rent + extras</em></div>
      <div class="hn2a-card is-ok"><small>Collected</small><b><%= T.inr(stats.collected) %></b><div class="hn5-bar" role="img" aria-label="<%= stats.pct %>% of expected"><i style="width:<%= stats.pct %>%"></i></div><em><%= stats.collected > stats.expected ? "incl. earlier dues" : stats.pct + "% of expected" %> · <%= stats.paidTenants %> tenant<%= stats.paidTenants === 1 ? "" : "s" %> paid</em></div>
      <div class="hn2a-card is-warn"><small>Due today</small><b><%= T.inr(stats.dueToday) %></b><em><%= stats.dueTodayN %> tenant<%= stats.dueTodayN === 1 ? "" : "s" %> · due today</em></div>
      <div class="hn2a-card is-bad"><small>Overdue</small><b><%= T.inr(stats.overdue) %></b><em><%= stats.overdueN %> tenant<%= stats.overdueN === 1 ? "" : "s" %> · past their due day</em></div>
    </div>

    <div class="hn3-head" style="align-items:center;margin-bottom:12px">
      <nav class="hn3-tabs" aria-label="Payments">
        <a href="<%= link('/user/payments', { tab: '', month: '' }) %>" <%- tab === 'due' ? 'aria-current="page"' : '' %>>Due now<em><%= counts.due %></em></a>
        <a href="<%= link('/user/payments/upcoming', { tab: '', month: '' }) %>" <%- tab === 'upcoming' ? 'aria-current="page"' : '' %>>Upcoming · 7 days</a>
        <a href="<%= link('/user/payments', { tab: 'collected' }) %>" <%- tab === 'collected' ? 'aria-current="page"' : '' %>>Collected<em><%= counts.collected %></em></a>
      </nav>
      <form class="hn2a-row" method="GET" action="<%= path %>" style="margin:0;gap:8px" role="search">
        <% if (tab === "collected") { %><input type="hidden" name="tab" value="collected"><% } %>
        <% if (key !== cur && tab === "collected") { %><input type="hidden" name="month" value="<%= key %>"><% } %>
        <label class="hn3-search" style="margin:0"><span class="sr-only" style="position:absolute;left:-9999px">Search</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg><input class="hn2a-input" name="q" value="<%= q %>" placeholder="Name, mobile or room" autocomplete="off"></label>
        <a class="hn2a-btn is-ghost" href="/user/dues">Dues list</a>
      </form>
    </div>

    <% if (tab === "due") { %>
    <section class="hn2a-card hn5-list" aria-label="Due now">
      <% if (!list.length) { %><div class="hn2a-empty"><%= q ? "No one matches “" + q + "”." : "Nothing is due right now. 🎉" %></div><% } else { %>
      <div class="hn5-r is-head" aria-hidden="true"><span>Tenant</span><span>Room</span><span>For</span><span>Status</span><span style="text-align:right">Due</span><span></span></div>
      <% list.forEach(function (r) { %>
      <div class="hn5-r">
        <div class="hn5-who"><span class="hn3-ini c-<%= r.tone %>" aria-hidden="true"><%= r.initials %></span><div style="min-width:0"><a href="/user/tenants/<%= r.id %>?tab=payments"><%= r.name %></a><small><%= r.masked %></small></div></div>
        <span class="c-room"><%= r.room %></span>
        <span class="c-for"><%= r.dueFor %></span>
        <span class="c-status"><span class="hn3-pill <%= TONE[r.status.tone] || 't-warn' %>"><%= r.status.label %></span></span>
        <span class="hn5-amt"><%= T.inr(r.due) %></span>
        <div class="hn5-acts">
          <a class="hn3-ic" href="tel:+91<%= r.mobile %>" aria-label="Call <%= r.name %>"><%- PHONE %></a>
          <a class="hn3-ic" href="<%= r.remind %>" target="_blank" rel="noopener" aria-label="Send <%= r.name %> a reminder on WhatsApp"><%- CHAT %></a>
          <a class="hn2a-btn is-sm" data-collect href="/user/tenants/<%= r.id %>/collect?back=<%= encodeURIComponent(selfUrl) %>">Collect</a>
        </div>
      </div>
      <% }) %><% } %>
    </section>
    <div class="hn5-help">Payments go to the oldest unpaid month first. “Overdue” means past the tenant’s own due day.</div>

    <% } else if (tab === "upcoming") { %>
    <section class="hn2a-card hn5-list" aria-label="Upcoming">
      <% if (!list.length) { %><div class="hn2a-empty">No rent falls due in the next 7 days.</div><% } else { %>
      <div class="hn5-r is-head" aria-hidden="true"><span>Tenant</span><span>Room</span><span>Due on</span><span></span><span style="text-align:right">Rent</span><span></span></div>
      <% list.forEach(function (r) { %>
      <div class="hn5-r">
        <div class="hn5-who"><span class="hn3-ini c-<%= r.tone %>" aria-hidden="true"><%= r.initials %></span><div style="min-width:0"><a href="/user/tenants/<%= r.id %>?tab=payments"><%= r.name %></a><small><%= r.masked %></small></div></div>
        <span class="c-room"><%= r.room %></span>
        <span class="c-for"><span class="hn3-pill t-blue">Due <%= T.day(r.on) %></span></span>
        <span class="c-status"><% if (r.covered) { %><span class="hn3-pill t-ok">Covered by advance</span><% } else if (r.advance > 0) { %><span class="hn5-mut"><%= T.inr(r.advance) %> in advance</span><% } %></span>
        <span class="hn5-amt"><%= T.inr(r.amount) %></span>
        <div class="hn5-acts">
          <a class="hn3-ic" href="tel:+91<%= r.mobile %>" aria-label="Call <%= r.name %>"><%- PHONE %></a>
          <a class="hn2a-btn is-ghost is-sm" data-collect href="/user/tenants/<%= r.id %>/collect?back=<%= encodeURIComponent(selfUrl) %>">Collect early</a>
        </div>
      </div>
      <% }) %><% } %>
    </section>

    <% } else { %>
    <section class="hn2a-card hn5-list" aria-label="Collected in <%= monthLabel %>">
      <% if (!list.length) { %><div class="hn2a-empty">No payments recorded in <%= monthLabel %><%= q ? " for “" + q + "”" : "" %>.</div><% } else { %>
      <div class="hn5-r is-col is-head" aria-hidden="true"><span>Date</span><span>Tenant</span><span style="text-align:right">Amount</span><span>Paid by</span><span>Recorded by</span><span></span></div>
      <% list.forEach(function (r) { %>
      <div class="hn5-r is-col">
        <span class="c-room <%= r.cancelled ? 'hn5-strike' : '' %>"><%= T.day(r.on) %></span>
        <div class="hn5-who"><span class="hn3-ini c-<%= r.tone %>" aria-hidden="true"><%= r.initials %></span><div style="min-width:0"><a href="/user/tenants/<%= r.id %>?tab=payments"><%= r.name %></a><small><%= r.room %></small></div></div>
        <span class="hn5-amt <%= r.cancelled ? 'hn5-strike' : '' %>"><%= T.inr(r.amount) %></span>
        <span class="c-mode"><%= r.mode %><%= r.reference ? " · ref " + r.reference : "" %><% if (r.cancelled) { %> · <span style="color:var(--hn-coral)">cancelled: <%= r.cancelReason %></span><% } %></span>
        <span class="c-for hn5-mut"><%= r.by ? (r.by === "you" ? "you" : r.by) : "—" %><%= r.receiptNo ? " · " + r.receiptNo : "" %></span>
        <div class="hn5-acts"><a class="hn5-lnk" href="/user/payments/<%= r.pid %>/receipt.pdf" target="_blank" rel="noopener">Receipt</a></div>
      </div>
      <% }) %><% } %>
    </section>
    <% } %>
  </div>
  <%- include("_drawer.ejs", { paid: paid, flash: flash, self: self }) %>
</div>
