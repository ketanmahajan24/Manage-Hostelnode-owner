<% layout("/layouts/boilerplate") -%>
<%#
  views/leads/index.ejs — Phase 3: Leads & CRM (approved design).
  Data from utils/leads.js (`leads`). Enquiries from every listing the
  owner has; "All Listings" scopes the table to one listing.
%>
<%
  const L = leads;
  const f = L.filters;
  const selName = (typeof selectedHostel !== "undefined" && selectedHostel && selectedHostel.hostelName) || "the selected property";
  // Build a Leads URL from the current filters with some changed (page resets).
  const url = (changes) => {
    const next = Object.assign({}, f, changes || {});
    const qs = [];
    ["listing", "lead", "status", "view"].forEach(k => { if (next[k]) qs.push(k + "=" + encodeURIComponent(next[k])); });
    return "/user/leads" + (qs.length ? "?" + qs.join("&") : "");
  };
  const pageUrl = (p) => { const u = url({}); return p > 1 ? u + (u.includes("?") ? "&" : "?") + "page=" + p : u; };
  const LEAD_CLASS = { Hot: "is-hot", Warm: "is-warm", Cold: "is-cold" };
  const STATUS_CLASS = { New: "is-new", Contacted: "is-contacted", Closed: "is-closed" };
  const svg = (inner, size, stroke, w) => '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="' + stroke + '" stroke-width="' + (w || 2) + '" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + inner + '</svg>';
  const HOME = '<path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path>';
  const DOWN = '<path d="m6 9 6 6 6-6"></path>';
  const X    = '<path d="M18 6 6 18M6 6l12 12"></path>';
  const WA   = '<path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3z"></path><path d="M9 9.5c.3 1.9 1.6 3.9 4.2 5.1l1.3-1.3 2 .9"></path>';
  const CHAT = '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>';
  const TYPE_ICON = {
    callback: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>',
    whatsapp: WA,
    visit:    '<rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M3 9h18M8 3v3M16 3v3"></path>',
    tour:     '<rect x="2" y="6" width="14" height="12" rx="2"></rect><path d="m16 10 6-3v10l-6-3"></path>',
    general:  CHAT
  };
%>

<style>
  .hn2l, .hn2l * { box-sizing: border-box; font-family: 'DM Sans', sans-serif; }
  .hn2l { background: #f7f8fa; min-height: calc(100vh - var(--nav-h, 64px)); padding: 28px 32px 40px; color: #12151a; }
  .hn2l a, .hn2l a:hover { text-decoration: none; }
  .hn2l .hn2l-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; margin: 0; color: #12151a; letter-spacing: -0.01em; }
  .hn2l-sub { font-size: 13px; color: #667085; margin-top: 4px; font-weight: 500; }
  .hn2l-head { margin-bottom: 18px; }

  .hn2l-sr { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .hn2l-notice { margin-bottom: 14px; padding: 10px 14px; border-radius: 10px; font-size: 13px; font-weight: 600; }
  .hn2l-notice.is-ok { background: #e8f9f0; border: 1px solid #bfeed3; color: #0a7d4c; }
  .hn2l-notice.is-bad { background: #fef3f2; border: 1px solid #fecdca; color: #b42318; }

  .hn2l-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; }
  .hn2l-left, .hn2l-chips, .hn2l-active { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .hn2l-listing { position: relative; display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid #d7ece1; border-radius: 9px; padding: 0 12px; height: 36px; }
  .hn2l-listing select {
    appearance: none; -webkit-appearance: none; border: 0; background: transparent; outline: none;
    font-size: 12.5px; font-weight: 700; color: #0a7d4c; padding-right: 16px; max-width: 260px; cursor: pointer; height: 100%;
  }
  .hn2l-listing .hn2l-caret { position: absolute; right: 11px; pointer-events: none; }
  .hn2l-listing:focus-within { box-shadow: 0 0 0 3px rgba(14,169,104,0.18); }
  .hn2l-count { font-size: 12px; color: #98a2b3; font-weight: 600; }
  .hn2l-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
  .hn2l-stat { background: #fff; border: 1px solid #eef1f4; border-radius: 14px; padding: 14px 16px; }
  .hn2l-stat b { display: block; font-size: 24px; font-weight: 800; color: #12151a; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .hn2l-stat span { display: block; font-size: 12px; color: #667085; font-weight: 600; margin-top: 7px; line-height: 1.35; }
  .hn2l-stat.is-tenant { background: #e8f9f0; border-color: #bfeed3; }
  .hn2l-stat.is-tenant b { color: #0a7d4c; }
  .hn2l-phone, .hn2l-phone:hover { display: inline-block; font-size: 12.5px; font-weight: 700; color: #0a7d4c; text-decoration: none; margin: 1px 0 3px; font-variant-numeric: tabular-nums; }
  .hn2l-phone:hover { text-decoration: underline; }
  .hn2l-kyc { font-size: 11px; font-weight: 700; border-radius: 99px; padding: 2px 8px; white-space: nowrap; }
  .hn2l-kyc.is-verified { color: #0a7d4c; background: #e8f9f0; } .hn2l-kyc.is-pending { color: #b45309; background: #fdf0d9; } .hn2l-kyc.is-none { color: #334155; background: #e9eef3; }
  .hn2l-became { font-size: 11px; font-weight: 700; color: #0a7d4c; background: #e8f9f0; border-radius: 99px; padding: 2px 8px; white-space: nowrap; }
  @media (max-width: 767px) { .hn2l-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .hn2l-chip, .hn2l-chip:hover, .hn2l-chip:focus {
    display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 700; padding: 7px 13px; border-radius: 99px;
    border: 1px solid #eef1f4; color: #667085; background: #fff;
  }
  .hn2l-chip.is-hot  { border-color: #f7d9d9; color: #dc2626; }
  .hn2l-chip.is-warm { border-color: #fbe6b8; color: #92660c; }
  .hn2l-chip.is-on, .hn2l-chip.is-on:hover { background: #12151a; border-color: #12151a; color: #fff; }
  .hn2l-pill, .hn2l-pill:hover {
    display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 99px;
    background: #eef6f1; color: #0a7d4c; border: 1px solid #d7ece1;
  }

  .hn2l-table { background: #fff; border: 1px solid #eef1f4; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 2px rgba(15,17,23,0.03); }
  .hn2l-row { display: grid; grid-template-columns: 1.7fr 1.3fr 0.75fr 0.8fr 0.75fr 1fr 2fr; gap: 10px; padding: 14px 18px; align-items: center; border-bottom: 1px solid #f2f4f7; }
  .hn2l-row:last-child { border-bottom: 0; }
  .hn2l-row > * { min-width: 0; }
  .hn2l-row.is-head { padding: 12px 18px; background: #fafbfc; border-bottom: 1px solid #eef1f4; }
  .hn2l-th { font-size: 11px; font-weight: 800; color: #98a2b3; text-transform: uppercase; letter-spacing: 0.04em; }
  .hn2l-who { display: flex; align-items: center; gap: 10px; }
  .hn2l-avatar { width: 30px; height: 30px; border-radius: 50%; background: #f2f4f7; color: #475467; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .hn2l-name { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #12151a; }
  .hn2l-meta { font-size: 11.5px; color: #98a2b3; font-weight: 600; white-space: nowrap; }
  .hn2l-type-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .hn2l-type { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 800; padding: 3px 9px; border-radius: 7px; white-space: nowrap; }
  .hn2l-type.is-callback { color: #3538cd; background: #eef4ff; border: 1px solid #c7d7fe; }
  .hn2l-type.is-whatsapp { color: #0a7d4c; background: #e8f9f0; border: 1px solid #bfeed3; }
  .hn2l-type.is-visit    { color: #92660c; background: #fff8ec; border: 1px solid #fbe6b8; }
  .hn2l-type.is-tour     { color: #5925dc; background: #f4f3ff; border: 1px solid #d9d6fe; }
  .hn2l-type.is-general  { color: #475467; background: #f2f4f7; border: 1px solid #e4e7ec; }
  .hn2l-cell { font-size: 12.5px; font-weight: 600; color: #344054; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hn2l-tag { display: inline-block; font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 99px; white-space: nowrap; }
  .hn2l-tag.is-hot  { color: #dc2626; background: #fdecec; }
  .hn2l-tag.is-warm { color: #92660c; background: #fff8ec; }
  .hn2l-tag.is-cold { color: #667085; background: #f2f4f7; }
  .hn2l-none { color: #c2c8d1; font-size: 12.5px; font-weight: 600; }

  /* Status: a real <select>, styled as the chip in the design */
  .hn2l-status { position: relative; display: inline-flex; align-items: center; }
  .hn2l-status select {
    appearance: none; -webkit-appearance: none; border: 0; outline: none; cursor: pointer;
    font-size: 11px; font-weight: 800; padding: 4px 22px 4px 10px; border-radius: 99px; line-height: 1.3;
  }
  .hn2l-status select:focus-visible { box-shadow: 0 0 0 3px rgba(14,169,104,0.25); }
  .hn2l-status .hn2l-caret { position: absolute; right: 8px; pointer-events: none; }
  .hn2l-status.is-new select       { color: #c2540c; background: #fdeee2; }
  .hn2l-status.is-contacted select { color: #475467; background: #f2f4f7; }
  .hn2l-status.is-closed select    { color: #98a2b3; background: #f7f8fa; }

  /* Two reply buttons stacked (same width), Convert beside them. */
  .hn2l-actions { display: grid; grid-template-columns: max-content max-content; gap: 6px; align-items: center; justify-content: start; }
  .hn2l-actions > :nth-child(1) { grid-column: 1; grid-row: 1; }
  .hn2l-actions > :nth-child(2) { grid-column: 1; grid-row: 2; }
  .hn2l-actions > :nth-child(3) { grid-column: 2; grid-row: 1 / span 2; }
  .hn2l-actions > :nth-child(-n+2) { justify-content: flex-start; width: 100%; }
  .hn2l-actions form .hn2l-btn { width: 100%; justify-content: flex-start; font-family: 'DM Sans', sans-serif; cursor: pointer; }
  @media (max-width: 1359px) {
    .hn2l-actions { grid-template-columns: max-content; }
    .hn2l-actions > :nth-child(3) { grid-column: 1; grid-row: 3; justify-self: start; }
  }
  .hn2l-btn, .hn2l-btn:hover, .hn2l-btn:focus {
    display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #475467;
    border: 1px solid #eef1f4; background: #fff; padding: 6px 11px; border-radius: 8px; white-space: nowrap; min-height: 32px;
  }
  .hn2l-btn:hover { background: #f6f8fa; }
  .hn2l-btn.is-green, .hn2l-btn.is-green:hover { color: #0a7d4c; border-color: #d7ece1; background: #f4faf7; }
  .hn2l-btn { gap: 6px; }
  .hn2l-btn.is-wa, .hn2l-btn.is-wa:hover { color: #fff; background: #1f9d55; border-color: #1f9d55; }
  .hn2l-btn.is-wa:hover { background: #188a49; }
  .hn2l-btn.is-hn, .hn2l-btn.is-hn:hover { color: #0a7d4c; border-color: #bfeed3; background: #fff; }
  .hn2l-btn.is-hn:hover { background: #f4faf7; }
  .hn2l-btn.is-off, .hn2l-btn.is-off:hover { color: #c2c8d1; background: #fff; cursor: default; }

  .hn2l-empty { padding: 40px 18px; text-align: center; color: #98a2b3; font-size: 13px; font-weight: 600; }
  .hn2l-empty a, .hn2l-empty a:hover { color: #0a7d4c; font-weight: 700; }
  .hn2l-foot { margin-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 12px; color: #98a2b3; font-weight: 600; }
  .hn2l-pages { display: flex; gap: 6px; }

  @media (max-width: 991px) {
    .hn2l { padding: 20px 14px 32px; }
    .hn2l-row.is-head { display: none; }
    .hn2l-row { grid-template-columns: 1fr 1fr; gap: 10px 14px; padding: 14px; }
    .hn2l-row .hn2l-who, .hn2l-row .hn2l-actions { grid-column: 1 / -1; }
    .hn2l-actions { display: flex; flex-wrap: wrap; }
    .hn2l-actions > :nth-child(-n+2) { width: auto; }
    .hn2l-row [data-label]::before { content: attr(data-label); display: block; font-size: 10.5px; font-weight: 800; color: #98a2b3; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
    .hn2l-listing select { max-width: 200px; }
  }
</style>

<div class="hn2l">
  <div class="hn2l-head">
    <h1 class="hn2l-title">Leads &amp; CRM</h1>
    <div class="hn2l-sub">Every enquiry across all your listings, in one place</div>
  </div>

  <%# Numbers for this owner's leads (left out if they could not be counted). %>
  <% const hnStats = (typeof stats !== "undefined" && stats) ? stats : null; %>
  <% if (hnStats && hnStats.hasListings) { %>
    <div class="hn2l-stats" aria-label="Lead numbers">
      <div class="hn2l-stat"><b><%= hnStats.monthLeads %></b><span>Leads in <%= hnStats.month %></span></div>
      <div class="hn2l-stat is-tenant"><b><%= hnStats.monthTenants %></b><span>Became tenants in <%= hnStats.month %></span></div>
      <div class="hn2l-stat"><b><%= hnStats.allLeads %></b><span>Leads so far</span></div>
      <div class="hn2l-stat is-tenant"><b><%= hnStats.allTenants %></b><span>Tenants from leads so far</span></div>
    </div>
  <% } %>

  <% if (notice) { %>
    <div class="hn2l-notice <%= notice === 'Status updated.' ? 'is-ok' : 'is-bad' %>" role="status"><%= notice %></div>
  <% } %>

  <!-- Filters -->
  <div class="hn2l-bar">
    <div class="hn2l-left">
      <form class="hn2l-listing" method="GET" action="/user/leads">
        <%- svg(HOME, 13, '#0a7d4c', 2.3) %>
        <label class="hn2l-sr" for="hn2lListing">Listing</label>
        <select id="hn2lListing" name="listing" onchange="this.form.submit()">
          <option value="">All Listings</option>
          <% L.listings.forEach(function (l) { %>
            <option value="<%= l.id %>" <%= f.listing === l.id ? 'selected' : '' %>><%= l.title %></option>
          <% }) %>
        </select>
        <span class="hn2l-caret"><%- svg(DOWN, 11, '#0a7d4c', 2.6) %></span>
        <% ["lead", "status", "view"].forEach(function (k) { if (f[k]) { %>
          <input type="hidden" name="<%= k %>" value="<%= f[k] %>">
        <% } }) %>
        <noscript><button type="submit" class="hn2l-btn">Go</button></noscript>
      </form>
      <div class="hn2l-count">
        <% if (f.listing) { %>Showing enquiries for <%= L.listingTitle %><% } else { %><%= L.liveCount %> listing<%= L.liveCount === 1 ? '' : 's' %> live<% } %>
      </div>
    </div>

    <div class="hn2l-chips" aria-label="Filter by lead temperature">
      <a class="hn2l-chip <%= !f.lead ? 'is-on' : '' %>" href="<%= url({ lead: '' }) %>">All</a>
      <a class="hn2l-chip is-hot <%= f.lead === 'Hot' ? 'is-on' : '' %>" href="<%= url({ lead: 'Hot' }) %>">🔥 Hot</a>
      <a class="hn2l-chip is-warm <%= f.lead === 'Warm' ? 'is-on' : '' %>" href="<%= url({ lead: 'Warm' }) %>">Warm</a>
      <a class="hn2l-chip <%= f.lead === 'Cold' ? 'is-on' : '' %>" href="<%= url({ lead: 'Cold' }) %>">Cold</a>
    </div>
  </div>

  <% if (f.view || f.status) { %>
    <div class="hn2l-active" style="margin:-4px 0 14px">
      <% if (f.view === 'visits') { %>
        <a class="hn2l-pill" href="<%= url({ view: '' }) %>" aria-label="Remove filter: scheduled visits">Scheduled visits <%- svg(X, 11, '#0a7d4c', 2.6) %></a>
      <% } %>
      <% if (f.status) { %>
        <a class="hn2l-pill" href="<%= url({ status: '' }) %>" aria-label="Remove filter: status <%= f.status %>">Status: <%= f.status %> <%- svg(X, 11, '#0a7d4c', 2.6) %></a>
      <% } %>
    </div>
  <% } %>

  <!-- Table -->
  <div class="hn2l-table">
    <div class="hn2l-row is-head" role="row">
      <div class="hn2l-th">Enquirer</div>
      <div class="hn2l-th">Listing</div>
      <div class="hn2l-th"><%= f.view === 'visits' ? 'Visit date' : 'Move-in' %></div>
      <div class="hn2l-th">Budget</div>
      <div class="hn2l-th">Lead</div>
      <div class="hn2l-th">Status</div>
      <div class="hn2l-th">Action</div>
    </div>

    <% if (!L.listings.length) { %>
      <div class="hn2l-empty">No listings yet. <a href="/user/list-property">List a property</a> to start receiving enquiries.</div>
    <% } else if (!L.items.length) { %>
      <div class="hn2l-empty">
        <% if (f.listing || f.lead || f.status || f.view) { %>No enquiries match these filters. <a href="/user/leads">Show all enquiries</a><% } else { %>No enquiries yet. They'll appear here as soon as someone contacts you about a listing.<% } %>
      </div>
    <% } %>

    <% L.items.forEach(function (e) { %>
      <div class="hn2l-row">
        <div class="hn2l-who">
          <div class="hn2l-avatar"><%= e.initials %></div>
          <div style="min-width:0">
            <div class="hn2l-name" title="<%= e.name %>"><%= e.name %></div>
            <% if (e.mobile) { %><a class="hn2l-phone" href="tel:+91<%= e.mobile %>" aria-label="Call <%= e.name %> on <%= e.mobile %>"><%= e.mobile.slice(0, 5) %> <%= e.mobile.slice(5) %></a><% } %>
            <div class="hn2l-type-row">
              <span class="hn2l-type is-<%= e.contactType.key %>"><%- svg(TYPE_ICON[e.contactType.key] || TYPE_ICON.general, 12, 'currentColor', 2.2) %><%= e.contactType.label %></span>
              <span class="hn2l-meta"><%= e.when %></span>
              <% if (L.kycReady && e.kyc && e.mobile) { %><span class="hn2l-kyc is-<%= e.kyc.key %>"><%= e.kyc.key === "verified" ? "KYC verified" : e.kyc.key === "pending" ? "KYC pending" : "KYC not verified" %></span><% } %>
              <% if (e.becameTenant) { %><% if (e.tenantHref) { %><a class="hn2l-became" href="<%= e.tenantHref %>" title="Open the tenant">Became tenant</a><% } else { %><span class="hn2l-became">Became tenant</span><% } %><% } %>
            </div>
          </div>
        </div>
        <div class="hn2l-cell" data-label="Listing" title="<%= e.listingTitle %><%= e.roomType ? ' — ' + e.roomType : '' %>"><%= e.listingTitle %><%= e.roomType ? ' — ' + e.roomType : '' %></div>
        <div class="hn2l-cell" data-label="<%= f.view === 'visits' ? 'Visit date' : 'Move-in' %>"><%= e.moveIn %></div>
        <div class="hn2l-cell" data-label="Budget"><%= e.budget %></div>
        <div data-label="Lead">
          <% if (e.lead) { %><span class="hn2l-tag <%= LEAD_CLASS[e.lead] %>"><%= e.lead === 'Hot' ? '🔥 Hot' : e.lead %></span><% } else { %><span class="hn2l-none">—</span><% } %>
        </div>
        <div data-label="Status">
          <form method="POST" action="/user/enquiries/<%= e.id %>/status" class="hn2l-status <%= STATUS_CLASS[e.status] %>">
            <input type="hidden" name="returnTo" value="<%= currentUrl %>">
            <select name="status" aria-label="Status for <%= e.name %>" onchange="this.form.submit()">
              <% L.statuses.forEach(function (st) { %>
                <option value="<%= st %>" <%= st === e.status ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
            <span class="hn2l-caret"><%- svg(DOWN, 10, 'currentColor', 2.8) %></span>
            <noscript><button type="submit" class="hn2l-btn" style="margin-left:6px">Save</button></noscript>
          </form>
        </div>
        <div class="hn2l-actions">
          <% if (e.replyWhatsApp) { %>
            <a class="hn2l-btn is-wa" href="<%= e.replyWhatsApp.href %>" target="_blank" rel="noopener" aria-label="Reply to <%= e.name %> on WhatsApp"><%- svg(WA, 13, 'currentColor', 2) %> Reply on WhatsApp</a>
          <% } else { %>
            <span class="hn2l-btn is-off" role="link" aria-disabled="true" title="No valid mobile number on this enquiry"><%- svg(WA, 13, 'currentColor', 2) %> Reply on WhatsApp</span>
          <% } %>
          <% if (e.replyChat && e.replyChat.href) { %>
            <a class="hn2l-btn is-hn" href="<%= e.replyChat.href %>" aria-label="Reply to <%= e.name %> in HostelNode messages"><%- svg(CHAT, 13, 'currentColor', 2) %> Reply on HostelNode</a>
          <% } else if (e.replyChat) { %>
            <form method="POST" action="/user/enquiries/<%= e.replyChat.startFor %>/chat" style="margin:0">
              <button type="submit" class="hn2l-btn is-hn" aria-label="Reply to <%= e.name %> in HostelNode messages"><%- svg(CHAT, 13, 'currentColor', 2) %> Reply on HostelNode</button>
            </form>
          <% } else { %>
            <span class="hn2l-btn is-off" role="link" aria-disabled="true" title="This enquiry has no HostelNode account attached"><%- svg(CHAT, 13, 'currentColor', 2) %> Reply on HostelNode</span>
          <% } %>
          <% if (L.kycReady && e.canConvert && e.mobile && e.kyc && e.kyc.key !== "verified") { %>
            <form method="POST" action="/user/kyc/request" target="_blank" style="margin:0"><input type="hidden" name="mobile" value="<%= e.mobile %>"><input type="hidden" name="name" value="<%= e.name %>"><button type="submit" class="hn2l-btn" title="Send <%= e.name %> the DigiLocker KYC link on WhatsApp">Ask to verify</button></form>
          <% } %>
          <% if (e.canConvert) { %>
            <a class="hn2l-btn is-green" href="/user/newmember?enquiry=<%= e.id %>" title="Admit as a tenant in <%= selName %>">Admit as tenant</a>
          <% } else { %>
            <span class="hn2l-btn is-off" role="link" aria-disabled="true" title="This enquiry is closed">Admit as tenant</span>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (L.total > 0) { %>
    <div class="hn2l-foot">
      <div><%= L.total %> enquir<%= L.total === 1 ? 'y' : 'ies' %><%= L.pages > 1 ? ' · page ' + L.page + ' of ' + L.pages : '' %></div>
      <% if (L.pages > 1) { %>
        <div class="hn2l-pages">
          <% if (L.page > 1) { %><a class="hn2l-btn" href="<%= pageUrl(L.page - 1) %>">Previous</a><% } %>
          <% if (L.page < L.pages) { %><a class="hn2l-btn" href="<%= pageUrl(L.page + 1) %>">Next</a><% } %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
