+  .hn2u .hn2u-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; color: #12151a; margin: 10px 40px 6px 0; letter-spacing: -0.01em; }
+  .hn2u-msg { font-size: 14px; color: #475467; font-weight: 500; line-height: 1.5; margin: 0; }
+  .hn2u-saved { margin-top: 12px; padding: 10px 12px; border-radius: 10px; background: #f0fdf6; border: 1px solid #c9f0db; color: #0a7d4c; font-size: 12.5px; font-weight: 600; }
