+  .hn2u-plan.is-first { border-color: #0EA968; box-shadow: 0 0 0 3px rgba(14,169,104,0.12); }
+  .hn2u-pbadge { position: absolute; top: -9px; left: 14px; background: #12151a; color: #fff; font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 2px 9px; border-radius: 99px; }
+  .hn2u-pname { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; color: #12151a; }
+  .hn2u-pprice { display: flex; align-items: baseline; gap: 6px; margin-top: 8px; }
+  .hn2u-pprice b { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; color: #12151a; line-height: 1; }
+  .hn2u-pprice s { font-size: 12.5px; color: #98a2b3; }
+  .hn2u-pper { font-size: 12px; color: #667085; font-weight: 600; margin-top: 2px; }
+  .hn2u-plines { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; flex: 1; align-content: start; }
+  .hn2u-plines li { font-size: 12.5px; color: #344054; font-weight: 600; display: flex; gap: 7px; }
+  .hn2u-plines li::before { content: "✓"; color: #0a7d4c; font-weight: 900; }
+  .hn2u-choose, .hn2u-choose:hover { margin-top: 14px; display: inline-flex; align-items: center; justify-content: center; min-height: 42px; border-radius: 10px; background: #0EA968; color: #fff; font-size: 13.5px; font-weight: 800; text-decoration: none; }
+  .hn2u-choose:hover { background: #0c9a5f; }
