+</style>
+<div class="hn2u">
+  <% if (hnU.notice) { %>
+    <div class="hn2u-strip is-limit" role="status"><span><%= hnU.notice %></span>
+      <div class="hn2u-acts"><button type="button" class="hn2u-sbtn" data-hn2u-open>See plans</button></div></div>
+  <% } %>
+  <% if (hnU.draft) { %>
+    <div class="hn2u-strip is-ok" role="status"><span>Your draft from <%= hnU.draft.savedOn %> is filled in below. Check it and submit.</span>
+      <div class="hn2u-acts"><form method="POST" action="/user/account/drafts/<%= hnU.draft.id %>/delete"><button type="submit" class="hn2u-sbtn is-ghost">Discard draft</button></form></div></div>
+  <% } else if (hnU.offer) { %>
+    <div class="hn2u-strip is-draft" role="status"><span>You have a saved draft from <%= hnU.offer.savedOn %>.</span>
+      <div class="hn2u-acts"><a class="hn2u-sbtn" href="<%= hnU.offer.href %>">Restore draft</a>
+        <form method="POST" action="/user/account/drafts/<%= hnU.offer.id %>/delete"><button type="submit" class="hn2u-sbtn is-ghost">Discard</button></form></div></div>
+  <% } %>
+  <% if (hnU.held && hnU.held.length) { %>
+    <div class="hn2u-strip is-draft" role="status">
+      <span><%= hnU.held.length === 1 ? "1 listing is saved as a draft" : hnU.held.length + " listings are saved as drafts" %> and not shown on hostelnode.com yet.</span>
+      <ul class="hn2u-held">
+        <% hnU.held.forEach(function (l) { %>
+          <li><span><%= l.title %></span><form method="POST" action="/user/listing/<%= l.id %>/publish" style="margin:0"><button type="submit" class="hn2u-sbtn">Publish</button></form></li>
+        <% }) %>
+      </ul>
+    </div>
+  <% } %>
+
+  <% if (hnU.lock) { %>
+  <div class="hn2u-back <%= hnU.open ? 'is-open' : '' %>" id="hn2uBack">
+    <div class="hn2u-box" role="dialog" aria-modal="true" aria-labelledby="hn2uTitle" tabindex="-1" id="hn2uBox">
+      <button type="button" class="hn2u-x" data-hn2u-close aria-label="Close">×</button>
+      <span class="hn2u-eyebrow"><%= hnU.lock.kind === "feature" ? "Not in your plan" : "Plan limit reached" %></span>
+      <h2 class="hn2u-title" id="hn2uTitle"><%= hnU.lock.kind === "feature" ? hnU.lock.title : "Upgrade to add more" %></h2>
+      <p class="hn2u-msg"><%= hnU.lock.message %></p>
+      <% if (hnU.draft) { %><div class="hn2u-saved">What you just typed is saved as a draft. It will be waiting in the form after you upgrade.</div><% } %>
+      <% if (hnU.form && hnU.form.kind === "listing" && hnU.open) { %><div class="hn2u-saved">Your listing is saved as a draft. It is not shown on hostelnode.com yet; publish it from My Listings after you upgrade.</div><% } %>
+
+      <% if (hnU.plans.length) { %>
+        <div class="hn2u-plans">
+          <% hnU.plans.forEach(function (p, i) { %>
+            <div class="hn2u-plan <%= i === 0 ? 'is-first' : '' %>">
+              <% if (p.badge) { %><span class="hn2u-pbadge"><%= p.badge %></span><% } %>
+              <div class="hn2u-pname"><%= p.name %></div>
+              <div class="hn2u-pprice"><b><%= p.price ? inrU(p.price) : "Free" %></b><% if (p.strikePrice) { %><s><%= inrU(p.strikePrice) %></s><% } %></div>
+              <div class="hn2u-pper"><%= p.per %></div>
+              <ul class="hn2u-plines"><% p.lines.forEach(function (t) { %><li><span><%= t %></span></li><% }) %></ul>
+              <a class="hn2u-choose" href="<%= p.href %>">Choose <%= p.name %></a>
+            </div>
+          <% }) %>
+        </div>
+      <% } %>
+      <div class="hn2u-foot">
+        <span>Everything you already have stays safe and usable. <a href="/user/account/plans">Compare all plans</a></span>
+        <button type="button" class="hn2u-later" data-hn2u-close>Not now</button>
+      </div>
+    </div>
+  </div>
+  <% } %>
+</div>
+<% if (hnU.draft) { %><script type="application/json" id="hn2uDraft"><%- JSON.stringify({ id: hnU.draft.id, action: hnU.draft.action, fields: hnU.draft.fields }).replace(/</g, "\\u003c") %></script><% } %>
+<script>
+(function () {
+  var back = document.getElementById('hn2uBack'), box = document.getElementById('hn2uBox'), last = null;
+  function lock(on) { try { document.body.style.overflow = on ? 'hidden' : ''; } catch (e) {} }
+  function open() { if (!back) return; last = document.activeElement; back.classList.add('is-open'); lock(true); if (box) box.focus(); }
+  function close() { if (!back) return; back.classList.remove('is-open'); lock(false); if (last && last.focus) last.focus();
+    // tidy the address bar so a reload does not reopen the popup
+    try { var u = new URL(location.href); if (u.searchParams.has('upgrade')) { u.searchParams.delete('upgrade'); history.replaceState(null, '', u.pathname + (u.search || '') + u.hash); } } catch (e) {} }
+  document.querySelectorAll('[data-hn2u-open]').forEach(function (b) { b.addEventListener('click', open); });
+  document.querySelectorAll('[data-hn2u-close]').forEach(function (b) { b.addEventListener('click', close); });
+  if (back) {
+    back.addEventListener('click', function (e) { if (e.target === back) close(); });
+    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && back.classList.contains('is-open')) close(); });
+    if (back.classList.contains('is-open')) { lock(true); if (box) box.focus(); }
+  }
+
+  // Put a saved draft back into its form.
+  var holder = document.getElementById('hn2uDraft');
+  if (!holder) return;
+  var draft; try { draft = JSON.parse(holder.textContent); } catch (e) { return; }
+  function fill() {
+    var form = null;
+    document.querySelectorAll('form').forEach(function (f) { if (!form && (f.getAttribute('action') || '').toLowerCase() === String(draft.action).toLowerCase()) form = f; });
+    if (!form) return;
+    // Tell the server which draft this form came from, so it is removed once the form is saved.
+    form.setAttribute('action', draft.action + '?hnDraft=' + encodeURIComponent(draft.id));
+    (draft.fields || []).forEach(function (f) {
+      for (var i = 0; i < form.elements.length; i++) {
+        var el = form.elements[i];
+        if (el.name !== f.n || el.type === 'file' || el.type === 'hidden' || el.type === 'submit' || el.type === 'button') continue;
+        if (el.type === 'checkbox' || el.type === 'radio') { el.checked = (el.value === f.v); }
+        else {
+          if (el.tagName === 'SELECT') { var ok = false; for (var j = 0; j < el.options.length; j++) if (el.options[j].value === f.v) ok = true; if (!ok) continue; }
+          el.value = f.v;
+        }
+        try { el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) {}
+      }
+    });
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fill); else fill();
+})();
+</script>
+<% } %>
