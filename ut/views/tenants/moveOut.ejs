<% layout("/layouts/boilerplate") -%>
<%# Property Operations Phase 3 — move out: settle the deposit (dues, deductions), refund or collect, slip. %>
<%- include("../account/_style.ejs") %>
<%- include("_style.ejs") %>
<% const first = String(m.name || "").split(" ")[0]; %>
<style>
  .hn3m .hn2a-inner { max-width: 1080px; }
  .hn3-wrap { display: grid; grid-template-columns: 1.25fr 1fr; gap: 18px; align-items: start; }
  .hn3-ded { display: grid; grid-template-columns: 1.6fr 1fr 44px; gap: 8px; margin-bottom: 8px; }
  .hn3-x { height: 44px; border-radius: 11px; border: 1px solid #cfdcd5; background: #fff; color: var(--hn-soft); font-size: 18px; cursor: pointer; }
  .hn3-res { border-radius: 16px; padding: 16px 18px; margin-top: 16px; }
  .hn3-res span { font-size: 13px; font-weight: 700; }
  .hn3-res b { display: block; font-size: 30px; letter-spacing: -0.02em; }
  .hn3-res small { font-size: 13px; font-weight: 600; color: var(--hn-body); }
  .hn3-res.is-refund { background: var(--hn-green-tint); border: 1px solid #bfe8d2; color: var(--hn-green); }
  .hn3-res.is-collect { background: var(--hn-coral-tint); border: 1px solid #f6c3be; color: var(--hn-coral); }
  .hn3-res.is-even { background: var(--hn-slate-tint); color: var(--hn-slate); }
  .hn3-slip { padding: 0; overflow: hidden; }
  .hn3-slip .t { background: var(--hn-ink); color: #fff; padding: 16px 18px; font-weight: 800; }
  .hn3-slip .t small { display: block; font-weight: 500; opacity: 0.75; font-size: 12px; margin-top: 3px; }
  .hn3-slip .b { padding: 8px 18px 16px; }
  .hn3-slip .hn3-rw { font-size: 13px; padding: 8px 0; }
  .hn3-go { width: 100%; min-height: 50px !important; font-size: 15px !important; margin-top: 18px; }
  @media (max-width: 900px) { .hn3-wrap { grid-template-columns: 1fr; } }
</style>

<div class="hn2a hn3 hn3m">
  <div class="hn2a-inner">
    <a href="/user/tenants/<%= m._id %>" style="font-size:13px;font-weight:700;color:var(--hn-soft)">← <%= m.name %></a>
    <h1 class="hn2a-title" style="margin-top:8px">Move out <%= m.name %></h1>
    <div class="hn2a-sub">Room <%= m.assignedRoom || "—" %> · bed <%= m.bedLabel || "—" %><%= m.leavingDate ? " · leaving date " + T.dayYear(m.leavingDate) + (m.noticeAt ? " (notice given " + T.day(m.noticeAt) + ")" : "") : "" %></div>
    <% if (flash.err) { %><div class="hn2a-notice is-bad" role="alert"><%= flash.err %></div><% } %>

    <form method="POST" action="/user/tenants/<%= m._id %>/move-out" id="hn3Out" class="hn3-wrap" data-confirm="Move <%= T.plain(m.name) %> out? Bed <%= m.assignedRoom %>-<%= m.bedLabel %> becomes free.">
      <div class="hn2a-card">
        <div class="hn2a-card-title" style="font-size:17px;margin-bottom:12px">Settle the deposit</div>
        <div class="hn2a-field" style="max-width:240px"><label class="hn2a-label" for="mo-date">Moved out on</label>
          <input class="hn2a-input" type="date" id="mo-date" name="leftDate" value="<%= leaving %>" max="<%= today %>" min="<%= minDate %>" required></div>
        <div class="hn3-rw"><span>Security deposit held</span><span><%= T.inr(n.depositHeld) %></span></div>
        <% if (n.advance > 0) { %><div class="hn3-rw"><span>Rent paid in advance</span><span><%= T.inr(n.advance) %></span></div><% } %>
        <div class="hn3-rw"><span>Unpaid rent and dues</span><span class="<%= n.dues ? 't-bad-text' : '' %>">− <%= T.inr(n.dues) %></span></div>
        <div style="margin:14px 0 8px;font-size:13.5px;font-weight:700">Deductions <span style="color:var(--hn-soft);font-weight:500">(optional: damage, electricity…)</span></div>
        <div data-deds>
          <div class="hn3-ded"><input class="hn2a-input" name="dedLabel" maxlength="40" placeholder="e.g. Broken chair" aria-label="Deduction"><input class="hn2a-input" name="dedAmount" inputmode="numeric" placeholder="₹" aria-label="Amount"><button type="button" class="hn3-x" data-del aria-label="Remove this deduction">×</button></div>
        </div>
        <button type="button" class="hn2a-btn is-ghost is-sm" data-add>+ Add deduction</button>

        <div class="hn3-res is-even" data-res aria-live="polite"><span data-res-t>Settled</span><b data-res-n><%= T.inr(n.net) %></b><small data-res-s></small></div>
        <div class="hn2a-field" style="margin-top:14px" data-modebox><span class="hn2a-label">Refund paid by</span>
          <div class="hn3-seg"><label><input type="radio" name="mode" value="cash" checked><span>Cash</span></label><label><input type="radio" name="mode" value="upi"><span>UPI</span></label><label><input type="radio" name="mode" value="bank"><span>Bank</span></label></div></div>
        <button type="submit" class="hn2a-btn hn3-go">Move out and make slip</button>
        <div class="hn2a-help" style="text-align:center">Bed <%= m.assignedRoom %>-<%= m.bedLabel %> turns free and your listing shows it free again. You can undo this for 24 hours.</div>
      </div>

      <div>
        <div class="hn2a-card hn3-slip" aria-label="Slip preview">
          <div class="t">Settlement slip<small><%= hostelName %> · <%= T.dayYear(new Date()) %></small></div>
          <div class="b">
            <div class="hn3-rw"><span>Tenant</span><span><%= m.name %> · <%= T.maskMobile(m.mobileNo) %></span></div>
            <div class="hn3-rw"><span>Stay</span><span><%= T.day(m.joiningDate) %> – <span data-p-left></span> · <%= m.assignedRoom %>-<%= m.bedLabel %></span></div>
            <div class="hn3-rw"><span>Deposit held</span><span><%= T.inr(n.depositHeld) %></span></div>
            <% if (n.advance > 0) { %><div class="hn3-rw"><span>Paid in advance</span><span><%= T.inr(n.advance) %></span></div><% } %>
            <% if (n.dues > 0) { %><div class="hn3-rw"><span>Unpaid rent</span><span>− <%= T.inr(n.dues) %></span></div><% } %>
            <div data-p-deds></div>
            <div class="hn3-rw" style="font-size:15px;font-weight:800"><span style="color:var(--hn-ink);font-weight:800" data-p-t>Refunded</span><span data-p-n></span></div>
          </div>
        </div>
        <div class="hn3-callout" style="background:#fff;border:1px solid var(--hn-line);margin-top:12px;color:var(--hn-body)"><span aria-hidden="true">📄</span><div>The slip is made as a PDF when you move <%= first %> out. You can download it or send it on WhatsApp from <%= first %>'s page.</div></div>
      </div>
    </form>
  </div>
</div>
<script>
(function () {
  var f = document.getElementById('hn3Out'); if (!f) return;
  var held = <%= Number(n.depositHeld) || 0 %>, adv = <%= Number(n.advance) || 0 %>, dues = <%= Number(n.dues) || 0 %>;
  var first = <%- JSON.stringify(first).replace(/</g, "\\u003c") %>;
  var inr = function (x) { return '₹' + Math.round(Number(x) || 0).toLocaleString('en-IN'); };
  var num = function (v) { var x = Number(String(v || '').replace(/[,₹\s]/g, '')); return isFinite(x) && x > 0 ? x : 0; };
  var box = f.querySelector('[data-deds]'), tpl = box.firstElementChild.cloneNode(true);
  function calc() {
    var list = [], total = 0;
    box.querySelectorAll('.hn3-ded').forEach(function (r) { var l = r.querySelector('[name=dedLabel]').value.trim(), a = num(r.querySelector('[name=dedAmount]').value); if (a) { list.push([l || 'Deduction', a]); total += a; } });
    var net = held + adv - dues - total;
    var res = f.querySelector('[data-res]');
    res.className = 'hn3-res ' + (net > 0 ? 'is-refund' : net < 0 ? 'is-collect' : 'is-even');
    f.querySelector('[data-res-t]').textContent = net > 0 ? 'Refund to ' + first : net < 0 ? 'Collect from ' + first : 'Nothing to pay either way';
    f.querySelector('[data-res-n]').textContent = inr(Math.abs(net));
    var parts = [inr(held)]; if (adv) parts.push('+ ' + inr(adv)); if (dues) parts.push('− ' + inr(dues)); list.forEach(function (d) { parts.push('− ' + inr(d[1])); });
    f.querySelector('[data-res-s]').textContent = parts.length > 1 ? parts.join(' ') : '';
    f.querySelector('[data-modebox]').hidden = !(net > 0);
    var pd = f.querySelector('[data-p-deds]'); pd.textContent = '';
    list.forEach(function (d) { var row = document.createElement('div'); row.className = 'hn3-rw'; var a = document.createElement('span'); a.textContent = d[0]; var b = document.createElement('span'); b.textContent = '− ' + inr(d[1]); row.appendChild(a); row.appendChild(b); pd.appendChild(row); });
    var mode = (f.querySelector('[name=mode]:checked') || {}).value;
    f.querySelector('[data-p-t]').textContent = net > 0 ? 'Refunded (' + (mode === 'upi' ? 'UPI' : mode === 'bank' ? 'bank' : 'cash') + ')' : net < 0 ? 'To pay' : 'Settled';
    f.querySelector('[data-p-n]').textContent = inr(Math.abs(net));
    var dt = f.querySelector('#mo-date').value;
    f.querySelector('[data-p-left]').textContent = dt ? new Date(dt + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
  }
  f.addEventListener('input', calc); f.addEventListener('change', calc);
  f.querySelector('[data-add]').addEventListener('click', function () { if (box.children.length >= 10) return; var r = tpl.cloneNode(true); r.querySelectorAll('input').forEach(function (i) { i.value = ''; }); box.appendChild(r); r.querySelector('input').focus(); });
  box.addEventListener('click', function (e) { var b = e.target.closest('[data-del]'); if (!b) return; var r = b.closest('.hn3-ded'); if (box.children.length > 1) r.remove(); else r.querySelectorAll('input').forEach(function (i) { i.value = ''; }); calc(); });
  f.addEventListener('submit', function (e) { if (!confirm(f.getAttribute('data-confirm'))) { e.preventDefault(); return; } var b = f.querySelector('button[type=submit]'); setTimeout(function () { b.disabled = true; b.textContent = 'Saving…'; }, 0); });
  calc();
})();
</script>
